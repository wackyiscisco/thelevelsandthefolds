---
import Layout from '../../../layouts/Layout.astro';

const tracks = [
  { number: 1, title: 'Walking on Sunshine', voice: 'Count Wrongula', coordinate: '66_6', slug: 'count-wrongula-01-walking-on-sunshine', quote: 'Open the windows, throw wide every door', lyricsAvailable: true },
  { number: 2, title: 'The Eve of Things to Come', voice: 'Eve', coordinate: '6_66', slug: 'count-wrongula-02-the-eve-of-things-to-come', quote: "It's the eve of things to come", lyricsAvailable: true },
  { number: 3, title: 'To Whom It May Concern', voice: 'Count Wrongula', coordinate: '66_6', slug: 'count-wrongula-03-to-whom-it-may-concern', quote: 'To whom it may concern', lyricsAvailable: true },
  { number: 4, title: 'Our Deepest Condolences', voice: 'Eve', coordinate: '6_66', slug: 'count-wrongula-04-our-deepest-condolences', quote: 'Our deepest condolences', lyricsAvailable: true },
  { number: 5, title: 'Counting Accounting', voice: 'Count Wrongula', coordinate: '66_6', slug: 'count-wrongula-05-counting-accounting', quote: 'Everything accounted, everything fine', lyricsAvailable: true },
  { number: 6, title: 'Encumbered Discoveries', voice: 'Eve', coordinate: '6_66', slug: 'count-wrongula-06-encumbered-discoveries', quote: 'Every room a question, every answer changing plans', lyricsAvailable: true },
  { number: 7, title: 'Wrong Turn', voice: 'Count Wrongula', coordinate: '66_6', slug: 'count-wrongula-07-wrong-turn', quote: 'One road closes, another appears', lyricsAvailable: true },
  { number: 8, title: 'Destinations and Connections', voice: 'Eve', coordinate: '6_66', slug: 'count-wrongula-08-destinations-and-connections', quote: 'Every photograph has someone standing just beyond the edge', lyricsAvailable: true },
  { number: 9, title: 'No Invitation Required', voice: 'Count Wrongula', coordinate: '66_6', slug: 'count-wrongula-09-no-invitation-required', quote: 'No invitation required', lyricsAvailable: true },
  { number: 10, title: 'Unsolicited Entries', voice: 'Eve', coordinate: '6_66', slug: 'count-wrongula-10-unsolicited-entries', quote: 'Every lock has history, every key has weight', lyricsAvailable: true },
  { number: 11, title: 'The Tridecagon of Old', voice: 'Count Wrongula', coordinate: '66_6', slug: 'count-wrongula-11-the-tridecagon-of-old', quote: 'We are the Tridecagon of Old', lyricsAvailable: true },
  { number: 12, title: 'The Order of the Veilguards', voice: 'Eve', coordinate: '6_66', slug: 'count-wrongula-12-the-order-of-the-veilguards', quote: 'Some became allies, some became friends, one became family', lyricsAvailable: true },
];
---

<Layout title="WHO | Count Wrongula">
  <main class="who-album max-w-5xl mx-auto px-6 py-10 space-y-8">
    <div class="sticky top-[80px] z-40 -mx-6 px-6 py-3.5 mb-6 bg-black/85 backdrop-blur-xl border-b border-amber-900/40 shadow-2xl flex items-center justify-between">
      <a href="/music/count-wrongula" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-mono font-extrabold bg-amber-950/95 text-amber-100 border-2 border-amber-500/60 hover:bg-amber-900 transition-all shadow-xl flex items-center gap-2.5">
        <span>←</span><span>Back to Count Wrongula</span>
      </a>
      <span class="hidden sm:inline-block text-[11px] font-mono text-amber-200/90 uppercase px-3.5 py-1.5 rounded-full bg-amber-950/70 border border-amber-700/50">
        Canonical LP · Album 1
      </span>
    </div>

    <section class="p-8 md:p-10 rounded-2xl bg-slate-900/60 border border-amber-900/40 flex flex-col md:flex-row gap-8 items-center md:items-start shadow-2xl">
      <img
        src="/images/count-wrongula/who_album_cover_01.png"
        alt="WHO — Album 1 by Count Wrongula"
        class="w-56 h-56 md:w-64 md:h-64 object-cover rounded-xl shadow-2xl border border-amber-500/30"
      />
      <div class="space-y-4 text-center md:text-left flex-1">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-amber-950/80 text-amber-200 border border-amber-700/40">
          Count Wrongula · Album 1
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-50 font-orbitron">WHO</h1>
        <p class="text-sm text-slate-300 leading-relaxed max-w-2xl">
          Twelve tracks in locked release order. Odd-numbered transmissions belong to Count Wrongula in 66_6; even-numbered transmissions belong to Eve in 6_66.
        </p>
        <div class="flex flex-wrap justify-center md:justify-start gap-2 text-[10px] font-mono uppercase tracking-wider">
          <span class="px-3 py-1 rounded-full bg-amber-950/70 text-amber-200 border border-amber-800/40">Count · Odd Tracks</span>
          <span class="px-3 py-1 rounded-full bg-slate-800 text-sky-200 border border-sky-900/50">Eve · Even Tracks</span>
        </div>
      </div>
    </section>

    <section class="space-y-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-amber-400 font-semibold">Album 1</span>
        <h2 class="text-2xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-amber-300 to-sky-300">Official Tracklist</h2>
      </div>

      <ol class="space-y-3">
        {tracks.map((track) => {
          const isCount = track.number % 2 === 1;
          return (
            <li>
            <a href={`/music/${track.slug}`} class={`block p-4 md:p-5 rounded-xl bg-slate-900/45 hover:bg-slate-900/80 border transition-all shadow-md ${isCount ? 'border-amber-900/30 hover:border-amber-600/50' : 'border-sky-950/40 hover:border-sky-700/50'}`}>
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-4 md:gap-6 min-w-0">
                  <span class={`text-lg md:text-xl font-mono font-bold ${isCount ? 'text-amber-400' : 'text-sky-300'}`}>
                    {String(track.number).padStart(2, '0')}
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-base md:text-lg font-semibold text-slate-100">{track.title}</h3>
                    <p class="text-xs font-mono text-slate-500 mt-0.5">{track.voice} · {track.coordinate}</p>
                    <p class="text-xs md:text-sm italic text-slate-400 mt-1">&ldquo;{track.quote}&rdquo;</p>
                  </div>
                </div>
                <span class="hidden sm:inline text-[10px] font-mono uppercase tracking-wider text-slate-500 shrink-0">
                  {track.lyricsAvailable ? 'Read Lyrics' : 'View Source Hold'} &rarr;
                </span>
              </div>
            </a>
            </li>
          );
        })}
      </ol>
    </section>

    <div class="pt-8 pb-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-amber-900/40">
      <a href="/music/count-wrongula" class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-amber-950/90 text-amber-100 border border-amber-500/50 hover:bg-amber-900 transition-all flex items-center justify-center gap-2 shadow-xl">
        <span>←</span><span>Back to Discography</span>
      </a>
      <a href="/music" class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-slate-900/90 text-slate-300 border border-slate-700/50 hover:bg-slate-800 transition-all flex items-center justify-center gap-2 shadow-xl">
        <span>All Cosmos Releases</span><span>→</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  :global(body) { background-color: #050816 !important; }
  .who-album { position: relative; z-index: 1; }
  .who-album::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(circle at 18% 18%, rgba(111, 61, 25, .16), transparent 32rem),
      radial-gradient(circle at 82% 22%, rgba(64, 91, 109, .12), transparent 34rem);
  }
</style>
