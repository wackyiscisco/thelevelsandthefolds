---
import Layout from '../../layouts/Layout.astro';

const album = {
  name: 'Bloodlines',
  slug: 'album-bloodlines',
  cover: '/images/mary/bloodlines_mary_album_cover_01.webp',
  tracks: 12,
};
---

<Layout title="Mary | Official Music Space">
  <main class="mary-music-page w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">
    <div class="sticky top-[80px] z-40 -mx-4 sm:-mx-6 lg:-mx-10 px-4 sm:px-6 lg:px-10 py-3.5 mb-6 bg-black/85 backdrop-blur-xl border-b border-rose-900/40 shadow-2xl flex items-center justify-between">
      <a href="/music" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-mono font-extrabold bg-rose-950/95 text-rose-100 border-2 border-rose-600/60 hover:bg-rose-900 hover:text-white transition-all shadow-xl hover:scale-105 flex items-center gap-2.5">
        <span class="text-rose-300 font-bold text-sm">&larr;</span>
        <span>Back to Music</span>
      </a>
      <span class="hidden sm:inline-block text-[11px] font-mono text-amber-100/90 uppercase px-3.5 py-1.5 rounded-full bg-stone-950/75 border border-amber-800/50">Cosmos Node :: Mary_6_66</span>
    </div>

    <section class="artist-banner relative w-full rounded-3xl overflow-hidden bg-slate-950 border border-rose-900/45 shadow-2xl h-[30rem] sm:h-[34rem] flex items-end p-6 md:p-10 mb-8 group">
      <img src="/images/mary/mary_artist_01.png" alt="Mary" class="absolute inset-0 w-full h-full object-cover object-top opacity-90 group-hover:scale-[1.02] transition-transform duration-700" />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/25 to-black/10"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_25%,transparent_0%,rgba(0,0,0,.08)_36%,rgba(0,0,0,.74)_100%)]"></div>
      <div class="relative z-20 max-w-3xl space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-rose-950/90 text-rose-100 border border-rose-600/50 font-mono">6_66</span>
          <span class="px-3 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-stone-950/90 text-amber-100 border border-amber-700/50 font-mono">Album 1 Active</span>
        </div>
        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-none drop-shadow-[0_4px_22px_rgba(0,0,0,.95)]">Mary</h1>
        <p class="text-xs sm:text-sm font-mono uppercase tracking-[.16em] text-rose-100 drop-shadow-lg">Scholar · library worker · singer of Bloodlines</p>
      </div>
    </section>

    <div class="flex items-center justify-start gap-1 overflow-x-auto py-1 border-b border-slate-900 mb-8 font-mono text-[11px] uppercase tracking-wider">
      <span class="px-4 py-2 rounded-xl font-bold border border-rose-600/40 bg-rose-950/70 text-rose-100 shadow-md">♪ Releases</span>
      <span class="px-4 py-2 text-slate-500">Profile & Lore · Later</span>
      <span class="px-4 py-2 text-slate-500">Media & BTS · Later</span>
    </div>

    <section class="space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 bg-slate-950/60 border border-rose-900/30 p-6 sm:p-8 rounded-3xl backdrop-blur-md space-y-3">
          <span class="text-xs font-mono uppercase tracking-widest text-rose-300 font-semibold">Artist Overview</span>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light">At eighteen, Mary balances a scholarship, library work, family life, and an earnest fascination with monster folklore. Bloodlines follows what she notices, believes, doubts, and sings; rumor and scholarship remain evidence, not automatic proof.</p>
        </div>
        <blockquote class="lg:col-span-4 bg-rose-950/15 border-l-4 border-rose-500/80 p-6 rounded-r-3xl italic text-rose-100 font-serif text-base sm:text-lg leading-relaxed shadow-lg">“Welcome to Ridgefall, where nothing really happens.”</blockquote>
      </div>

      <div class="space-y-6 pt-2">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-rose-900/30 pb-4">
          <div><span class="text-xs font-mono uppercase tracking-widest text-rose-300 font-semibold">Canonical Discography</span><h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mt-1">Official LP Release</h2></div>
          <span class="self-start sm:self-auto text-xs font-mono text-amber-100/80 px-3 py-1.5 rounded-full bg-stone-950/75 border border-amber-800/40">1 LP · 12 Tracks</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 py-6 px-2">
          <a href={`/music/mary/${album.slug}`} class="group relative flex flex-col items-center text-center transition-transform duration-300 hover:z-40 cursor-pointer rotate-[-1.5deg] hover:rotate-0">
            <div class="vinyl w-48 h-48 sm:w-56 sm:h-56 rounded-full bg-gradient-to-tr from-neutral-950 via-zinc-900 to-black border-4 border-zinc-800/80 shadow-2xl relative flex items-center justify-center -mb-28 group-hover:-translate-y-10 transition-transform duration-500 z-0 overflow-hidden">
              <div class="absolute inset-2 rounded-full border border-zinc-800/60"></div><div class="absolute inset-5 rounded-full border border-zinc-800/40"></div><div class="absolute inset-9 rounded-full border border-zinc-800/40"></div><div class="absolute inset-14 rounded-full border border-zinc-800/40"></div>
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-rose-500/60 relative flex items-center justify-center shadow-lg bg-black"><img src={album.cover} alt="" class="w-full h-full object-cover" /><div class="w-3.5 h-3.5 rounded-full bg-slate-950 border border-slate-700 absolute"></div></div>
            </div>
            <div class="w-full max-w-[270px] aspect-square rounded-2xl overflow-hidden bg-slate-950 border border-rose-500/35 shadow-2xl group-hover:shadow-[0_0_40px_rgba(190,24,93,.34)] group-hover:border-rose-400/90 group-hover:scale-[1.03] transition-all duration-300 relative z-10">
              <img src={album.cover} alt="Bloodlines - Album 1 by Mary" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent opacity-35 group-hover:opacity-70 transition-opacity"></div>
              <div class="absolute top-3 left-3 right-3 flex items-center justify-between"><span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-slate-950/85 text-rose-100 border border-rose-500/40 backdrop-blur-md">Album 1</span><span class="px-2 py-0.5 rounded-full text-[9px] font-mono bg-stone-950/90 text-amber-100 border border-amber-800/50 backdrop-blur-md">{album.tracks} Tracks</span></div>
              <div class="absolute inset-x-0 bottom-0 p-3.5 bg-gradient-to-t from-black via-black/90 to-transparent flex flex-col justify-end text-left"><h3 class="text-sm font-bold text-white group-hover:text-rose-200 transition-colors">Album 1: {album.name}</h3><span class="text-[10px] font-mono text-rose-300 group-hover:text-rose-100 transition-colors flex items-center gap-1 mt-0.5"><span>Open Album & Tracklist</span><span class="group-hover:translate-x-1 transition-transform">&rarr;</span></span></div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <div class="mt-12 pt-8 flex items-center justify-between gap-4 border-t border-rose-900/40"><a href="/music" class="px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-rose-950/90 text-rose-100 border border-rose-500/50 hover:bg-rose-900 transition-all flex items-center justify-center gap-2 shadow-xl"><span>&larr;</span><span>Back to Music</span></a></div>
  </main>
</Layout>

<style>
  :global(body) { background-color: #050816 !important; }
  .mary-music-page { position: relative; z-index: 1; }
  .mary-music-page::before { content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(circle at 16% 16%, rgba(136, 19, 55, .18), transparent 32rem), radial-gradient(circle at 84% 26%, rgba(137, 98, 43, .12), transparent 34rem); }
  .artist-banner::after { content: ''; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 90px rgba(0,0,0,.72); }
  .vinyl { background-image: repeating-radial-gradient(circle at center, transparent 0 7px, rgba(255,255,255,.035) 8px, transparent 9px); }
</style>
