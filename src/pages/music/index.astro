---
// src/pages/music/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allSongs = await getCollection('songs');

// Exact mapping matching your actual public/images/artists/ filenames
function getArtistImage(artistName: string): string {
  const name = String(artistName || '').toLowerCase();
  
  if (name.includes('pandora')) return '/images/artists/pandora-box.jpg';
  if (name.includes('elara')) return '/images/artists/elara-box.jpg';
  if (name.includes('prima')) return '/images/artists/prime-and-timo.jpg'; // Matches your folder's exact spelling
  if (name.includes('crimson')) return '/images/artists/the-crimson-sparks.jpg';
  if (name.includes('maya')) return '/images/artists/maya.jpg';
  if (name.includes('guy')) return '/images/artists/that-guy.jpg';
  if (name.includes('solara')) return '/images/artists/Solara.jpg';
  
  return '/images/default-artist.jpg';
}

const artistCatalog: Record<string, { songCount: number; albums: Set<string>; image: string }> = {};

allSongs.forEach((song: any) => {
  const artist = song.data?.artist ? String(song.data.artist) : 'Unknown Artist';
  const album = song.data?.album ? String(song.data.album) : 'Singles';

  if (!artistCatalog[artist]) {
    artistCatalog[artist] = {
      songCount: 0,
      albums: new Set(),
      image: getArtistImage(artist)
    };
  }

  artistCatalog[artist].songCount += 1;
  artistCatalog[artist].albums.add(album);
});
---

<Layout title="The Cosmos Roster | Music Artists">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50 font-mono">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        {Object.keys(artistCatalog).length} Artists Active Across Levels & Folds
      </div>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white">
        Cosmos <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">Artist Hub</span>
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed">
        Select an artist below to step into their realm, view their canonical discography, and unlock their story.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {Object.entries(artistCatalog).map(([artistName, data]) => {
        const artistSlug = artistName.toLowerCase().replace(/[^a-z0-9]+/g, '-');

        return (
          <a
            key={artistSlug}
            href={`/music/${artistSlug}`}
            class="group relative flex flex-col bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-2xl overflow-hidden shadow-2xl transition-all duration-300 hover:-translate-y-1.5"
          >
            <div class="aspect-square w-full relative overflow-hidden bg-slate-950">
              <img
                src={data.image}
                alt={artistName}
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100 block"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent opacity-80 pointer-events-none"></div>
              
              <div class="absolute bottom-3 left-3 flex gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-950/90 backdrop-blur-md text-purple-200 border border-purple-700/50 shadow-md font-mono">
                  {data.albums.size} Albums
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-900/90 backdrop-blur-md text-slate-300 border border-slate-700/50 shadow-md font-mono">
                  {data.songCount} Tracks
                </span>
              </div>
            </div>

            <div class="p-6 flex items-center justify-between">
              <div>
                <h2 class="text-2xl font-bold text-white group-hover:text-purple-300 transition-colors">{artistName}</h2>
                <p class="text-xs text-slate-400 font-mono mt-1">Official Canonical Roster</p>
              </div>
              <span class="text-purple-400 group-hover:text-purple-300 text-lg transition-transform group-hover:translate-x-1 font-bold">
                →
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
