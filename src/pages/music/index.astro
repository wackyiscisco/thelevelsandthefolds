---
// src/pages/music/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allSongs = await getCollection('songs');

// Safe Album Cover Mapping
function getAlbumCover(artistRaw: any, albumRaw: any): string {
  const artistStr = String(artistRaw || '').toLowerCase();
  const albLower = String(albumRaw || '').toLowerCase();

  if (artistStr.includes('pandora')) {
    if (albLower.includes('wicked')) return '/images/albums/pandora-raven/Wicked.jpg';
    if (albLower.includes('corrupted')) return '/images/albums/pandora-raven/Corrupted.jpg';
    if (albLower.includes('horrors') || albLower.includes('box')) return "/images/albums/pandora-raven/Pandora's Box of Little Horrors.jpg";
    if (albLower.includes('sede vacante')) return '/images/albums/pandora-raven/Sede Vacante.jpg';
    if (albLower.includes('light')) return "/images/albums/pandora-raven/The Raven's Light.jpg";
    if (albLower.includes('shadow')) return "/images/albums/pandora-raven/The Raven's Shadow.jpg";
    if (albLower.includes('spirit') || albLower.includes('twins')) return "/images/albums/pandora-raven/The Spirit of the Raven Twins.jpg";
    if (albLower.includes('pandora raven')) return "/images/albums/pandora-raven/Pandora Raven.jpg";
  }
  return '/images/default-album.jpg';
}

// Group songs safely using standard object initialization to avoid TS accumulator errors
const musicCatalog: Record<string, Record<string, { coverImage: string; songs: any[] }>> = {};

allSongs.forEach((song: any) => {
  const artist = song.data && song.data.artist ? String(song.data.artist) : 'Unknown Artist';
  const album = song.data && song.data.album ? String(song.data.album) : 'Singles & Vault';

  if (!musicCatalog[artist]) {
    musicCatalog[artist] = {};
  }
  if (!musicCatalog[artist][album]) {
    musicCatalog[artist][album] = {
      coverImage: getAlbumCover(artist, album),
      songs: []
    };
  }

  musicCatalog[artist][album].songs.push(song);
});
---

<Layout title="The Cosmos Discography | Music Vault">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50 shadow-inner font-mono">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        {Object.keys(musicCatalog).length} Artists • {allSongs.length} Tracks Active Across the Cosmos
      </div>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white">
        The Cosmos <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">Discography</span>
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed">
        Select an album below to open the official tracklist, read lyrics, and explore universe lore.
      </p>
    </div>

    <!-- Artist & Album Grid Hierarchy -->
    <div class="space-y-16">
      {Object.entries(musicCatalog).map(([artist, albums]) => (
        <section class="space-y-6">
          <div class="flex items-center justify-between border-b border-slate-800/80 pb-4">
            <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-purple-400 flex items-center gap-3">
              <span class="text-slate-600">✦</span> {artist}
            </h2>
            <span class="text-xs text-slate-500 font-mono">{Object.keys(albums).length} Official Releases</span>
          </div>

          <!-- Album Cards Grid (Aspect Ratio Bounded) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {Object.entries(albums).map(([albumName, albumData]) => {
              const artistSlug = artist.toLowerCase().replace(/[^a-z0-9]+/g, '-');
              const albumSlug = albumName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
              
              return (
                <a 
                  href={`/music/${artistSlug}/${albumSlug}`}
                  class="group relative flex flex-col bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-xl overflow-hidden shadow-xl transition-all duration-300 hover:-translate-y-1"
                >
                  <!-- Square Aspect Lock Container to prevent massive images -->
                  <div class="aspect-square w-full relative overflow-hidden bg-slate-950">
                    <img 
                      src={albumData.coverImage} 
                      alt={albumName} 
                      class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100 block"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80 pointer-events-none"></div>
                    <span class="absolute bottom-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-purple-950/90 backdrop-blur-md text-purple-200 border border-purple-700/50 shadow-md font-mono">
                      {albumData.songs.length} Tracks
                    </span>
                  </div>

                  <!-- Card Footer -->
                  <div class="p-4 flex flex-col flex-grow justify-between space-y-3">
                    <div>
                      <h3 class="text-lg font-bold text-slate-100 group-hover:text-purple-300 transition-colors line-clamp-1">{albumName}</h3>
                      <p class="text-xs text-slate-400 mt-0.5 font-mono">Canonical Release</p>
                    </div>
                    <div class="flex items-center text-xs font-semibold text-purple-400 group-hover:text-purple-300 transition-colors font-mono">
                      View Tracklist <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>
