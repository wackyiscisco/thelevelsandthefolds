---
// src/pages/music/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const allSongs = await getCollection('songs');

// Mapping matching public/images/artists/ with custom object positioning per card
function getArtistMeta(artistName: string): { image: string; objectPosition: string } {
  const name = String(artistName || '').toLowerCase();
  
  // object-top pulls the top of Pandora's cover into frame so "The Twins Saga" isn't cropped!
  if (name.includes('pandora')) return { image: '/images/artists/pandora-box.jpg', objectPosition: 'object-top' };
  if (name.includes('elara')) return { image: '/images/artists/elara-box.jpg', objectPosition: 'object-center' };
  if (name.includes('prima')) return { image: '/images/artists/prime-and-timo.jpg', objectPosition: 'object-center' };
  if (name.includes('crimson')) return { image: '/images/artists/the-crimson-sparks.jpg', objectPosition: 'object-center' };
  if (name.includes('maya')) return { image: '/images/artists/maya.jpg', objectPosition: 'object-center' };
  if (name.includes('guy')) return { image: '/images/artists/that-guy.jpg', objectPosition: 'object-center' };
  if (name.includes('solara')) return { image: '/images/artists/Solara.jpg', objectPosition: 'object-center' };
  if (name.includes('defective')) return { image: '/images/artists/the_defective_detective_01.png', objectPosition: 'object-[58%_center]' };
  
  return { image: '/images/default-artist.jpg', objectPosition: 'object-center' };
}

const artistCatalog: Record<string, { songCount: number; albums: Set<string>; image: string; objectPosition: string; coordinate?: string }> = {};

allSongs.forEach((song: any) => {
  const artist = song.data?.artist ? String(song.data.artist) : 'Unknown Artist';
  const album = song.data?.album ? String(song.data.album) : 'Singles';

  if (!artistCatalog[artist]) {
    const meta = getArtistMeta(artist);
    artistCatalog[artist] = {
      songCount: 0,
      albums: new Set(),
      image: meta.image,
      objectPosition: meta.objectPosition
    };
  }

  artistCatalog[artist].songCount += 1;
  artistCatalog[artist].albums.add(album);
});

// Keep the approved project visible even if its individual song files are
// temporarily unavailable during local content work.
// Keep it visible without inventing tracks.
if (!artistCatalog['The Defective Detective']) {
  const meta = getArtistMeta('The Defective Detective');
  artistCatalog['The Defective Detective'] = {
    songCount: 0,
    albums: new Set(['Serah the Kitsune', 'Serah Investigates', 'Serah Contemplates', 'Serah Learns', 'Serah Asks']),
    image: meta.image,
    objectPosition: meta.objectPosition
  };
}

// Wacky-confirmed 6_66 / 66_6 artists. Mary now has her first locked album.
delete artistCatalog['MARY'];
artistCatalog['Mary'] = {
  songCount: 12,
  albums: new Set(['Bloodlines']),
  image: '/images/mary/mary_artist_01.png',
  objectPosition: 'object-[center_22%]',
  coordinate: '6_66'
};

artistCatalog['Count Wrongula'] = {
  songCount: 12,
  albums: new Set(['WHO']),
  image: '/images/count-wrongula/count_wrongula_eve_artist_01.png',
  objectPosition: 'object-[65%_center]',
  coordinate: '66_6'
};

const preferredArtistOrder = [
  // TOP ROW (L → R)
  'The Crimson Sparks',
  'Maya',
  'That Guy',
  // ROW 2 (L → R)
  'Pandora Raven',
  'Elara Dawn',
  'Solara',
  // ROW 3 (L → R)
  'Mary',
  'The Defective Detective',
  'Prima & Timo',
  // Fold-order exception: Count Wrongula closes the roster after Prima & Timo.
  'Count Wrongula',
];

const sortedArtists = Object.entries(artistCatalog).sort((a, b) => {
  const idxA = preferredArtistOrder.indexOf(a[0]);
  const idxB = preferredArtistOrder.indexOf(b[0]);
  if (idxA === -1 && idxB === -1) return a[0].localeCompare(b[0]);
  if (idxA === -1) return 1;
  if (idxB === -1) return -1;
  return idxA - idxB;
});
---

<Layout title="The Cosmos Roster | Music Artists">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50 font-mono">
        <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
        {Object.keys(artistCatalog).length} Artists Active Across Levels & Folds
      </div>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-white">
        Cosmos <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">Artist Hub</span>
      </h1>
      <p class="text-slate-400 text-sm md:text-base leading-relaxed">
        Select an artist below to step into their realm, view their canonical discography, and unlock their story.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedArtists.map(([artistName, data]) => {
        const artistSlug = (() => {
          const name = String(artistName || '').toLowerCase().trim();
          if (name.includes('crimson')) return 'crimson-sparks';
          if (name.includes('maya')) return 'maya';
          if (name.includes('guy')) return 'that-guy';
          if (name.includes('pandora')) return 'pandora-raven';
          if (name.includes('elara')) return 'elara-dawn';
          if (name.includes('solara')) return 'solara';
          if (name === 'mary') return 'mary';
          if (name.includes('wrongula')) return 'count-wrongula';
          if (name.includes('defective')) return 'defective-detective';
          if (name.includes('prima')) return 'prima-timo';
          return 'artist';
        })();

        const hasArtistImage = Boolean(data.image);
        const artistHref = `/music/${artistSlug}`;

        return (
          <a
            key={artistSlug}
            href={artistHref}
            class="group relative flex flex-col bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-2xl overflow-hidden shadow-2xl transition-all duration-300 hover:-translate-y-1.5"
          >
            <div class="aspect-square w-full relative overflow-hidden bg-slate-950">
              {!hasArtistImage ? (
                <div class="absolute inset-0 flex flex-col items-center justify-center transition-transform duration-500 group-hover:scale-105 bg-[#d7c39a] text-stone-900">
                  <div class="absolute inset-0 opacity-25 bg-[repeating-linear-gradient(0deg,transparent_0_28px,rgba(75,55,30,0.16)_29px)]"></div>
                  <span class="relative font-mono text-sm font-black tracking-[0.32em]">{data.coordinate}</span>
                  <span class="relative mt-5 text-5xl font-serif italic font-bold">{artistName}</span>
                  <span class="relative mt-4 font-mono text-[10px] tracking-[0.22em] uppercase opacity-60">Placeholder</span>
                </div>
              ) : (
                <img
                  src={data.image}
                  alt={artistName}
                  class={`object-cover w-full h-full ${data.objectPosition} group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100 block`}
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent opacity-80 pointer-events-none"></div>
              
              <div class="absolute bottom-3 left-3 flex gap-2">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-950/90 backdrop-blur-md text-purple-200 border border-purple-700/50 shadow-md font-mono">
                  {data.albums.size} {data.albums.size === 1 ? 'Album' : 'Albums'}
                </span>
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-slate-900/90 backdrop-blur-md text-slate-300 border border-slate-700/50 shadow-md font-mono">
                  {data.songCount} Tracks
                </span>
              </div>
            </div>

            <div class="p-6 flex items-center justify-between">
              <div>
                <h2 class="text-2xl font-bold text-white group-hover:text-purple-300 transition-colors">{artistName}</h2>
                <p class="text-xs text-slate-400 font-mono mt-1">{data.coordinate ? `${data.coordinate} · Official Canonical Roster` : 'Official Canonical Roster'}</p>
              </div>
              <span class="text-purple-400 group-hover:text-purple-300 text-lg transition-transform group-hover:translate-x-1 font-bold">
                →
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
