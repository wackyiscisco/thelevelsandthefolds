---
// src/pages/music/[artist]/[album].astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const songs = await getCollection('songs');
  const pathMap = new Map();

  songs.forEach(song => {
    const artist = song.data?.artist ? String(song.data.artist) : 'Unknown Artist';
    const album = song.data?.album ? String(song.data.album) : 'Singles';
    const artistSlug = artist.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    const albumSlug = album.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    
    if (artistSlug && albumSlug) {
      const key = `${artistSlug}/${albumSlug}`;
      if (!pathMap.has(key)) {
        pathMap.set(key, { artistSlug, albumSlug, artistName: artist, albumName: album });
      }
    }
  });

  return Array.from(pathMap.values()).map(item => ({
    params: { artist: item.artistSlug, album: item.albumSlug },
    props: { artistName: item.artistName, albumName: item.albumName }
  }));
}

const { artist, album } = Astro.params;
const { artistName, albumName } = Astro.props;

const allSongs = await getCollection('songs');

function getAlbumCover(artistStr: string, albumStr: string): string {
  const albLower = String(albumStr || '').toLowerCase();
  if (albLower.includes('wicked')) return '/images/albums/pandora-raven/Wicked.jpg';
  if (albLower.includes('corrupted')) return '/images/albums/pandora-raven/Corrupted.jpg';
  if (albLower.includes('horrors') || albLower.includes('box')) return "/images/albums/pandora-raven/Pandora's Box of Little Horrors.jpg";
  if (albLower.includes('sede vacante')) return '/images/albums/pandora-raven/Sede Vacante.jpg';
  if (albLower.includes('light')) return "/images/albums/pandora-raven/The Raven's Light.jpg";
  if (albLower.includes('shadow')) return "/images/albums/pandora-raven/The Raven's Shadow.jpg";
  if (albLower.includes('spirit') || albLower.includes('twins')) return "/images/albums/pandora-raven/The Spirit of the Raven Twins.jpg";
  if (albLower.includes('pandora raven')) return "/images/albums/pandora-raven/Pandora Raven.jpg";
  return '/images/default-album.jpg';
}

let albumSongs = allSongs.filter(song => {
  const aSlug = String(song.data?.artist || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
  const alSlug = String(song.data?.album || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
  return aSlug === artist && alSlug === album;
});

function getTrackOrder(song: any): number {
  if (song.data?.trackNumber) return Number(song.data.trackNumber);
  if (song.data?.track) return Number(song.data.track);

  const title = String(song.data?.title || '');
  const slug = String(song.slug || '');

  const titleMatch = title.match(/^(\d+)[._\s-]/);
  if (titleMatch) return parseInt(titleMatch[1], 10);

  const slugMatch = slug.match(/^(\d+)[-_.]/);
  if (slugMatch) return parseInt(slugMatch[1], 10);

  return 99;
}

albumSongs.sort((a, b) => getTrackOrder(a) - getTrackOrder(b));

const coverImage = getAlbumCover(artistName, albumName);
---

<Layout title={`${albumName} | ${artistName} — The Cosmos`}>
  <main class="max-w-5xl mx-auto px-6 py-12">
    <a href={`/music/${artist}`} class="text-sm text-purple-400 hover:text-purple-300 mb-8 inline-flex items-center gap-2 transition-colors font-mono">
      ← Back to {artistName} Discography
    </a>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center mb-12 bg-slate-900/60 p-8 rounded-2xl border border-slate-800/80 shadow-2xl backdrop-blur-sm">
      <div class="aspect-square relative rounded-xl overflow-hidden shadow-2xl border border-slate-700/50 bg-slate-950 w-full max-w-[280px] mx-auto md:max-w-none">
        <img src={coverImage} alt={albumName} class="object-cover w-full h-full block" />
      </div>
      <div class="md:col-span-2 space-y-4 text-center md:text-left">
        <span class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50 font-mono inline-block">
          {artistName}
        </span>
        <h1 class="text-3xl md:text-5xl font-black tracking-tight text-white">{albumName}</h1>
        <p class="text-slate-400 text-sm leading-relaxed">
          {albumSongs.length} Canonical Tracks in official release sequence. Select any song below to read full lyrics and lore notes.
        </p>
      </div>
    </div>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold tracking-tight text-purple-400 border-b border-slate-800 pb-3 flex items-center justify-between">
        <span>Official Tracklist</span>
        <span class="text-xs text-slate-500 font-mono font-normal">{albumSongs.length} Songs</span>
      </h2>
      
      <div class="space-y-3 pt-2">
        {albumSongs.map((song, index) => {
          const songUrl = `/music/${song.slug}`;
          const displayTrackNum = (index + 1).toString().padStart(2, '0');

          return (
            <a 
              key={song.slug}
              href={songUrl}
              class="group flex items-center justify-between p-4 rounded-xl bg-slate-900/40 hover:bg-slate-900 border border-slate-800/80 hover:border-purple-500/50 transition-all duration-200 shadow-md"
            >
              <div class="flex items-center space-x-4">
                <span class="text-purple-400 font-mono text-sm w-8 text-center font-bold">{displayTrackNum}</span>
                <div>
                  <h3 class="font-semibold text-slate-200 group-hover:text-purple-300 transition-colors">{song.data?.title || song.slug}</h3>
                  {song.data?.quote && <p class="text-xs text-slate-500 italic mt-0.5 line-clamp-1">"{song.data.quote}"</p>}
                </div>
              </div>
              <span class="text-xs font-medium text-purple-400 group-hover:text-purple-300 flex items-center gap-1 opacity-80 group-hover:opacity-100 transition-all font-mono">
                Read Lyrics <span class="transition-transform group-hover:translate-x-1">→</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</Layout>
