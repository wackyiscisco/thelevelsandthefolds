---
// src/pages/music/[artist]/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allSongs = await getCollection('songs');
  
  const artistSlugs = new Set(
    allSongs.map((song: any) => 
      String(song.data.artist || '').toLowerCase().replace(/[^a-z0-9]+/g, '-')
    )
  );

  return Array.from(artistSlugs).map((slug) => ({
    params: { artist: slug },
  }));
}

const { artist: artistParam } = Astro.params;
const allSongs = await getCollection('songs');

const artistSongs = allSongs.filter((song: any) => {
  const slug = String(song.data.artist || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
  return slug === artistParam;
});

const artistName = artistSongs[0]?.data?.artist || 'Artist';

// Helper: Extract numerical album value for timeline ordering (1 -> 2 -> 3 -> 4 -> 5.5 -> 6.5)
function extractAlbumNumber(albumTitle: string): number {
  const match = albumTitle.match(/Album\s+([\d.]+)/i) || albumTitle.match(/([\d.]+)/);
  if (match && match[1]) {
    return parseFloat(match[1]);
  }
  return 999;
}

// Helper: Maps full album strings ("Album 6.5: The Raven's Shadow") to your exact GitHub filenames ("The Raven's Shadow.jpg")
function getExactAlbumImage(albumTitle: string, frontmatterImage?: string): string {
  // If a valid path is explicitly supplied in frontmatter, use it
  if (frontmatterImage && frontmatterImage.trim() !== '') {
    return frontmatterImage;
  }

  // Strip prefix like "Album 6.5: " or "Album 1: " to get raw album name
  const cleanTitle = albumTitle.replace(/^Album\s+[\d.]+:\s*/i, '').trim();

  // Return the direct public path matching your actual uploaded GitHub filenames
  return `/images/albums/${artistParam}/${cleanTitle}.jpg`;
}

// Group tracks by album
const albumMap: Record<string, { title: string; coverImage: string; count: number }> = {};

artistSongs.forEach((song: any) => {
  const albumTitle = song.data.album || 'Singles';

  if (!albumMap[albumTitle]) {
    albumMap[albumTitle] = {
      title: albumTitle,
      coverImage: getExactAlbumImage(albumTitle, song.data.coverImage),
      count: 0
    };
  }
  albumMap[albumTitle].count += 1;
});

// Sort albums ASCENDING by number (1 -> 2 -> 3 -> 4 -> 5.5 -> 6.5)
const sortedAlbums = Object.values(albumMap).sort((a, b) => {
  return extractAlbumNumber(a.title) - extractAlbumNumber(b.title);
});
---

<Layout title={`${artistName} | Discography`}>
  <main class="max-w-7xl mx-auto px-6 py-12">
    <!-- Header -->
    <div class="mb-12 space-y-2">
      <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50 font-mono">
        Official Canonical Discography
      </div>
      <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight">{artistName}</h1>
      <p class="text-slate-400 text-sm md:text-base font-mono">
        {sortedAlbums.length} Canonical Releases arranged in timeline sequence.
      </p>
    </div>

    <!-- Album Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {sortedAlbums.map((album) => {
        const albumSlug = album.title.toLowerCase().replace(/[^a-z0-9]+/g, '-');

        return (
          <a
            href={`/music/${artistParam}/${albumSlug}`}
            class="group relative flex flex-col bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-2xl overflow-hidden shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <!-- Album Cover Box -->
            <div class="aspect-square w-full relative overflow-hidden bg-slate-950">
              <img
                src={album.coverImage}
                alt={album.title}
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100 block"
                onerror="this.onerror=null; this.src='/images/default-artist.jpg';"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/10 to-transparent opacity-80 pointer-events-none"></div>
              
              <div class="absolute bottom-3 left-3">
                <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-purple-950/90 backdrop-blur-md text-purple-200 border border-purple-700/50 font-mono">
                  {album.count} Tracks
                </span>
              </div>
            </div>

            <!-- Card Info -->
            <div class="p-5 flex flex-col justify-between flex-1">
              <div>
                <h2 class="text-lg font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-1">
                  {album.title}
                </h2>
                <p class="text-xs text-slate-400 font-mono mt-1">Canonical Release</p>
              </div>

              <div class="mt-4 flex items-center justify-between text-xs font-mono text-purple-400 group-hover:text-purple-300">
                <span>View Tracklist</span>
                <span class="transition-transform group-hover:translate-x-1 font-bold">→</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
