---
import fs from 'fs';
import path from 'path';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allSongs = await getCollection('songs');
  const albumMap = new Map();

  // Helper to normalize album names into stable slugs (must match artist index normalization)
  const normalizeAlbumSlug = (raw) => {
    if (!raw) return 'album-unknown';
    let s = String(raw).toLowerCase();
    // remove smart quotes/apostrophes
    s = s.replace(/['’]/g, '');
    // strip leading 'album' word
    s = s.replace(/^\s*album\s*/i, '');
    // strip leading numeric prefixes like "3.0", "3", "1.5", optionally followed by : - – —
    s = s.replace(/^\s*\d+(?:\.\d+)?\s*[:\-–—]?\s*/, '');
    // slugify remainder
    s = s.replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    return `album-${s}`;
  };

  allSongs.forEach((song) => {
    // Safety check to hide Dawn's Raven (Spoiler Album Secret)
    const albumName = song.data.album ? String(song.data.album).toLowerCase() : '';
    if (albumName.includes("dawn's raven") || albumName.includes("dawns raven")) {
      return;
    }

    const artistSlug = (() => {
      const name = String(song.data.artist || '').toLowerCase().trim();
      if (name.includes('crimson')) return 'crimson-sparks';
      if (name.includes('maya')) return 'maya';
      if (name.includes('guy')) return 'that-guy';
      if (name.includes('pandora')) return 'pandora-raven';
      if (name.includes('elara')) return 'elara-dawn';
      if (name.includes('solara')) return 'solara';
      if (name.includes('prima')) return 'prima-timo';
      return 'artist';
    })();
    const albumSlug = song.data.album ? normalizeAlbumSlug(song.data.album) : 'album-unknown';
    
    const key = `${artistSlug}/${albumSlug}`;
    if (!albumMap.has(key)) {
      albumMap.set(key, {
        params: { artist: artistSlug, album: albumSlug },
        props: {
          artistName: song.data.artist,
          albumName: song.data.album,
        },
      });
    }
  });

  return Array.from(albumMap.values());
}

const { artist, album } = Astro.params;
const { artistName, albumName } = Astro.props;

// Fetch all songs and filter for this specific album
const allSongs = await getCollection('songs');
const albumSongs = allSongs.filter((song) => {
  if (!song.data?.album) return false;
  const normalizedInner = String(song.data.album).toLowerCase()
    .replace(/['’]/g, '')
    .replace(/^\s*album\s*/i, '')
    .replace(/^\s*\d+(?:\.\d+)?\s*[:\-–—]?\s*/, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
  return `album-${normalizedInner}` === album;
});

// Robust cover image fallback: pick the first available coverImage defined in the album's songs metadata
const coverImage = albumSongs.find((s) => s.data.coverImage)?.data.coverImage || '';

// Sort songs by trackNumber numerically, falling back to title alphabetical order
albumSongs.sort((a, b) => {
  const numA = typeof a.data.trackNumber === 'number' ? a.data.trackNumber : 999;
  const numB = typeof b.data.trackNumber === 'number' ? b.data.trackNumber : 999;
  if (numA !== numB) {
    return numA - numB;
  }
  return a.data.title.localeCompare(b.data.title);
});
---

<Layout title={`${albumName} | ${artistName}`}>
  <main class="max-w-5xl mx-auto px-6 py-10 space-y-8">
    
    <!-- Navigation Back Link Bar (Sticky Top Sub-Header Bar) -->
    <div class="sticky top-[80px] z-40 -mx-6 px-6 py-3.5 mb-6 bg-black/85 backdrop-blur-xl border-b border-purple-900/40 shadow-2xl flex items-center justify-between transition-all">
      <a href={`/music/${artist}`} class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-mono font-extrabold bg-purple-950/95 text-purple-200 border-2 border-purple-500/60 hover:bg-purple-900 hover:text-white transition-all shadow-xl hover:shadow-purple-900/60 hover:scale-105 flex items-center gap-2.5">
        <span class="text-purple-400 font-bold text-sm">&larr;</span>
        <span>Back to {artistName} Discography</span>
      </a>
      <span class="text-[11px] font-mono text-purple-300/90 uppercase px-3.5 py-1.5 rounded-full bg-purple-950/80 border border-purple-700/50 backdrop-blur-md shadow-md hidden sm:inline-block">
        {artistName} • Canonical LP
      </span>
    </div>
    
    <div class="p-8 md:p-10 rounded-2xl bg-slate-900/60 border border-purple-900/40 flex flex-col md:flex-row gap-8 items-center md:items-start shadow-2xl">
      {coverImage ? (
        <img 
          src={coverImage} 
          alt={albumName} 
          class="w-56 h-56 md:w-64 md:h-64 object-cover rounded-xl shadow-2xl border border-purple-500/20"
        />
      ) : (
        <div class="w-56 h-56 md:w-64 md:h-64 bg-slate-800 rounded-xl flex items-center justify-center text-slate-500 font-mono text-xs">
          No Cover Image
        </div>
      )}
      <div class="space-y-4 text-center md:text-left flex-1">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-purple-950/80 text-purple-300 border border-purple-700/40">
          {artistName}
        </span>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-slate-50">
          {albumName}
        </h1>
        <p class="text-sm text-slate-400 leading-relaxed max-w-2xl">
          {albumSongs.length} Tracks in official release sequence. Select any song below to read full lyrics.
        </p>
      </div>
    </div>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-400">
        Official Tracklist
      </h2>

      <div class="space-y-3">
        {albumSongs.map((song, index) => {
          const songSlug = song.slug;
          const trackNum = typeof song.data.trackNumber === 'number' ? song.data.trackNumber : (index + 1);
          const formattedTrackNum = String(trackNum).padStart(2, '0');

          return (
            <a 
              href={`/music/${songSlug}`}
              class="block p-4 md:p-5 rounded-xl bg-slate-900/40 hover:bg-slate-900/90 border border-purple-900/20 hover:border-purple-500/50 transition-all shadow-md"
            >
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-4 md:gap-6 min-w-0">
                  <span class="text-lg md:text-xl font-mono font-bold text-purple-400">
                    {formattedTrackNum}
                  </span>
                  <div class="min-w-0">
                    <h3 class="text-base md:text-lg font-semibold text-slate-100 truncate">
                      {song.data.title}
                    </h3>
                    {song.data.quote && (
                      <p class="text-xs md:text-sm italic text-slate-400 truncate mt-0.5">
                        "{song.data.quote}"
                      </p>
                    )}
                  </div>
                </div>
                <span class="text-xs font-mono text-purple-400/80 shrink-0">
                  Read Lyrics &rarr;
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Bottom Navigation Actions -->
    <div class="pt-8 pb-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-purple-900/40">
      <a href={`/music/${artist}`} class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-purple-950/90 text-purple-200 border border-purple-500/50 hover:bg-purple-900 hover:text-white transition-all flex items-center justify-center gap-2 shadow-xl hover:shadow-purple-900/50 hover:-translate-x-1">
        <span class="text-purple-400 font-bold text-sm">&larr;</span>
        <span>Back to {artistName} Discography</span>
      </a>
      <a href="/artists" class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-slate-900/90 text-slate-300 border border-slate-700/50 hover:bg-slate-800 hover:text-white transition-all flex items-center justify-center gap-2 shadow-xl">
        <span>Back to Roster</span>
        <span class="text-slate-400 font-bold text-sm">&rarr;</span>
      </a>
    </div>

  </main>
</Layout>
