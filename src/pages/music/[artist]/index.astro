<script is:inline define:vars={{ activeColor: fx.activeTab }}>
  // Simple client-side tab switching script
  const tabs = document.querySelectorAll('[data-tab]');
  const panels = document.querySelectorAll('[data-panel]');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-tab');

      // Hide all panels
      panels.forEach(panel => {
        panel.classList.add('hidden');
      });

      // Show the selected panel
      const targetPanel = document.querySelector(`[data-panel="${target}"]`);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }

      // Reset all tab styles
      tabs.forEach(t => {
        t.className = 'px-4 py-2 rounded-xl font-bold border border-transparent text-slate-400 hover:text-slate-200 transition-all';
      });

      // Apply active style to clicked tab
      tab.className = `px-4 py-2 rounded-xl font-bold border border-transparent transition-all shadow-md active-tab ${activeColor}`;
    });
  });

  // Client-side Crimson Sparks Band Member Switcher
  const sparksTabs = document.querySelectorAll('[data-sparks-member]');
  const sparksPanels = document.querySelectorAll('[data-sparks-panel]');

  sparksTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetMember = tab.getAttribute('data-sparks-member');

      // Hide all sparks member panels
      sparksPanels.forEach(panel => {
        panel.classList.add('hidden');
      });

      // Show selected member panel
      const targetPanel = document.querySelector(`[data-sparks-panel="${targetMember}"]`);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }

      // Reset all sparks member tab styling
      sparksTabs.forEach(t => {
        t.className = 'sparks-member-tab px-4 py-3 rounded-xl border font-mono text-xs text-left transition-all duration-200 shadow-md bg-zinc-950 border-slate-800 text-slate-400 hover:border-red-800 hover:text-slate-200';
        const titleDiv = t.querySelector('div:first-child');
        const roleDiv = t.querySelector('div:last-child');
        if (titleDiv) titleDiv.className = 'font-bold text-sm text-white';
        if (roleDiv) roleDiv.className = 'text-[10px] text-slate-400 mt-0.5';
      });

      // Set active style for clicked member tab
      tab.className = 'sparks-member-tab active-sparks-tab px-4 py-3 rounded-xl border font-mono text-xs text-left transition-all duration-200 shadow-md bg-red-950/90 border-red-500 text-white shadow-red-900/40';
      const activeTitleDiv = tab.querySelector('div:first-child');
      const activeRoleDiv = tab.querySelector('div:last-child');
    });
  });

  // Client-side Scavenger Duo Member Switcher (Prima & Timo)
  const duoTabs = document.querySelectorAll('[data-duo-member]');
  const duoPanels = document.querySelectorAll('[data-duo-panel]');

  duoTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetMember = tab.getAttribute('data-duo-member');

      // Hide all duo member panels
      duoPanels.forEach(panel => {
        panel.classList.add('hidden');
      });

      // Show selected member panel
      const targetPanel = document.querySelector(`[data-duo-panel="${targetMember}"]`);
      if (targetPanel) {
        targetPanel.classList.remove('hidden');
      }

      // Reset all duo member tab styling
      duoTabs.forEach(t => {
        t.className = 'duo-member-tab px-5 py-3.5 rounded-xl border text-left transition-all duration-200 shadow-md bg-slate-950 border-slate-800 text-slate-400 hover:border-orange-800 hover:text-slate-200';
        const titleDiv = t.querySelector('div:first-child');
        const roleDiv = t.querySelector('div:last-child');
        if (titleDiv) titleDiv.className = 'font-bold text-sm text-white';
        if (roleDiv) roleDiv.className = 'text-[11px] text-slate-400 mt-0.5';
      });

      // Set active style for clicked member tab
      const isPrima = targetMember === 'prima';
      tab.className = isPrima
        ? 'duo-member-tab active-duo-tab px-5 py-3.5 rounded-xl border text-left transition-all duration-200 shadow-lg bg-teal-950/90 border-teal-500 text-white shadow-teal-950/50'
        : 'duo-member-tab active-duo-tab px-5 py-3.5 rounded-xl border text-left transition-all duration-200 shadow-lg bg-orange-950/90 border-orange-500 text-white shadow-orange-950/50';

      const activeTitleDiv = tab.querySelector('div:first-child');
      const activeRoleDiv = tab.querySelector('div:last-child');
      if (activeTitleDiv) activeTitleDiv.className = isPrima ? 'font-bold text-sm text-teal-300' : 'font-bold text-sm text-orange-300';
      if (activeRoleDiv) activeRoleDiv.className = 'text-[11px] text-slate-300 mt-0.5';
    });
  });

  // Global Lightbox Modal Functions for Character Sheets
  window.openSheetModal = function(src) {
    const modal = document.getElementById('sheet-modal');
    const img = document.getElementById('sheet-modal-img');
    if (modal && img) {
      img.src = src;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  };

  window.closeSheetModal = function() {
    const modal = document.getElementById('sheet-modal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (typeof window.closeSheetModal === 'function') {
        window.closeSheetModal();
      }
    }
  });
</script>

<!-- Lightbox Modal for 4K Character Sheets -->
