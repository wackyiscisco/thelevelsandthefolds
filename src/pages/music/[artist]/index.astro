---
import fs from 'fs';
import path from 'path';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allSongs = await getCollection('songs');
  const artistMap = new Map();

  allSongs.forEach((song) => {
    const artistSlug = song.data.artist
      ? String(song.data.artist).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
      : 'artist';
    if (!artistMap.has(artistSlug)) {
      artistMap.set(artistSlug, {
        params: { artist: artistSlug },
        props: { artistName: song.data.artist || 'Artist' },
      });
    }
  });

  return Array.from(artistMap.values());
}

const { artist } = Astro.params;
const { artistName } = Astro.props;

// Helper: Normalize string for filename matching
function normalizeForCompare(s = '') {
  return String(s).toLowerCase().replace(/[^a-z0-9]/g, '');
}

// Helper: Attempt to find a cover image in public/images/albums/{artistSlug}
// - match filenames ignoring case/spacing/punctuation
// - fallback to first image file in folder
function findAlbumCoverOnDisk(artistSlug, albumSlug, albumName) {
  try {
    const dir = path.join(process.cwd(), 'public', 'images', 'albums', artistSlug);
    if (!fs.existsSync(dir)) return null;
    const files = fs.readdirSync(dir).filter((f) => /\.(jpe?g|png|webp|gif)$/i.test(f));
    if (files.length === 0) return null;

    const target1 = normalizeForCompare(albumSlug);
    const target2 = normalizeForCompare(albumName);

    // Find best match: filename normalized contains albumSlug/albumName
    for (const f of files) {
      const name = path.parse(f).name;
      const n = normalizeForCompare(name);
      if (target1 && n.includes(target1)) return `/images/albums/${artistSlug}/${f}`;
      if (target2 && n.includes(target2)) return `/images/albums/${artistSlug}/${f}`;
    }

    // No match: return first image (stable)
    return `/images/albums/${artistSlug}/${files[0]}`;
  } catch (err) {
    // If anything goes wrong, return null (graceful)
    return null;
  }
}

// Fetch all songs for this artist
const allSongs = await getCollection('songs');
const artistSongs = allSongs.filter((song) => {
  const currentArtistSlug = song.data.artist
    ? String(song.data.artist).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')
    : '';
  return currentArtistSlug === artist;
});

// Group songs by album and robustly locate cover images & track counts
const albumMap = new Map();
artistSongs.forEach((song) => {
  const albumName = song.data.album || 'Unknown Album';
  const albumSlug = albumName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  const artistSlug = artist;

  if (!albumMap.has(albumSlug)) {
    albumMap.set(albumSlug, {
      albumName,
      albumSlug,
      coverImage: null,
      trackCount: 0,
      // keep a small list of songs for potential future logic
      songs: [],
    });
  }

  const albumData = albumMap.get(albumSlug);
  albumData.trackCount++;
  albumData.songs.push(song);

  // Use first valid coverImage from song frontmatter if present
  if (song.data.coverImage && !albumData.coverImage) {
    albumData.coverImage = song.data.coverImage;
  }
});

// After collecting, if any album has no coverImage, attempt to find it on disk
for (const [slug, albumData] of albumMap.entries()) {
  if (!albumData.coverImage) {
    const maybe = findAlbumCoverOnDisk(artist, albumData.albumSlug, albumData.albumName);
    if (maybe) albumData.coverImage = maybe;
  }
}

// Convert to array and sort albums by numeric album prefix if present (Album 1, Album 2, Album 5.5 etc)
function extractAlbumNumber(name = '') {
  const m = name.match(/Album\s*([0-9]+(?:\.[0-9]+)?)/i);
  if (m) return parseFloat(m[1]);
  // If no numeric prefix, fallback to large number so it goes last
  return 9999;
}
const albums = Array.from(albumMap.values()).sort((a, b) => {
  const numA = extractAlbumNumber(a.albumName);
  const numB = extractAlbumNumber(b.albumName);
  if (numA !== numB) return numA - numB;
  // fallback alphabetical
  return a.albumName.localeCompare(b.albumName);
});
---
<Layout title={`${artistName} — Official Discography | The Cosmos`}>
  <main class="max-w-7xl mx-auto px-6 py-12 space-y-12">
    <div class="space-y-4">
      <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-purple-950/80 text-purple-300 border border-purple-700/40">
        Official Canonical Discography
      </span>
      <h1 class="text-4xl md:text-6xl font-black tracking-tight text-slate-50">
        {artistName}
      </h1>
      <p class="text-slate-400 max-w-xl text-sm leading-relaxed">
        {albums.length} Canonical Releases arranged in timeline sequence. Click any album card to explore official tracklists and lyric archives.
      </p>
    </div>

    <!-- Fully Clickable Album Grid Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {albums.map((album) => (
        <a 
          href={`/music/${artist}/${album.albumSlug}`}
          class="group p-6 rounded-2xl bg-slate-900/60 border border-purple-900/40 backdrop-blur flex flex-col justify-between shadow-2xl hover:border-purple-500/80 hover:bg-slate-900/90 transition-all"
        >
          <div class="space-y-4">
            {album.coverImage ? (
              <img 
                src={album.coverImage} 
                alt={album.albumName} 
                class="w-full h-72 object-cover rounded-xl shadow-lg border border-purple-500/20 group-hover:scale-[1.02] transition-transform duration-300"
              />
            ) : (
              <div class="w-full h-72 bg-slate-800/80 rounded-xl flex items-center justify-center border border-purple-500/20 text-slate-500 font-mono text-xs">
                Cover Art Pending
              </div>
            )}
            <div class="space-y-2">
              <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase bg-purple-950 text-purple-300 border border-purple-800/50">
                {album.trackCount} Tracks
              </span>
              <h3 class="text-xl font-bold text-slate-100 group-hover:text-purple-300 transition-colors">
                {album.albumName}
              </h3>
              <p class="text-xs text-slate-400">Canonical Release</p>
            </div>
          </div>
          
          <div class="pt-6 mt-6 border-t border-purple-900/30 flex items-center justify-between">
            <span class="text-xs font-mono font-semibold text-purple-400 group-hover:text-pink-400 flex items-center gap-1 transition-colors">
              View Tracklist &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Layout>
