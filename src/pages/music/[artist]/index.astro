---
// src/pages/music/[artist]/index.astro
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const songs = await getCollection('songs');
  const artistsMap = new Map();

  songs.forEach(song => {
    const artist = song.data?.artist ? String(song.data.artist) : 'Unknown Artist';
    const artistSlug = artist.toLowerCase().replace(/[^a-z0-9]+/g, '-');
    if (artistSlug && !artistsMap.has(artistSlug)) {
      artistsMap.set(artistSlug, { artistSlug, artistName: artist });
    }
  });

  return Array.from(artistsMap.values()).map(item => ({
    params: { artist: item.artistSlug },
    props: { artistName: item.artistName }
  }));
}

const { artist } = Astro.params;
const { artistName } = Astro.props;

const allSongs = await getCollection('songs');

const artistSongs = allSongs.filter(song => {
  const aSlug = String(song.data?.artist || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
  return aSlug === artist;
});

function getAlbumCover(artistStr: string, albumStr: string): string {
  const albLower = String(albumStr || '').toLowerCase();
  if (albLower.includes('wicked')) return '/images/albums/pandora-raven/Wicked.jpg';
  if (albLower.includes('corrupted')) return '/images/albums/pandora-raven/Corrupted.jpg';
  if (albLower.includes('horrors') || albLower.includes('box')) return "/images/albums/pandora-raven/Pandora's Box of Little Horrors.jpg";
  if (albLower.includes('sede vacante')) return '/images/albums/pandora-raven/Sede Vacante.jpg';
  if (albLower.includes('light')) return "/images/albums/pandora-raven/The Raven's Light.jpg";
  if (albLower.includes('shadow')) return "/images/albums/pandora-raven/The Raven's Shadow.jpg";
  if (albLower.includes('spirit') || albLower.includes('twins')) return "/images/albums/pandora-raven/The Spirit of the Raven Twins.jpg";
  if (albLower.includes('pandora raven')) return "/images/albums/pandora-raven/Pandora Raven.jpg";
  return '/images/default-album.jpg';
}

const albumsMap: Record<string, { coverImage: string; songs: any[] }> = {};

artistSongs.forEach((song: any) => {
  const albumName = song.data?.album ? String(song.data.album) : 'Singles';
  if (!albumsMap[albumName]) {
    albumsMap[albumName] = {
      coverImage: getAlbumCover(artistName, albumName),
      songs: []
    };
  }
  albumsMap[albumName].songs.push(song);
});

// Master Canonical Ranking System
function getAlbumCanonRank(albumTitle: string): number {
  const title = albumTitle.toLowerCase();

  if (title.includes('0.5') || title.includes('beginning')) return 0.5;
  if (title.includes('1:') || title.includes('wicked') || title.includes('mercy') || title.includes('first spark') || title.includes('preflight') || title.includes('unus')) return 1;
  if (title.includes('2:') || title.includes('corrupted') || title.includes('unbroken') || title.includes('wheels up') || title.includes('centum')) return 2;
  if (title.includes('3:') || title.includes('horrors') || title.includes('miracles') || title.includes('crash and burn') || title.includes('turbulence') || title.includes('duo')) return 3;
  if (title.includes('4:') || title.includes('sede vacante') || title.includes('fides') || title.includes('ignite') || title.includes('crash') || title.includes('nonaginta novem')) return 4;
  if (title.includes('5.5') || title.includes('raven\'s light')) return 5.5;
  if (title.includes('5:') || title.includes('rise of war') || title.includes('crimson five') || title.includes('stripped') || title.includes('tria')) return 5;
  if (title.includes('6.5') || title.includes('raven\'s shadow')) return 6.5;
  if (title.includes('6:') || title.includes('age of destruction') || title.includes('wildfire') || title.includes('strings and theories') || title.includes('nonaginta octo')) return 6;
  if (title.includes('7.5') || title.includes('spirit of the raven')) return 7.5;
  if (title.includes('7:') || title.includes('polaris') || title.includes('embers') || title.includes('quattuor')) return 7;
  if (title.includes('8.5') || title.includes('elara dawn')) return 8.5;
  if (title.includes('8:') || title.includes('pandora raven')) return 8;
  if (title.includes('9') || title.includes('convergence') || title.includes('solara')) return 9;

  const numMatch = title.match(/album\s*(\d+(\.\d+)?)/i) || title.match(/^(\d+(\.\d+)?)/);
  if (numMatch) return parseFloat(numMatch[1]);

  return 99;
}

const sortedAlbums = Object.entries(albumsMap).sort(([aName], [bName]) => {
  return getAlbumCanonRank(aName) - getAlbumCanonRank(bName);
});
---

<Layout title={`${artistName} Discography | The Cosmos`}>
  <main class="max-w-7xl mx-auto px-6 py-12">
    <a href="/music" class="text-sm text-purple-400 hover:text-purple-300 mb-8 inline-flex items-center gap-2 transition-colors font-mono">
      ← Back to Artists Roster
    </a>

    <div class="border-b border-slate-800 pb-6 mb-12">
      <span class="px-3 py-1 rounded-full text-xs font-mono font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50">
        Official Canonical Discography
      </span>
      <h1 class="text-4xl md:text-5xl font-black text-white mt-3">{artistName}</h1>
      <p class="text-slate-400 text-sm mt-2">{sortedAlbums.length} Canonical Releases arranged in timeline sequence.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {sortedAlbums.map(([albumName, albumData]) => {
        const albumSlug = albumName.toLowerCase().replace(/[^a-z0-9]+/g, '-');

        return (
          <a 
            key={albumSlug}
            href={`/music/${artist}/${albumSlug}`}
            class="group relative flex flex-col bg-slate-900/60 hover:bg-slate-900 border border-slate-800 hover:border-purple-500/50 rounded-xl overflow-hidden shadow-xl transition-all duration-300 hover:-translate-y-1"
          >
            <div class="aspect-square w-full relative overflow-hidden bg-slate-950">
              <img 
                src={albumData.coverImage} 
                alt={albumName} 
                class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-500 opacity-90 group-hover:opacity-100 block"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-transparent to-transparent opacity-80 pointer-events-none"></div>
              <span class="absolute bottom-2.5 left-2.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-purple-950/90 backdrop-blur-md text-purple-200 border border-purple-700/50 shadow-md font-mono">
                {albumData.songs.length} Tracks
              </span>
            </div>

            <div class="p-4 flex flex-col flex-grow justify-between space-y-3">
              <div>
                <h3 class="text-lg font-bold text-slate-100 group-hover:text-purple-300 transition-colors line-clamp-1">{albumName}</h3>
                <p class="text-xs text-slate-400 mt-0.5 font-mono">Canonical Release</p>
              </div>
              <div class="flex items-center text-xs font-semibold text-purple-400 group-hover:text-purple-300 transition-colors font-mono">
                View Tracklist <span class="ml-1 transition-transform group-hover:translate-x-1">→</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>
