---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allSongs = await getCollection('songs');
  const artistMap = new Map();

  allSongs.forEach((song) => {
    const artistSlug = song.data.artist ? song.data.artist.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : 'artist';
    if (!artistMap.has(artistSlug)) {
      artistMap.set(artistSlug, {
        params: { artist: artistSlug },
        props: { artistName: song.data.artist || 'Artist' },
      });
    }
  });

  return Array.from(artistMap.values());
}

const { artist } = Astro.params;
const { artistName } = Astro.props;

// Fetch all songs for this artist
const allSongs = await getCollection('songs');
const artistSongs = allSongs.filter((song) => {
  const currentArtistSlug = song.data.artist ? song.data.artist.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') : '';
  return currentArtistSlug === artist;
});

// Helper: normalize album names into stable slugs
const normalizeAlbumSlug = (raw) => {
  if (!raw) return 'album-unknown';
  let s = String(raw).toLowerCase();
  // remove smart quotes/apostrophes
  s = s.replace(/['’]/g, '');
  // strip leading 'album' word
  s = s.replace(/^\s*album\s*/i, '');
  // strip leading numeric prefixes like "3.0", "3", "1.5", optionally followed by : - – —
  s = s.replace(/^\s*\d+(?:\.\d+)?\s*[:\-–—]?\s*/, '');
  // now slugify remainder
  s = s.replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  // prefix for consistency
  return `album-${s}`;
};

// Group songs by album and robustly locate cover images & track counts
const albumMap = new Map();
artistSongs.forEach((song) => {
  const albumName = song.data.album || 'Unknown Album';
  const albumSlug = normalizeAlbumSlug(albumName);

  if (!albumMap.has(albumSlug)) {
    albumMap.set(albumSlug, {
      albumName,
      albumSlug,
      coverImage: null,
      trackCount: 0,
    });
  }

  const albumData = albumMap.get(albumSlug);
  albumData.trackCount++;
  
  // Robust image fallback: grab the first valid coverImage found across the album's songs
  if (song.data.coverImage && !albumData.coverImage) {
    albumData.coverImage = song.data.coverImage;
  }
});

const albums = Array.from(albumMap.values());

// Canonical album ordering: use normalized keys that match normalizeAlbumSlug output
const preferredOrder = [
  'album-wicked',
  'album-corrupted',
  'album-pandoras-box-of-little-horrors',
  'album-sede-vacante',
  'album-the-ravens-light',
  'album-the-ravens-shadow',
  'album-the-spirit-of-the-raven-twins',
  'album-pandora-raven',
];

albums.sort((a, b) => {
  const iA = preferredOrder.indexOf(a.albumSlug);
  const iB = preferredOrder.indexOf(b.albumSlug);

  if (iA === -1 && iB === -1) {
    // Neither album is in the preferred list: fall back to alphabetical by albumName
    return a.albumName.localeCompare(b.albumName);
  }
  if (iA === -1) return 1; // a should come after b
  if (iB === -1) return -1; // b should come after a
  return iA - iB;
});
---

<!DOCTYPE html>
<html lang="en" class="bg-slate-950 text-slate-100 min-h-screen">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{artistName} — Official Discography | The Cosmos</title>
  </head>
  <body class="bg-slate-950 text-slate-100 font-sans antialiased selection:bg-purple-500 selection:text-white">
    
    <!-- Navigation Header -->
    <header class="border-b border-purple-900/30 bg-slate-950/80 backdrop-blur sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="text-2xl font-black tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">
          COSMOS
        </a>
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium tracking-wide text-slate-300">
          <a href="/" class="hover:text-purple-400 transition-colors">HOME</a>
          <a href="/music" class="hover:text-purple-400 transition-colors text-purple-400">MUSIC</a>
        </nav>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 py-12 space-y-12">
      <div class="space-y-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-purple-950/80 text-purple-300 border border-purple-700/40">
          Official Canonical Discography
        </span>
        <h1 class="text-4xl md:text-6xl font-black tracking-tight text-slate-50">
          {artistName}
        </h1>
        <p class="text-slate-400 max-w-xl text-sm leading-relaxed">
          {albums.length} Canonical Releases arranged in timeline sequence. Click any album card to explore official tracklists and lyric archives.
        </p>
      </div>

      <!-- Fully Clickable Album Grid Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {albums.map((album) => (
          <a 
            href={`/music/${artist}/${album.albumSlug}`}
            class="group p-6 rounded-2xl bg-slate-900/60 border border-purple-900/40 backdrop-blur flex flex-col justify-between shadow-2xl hover:border-purple-500/80 hover:bg-slate-900/90 transi[...]"
          >
            <div class="space-y-4">
              {album.coverImage ? (
                <img 
                  src={album.coverImage} 
                  alt={album.albumName} 
                  class="w-full h-72 object-cover rounded-xl shadow-lg border border-purple-500/20 group-hover:scale-[1.02] transition-transform duration-300"
                />
              ) : (
                <div class="w-full h-72 bg-slate-800/80 rounded-xl flex items-center justify-center border border-purple-500/20 text-slate-500 font-mono text-xs">
                  Cover Art Pending
                </div>
              )}
              <div class="space-y-2">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-mono uppercase bg-purple-950 text-purple-300 border border-purple-800/50">
                  {album.trackCount} Tracks
                </span>
                <h3 class="text-xl font-bold text-slate-100 group-hover:text-purple-300 transition-colors">
                  {album.albumName}
                </h3>
                <p class="text-xs text-slate-400">Canonical Release</p>
              </div>
            </div>
            
            <div class="pt-6 mt-6 border-t border-purple-900/30 flex items-center justify-between">
              <span class="text-xs font-mono font-semibold text-purple-400 group-hover:text-pink-400 flex items-center gap-1 transition-colors">
                View Tracklist &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
