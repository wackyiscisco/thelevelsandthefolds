    <div class="w-full max-h-[88vh] overflow-auto rounded-2xl border border-purple-500/40 shadow-2xl flex justify-center bg-black/80 p-2">
      <img id="sheet-modal-img" src="" alt="Character Sheet 4K View" class="max-w-full h-auto object-contain rounded-xl shadow-2xl" />
    </div>
  </div>
</div>
