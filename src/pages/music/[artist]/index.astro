    <button onclick="closeSheetModal()" class="absolute -top-12 right-0 text-white font-mono text-xs font-bold bg-slate-900 hover:bg-slate-800 border border-slate-700 px-4 py-2 rounded-xl transition shadow-xl flex items-center gap-2">
