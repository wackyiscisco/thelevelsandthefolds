---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import cosmosData from '../../../data/cosmos.json';

export async function getStaticPaths() {
  return cosmosData.artists.map((artist) => ({
    params: { artist: artist.id },
    props: { artistData: artist },
  }));
}

const { artist } = Astro.params;
const { artistData } = Astro.props;
const { name: artistName, description, lineup, keyQuote, status, levelFold, spotify, youtube } = artistData;

// Fetch all songs for this artist (matching them to their canonical ID)
const allSongs = await getCollection('songs');

const getArtistSlugFromSong = (artistName: string) => {
  const name = String(artistName || '').toLowerCase().trim();
  if (name.includes('crimson')) return 'crimson-sparks';
  if (name.includes('maya')) return 'maya';
  if (name.includes('guy')) return 'that-guy';
  if (name.includes('pandora')) return 'pandora-raven';
  if (name.includes('elara')) return 'elara-dawn';
  if (name.includes('solara')) return 'solara';
  if (name.includes('prima')) return 'prima-timo';
  if (name.includes('defective')) return 'defective-detective';
  return 'artist';
};

const artistSongs = allSongs.filter((song) => {
  return getArtistSlugFromSong(song.data.artist) === artist;
});

// Helper: normalize album names into stable slugs
const normalizeAlbumSlug = (raw: any) => {
  if (!raw) return 'album-unknown';
  let s = String(raw).toLowerCase();
  s = s.replace(/['’]/g, '');
  s = s.replace(/^\s*album\s*/i, '');
  s = s.replace(/^\s*\d+(?:\.\d+)?\s*[:\-–—]?\s*/, '');
  s = s.replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  return `album-${s}`;
};

// Group songs by album
const albumMap = new Map<string, { albumName: string; albumSlug: string; coverImage: string | null; trackCount: number }>();

artistSongs.forEach((song) => {
  const albumName = song.data.album || 'Unknown Album';
  const albumSlug = normalizeAlbumSlug(albumName);

  if (!albumMap.has(albumSlug)) {
    albumMap.set(albumSlug, {
      albumName,
      albumSlug,
      coverImage: null,
      trackCount: 0,
    });
  }

  const albumData = albumMap.get(albumSlug)!;
  albumData.trackCount++;

  if (song.data.coverImage && !albumData.coverImage) {
    albumData.coverImage = song.data.coverImage;
  }
});

const albums = Array.from(albumMap.values());

// Canonical album ordering list
const preferredOrder = [
  'album-wicked',
  'album-corrupted',
  'album-pandoras-box-of-little-horrors',
  'album-sede-vacante',
  'album-the-ravens-light',
  'album-the-ravens-shadow',
  'album-the-spirit-of-the-raven-twins',
  'album-pandora-raven',
  // Elara Dawn
  'album-mercy',
  // Maya
  'album-preflight',
  // That Guy
  'album-saevit-animo',
  // Prima & Timo
  'album-prima-ver-1-0-unus',
  'album-timo-ver-2-0-centum',
  'album-prima-ver-3-0-duo',
  'album-timo-ver-4-0-nonaginta-novem',
  'album-prima-ver-5-0-tria',
  'album-timo-ver-6-0-nonaginta-octo',
  'album-prima-ver-7-0-quattuor',
  // The Defective Detective
  'album-serah-the-kitsune',
  'album-serah-investigates',
  'album-serah-contemplates',
  'album-serah-learns',
  'album-serah-asks',
];

albums.sort((a, b) => {
  const iA = preferredOrder.indexOf(a.albumSlug);
  const iB = preferredOrder.indexOf(b.albumSlug);
  if (iA === -1 && iB === -1) return a.albumName.localeCompare(b.albumName);
  if (iA === -1) return 1;
  if (iB === -1) return -1;
  return iA - iB;
});

// Dynamic banner background image mapping per artist
const getArtistBannerImage = (artistId: string) => {
  if (artistId === 'pandora-raven') return '/images/artists/pandora-raven-banner.jpg';
  if (artistId === 'defective-detective') return '/images/artists/the_defective_detective_02.jpg';
  return `/images/artists/${artistId}-banner.jpg`;
};

// Dynamic banner background image class alignment per artist
const getArtistBannerImageClass = (artistId: string) => {
  if (artistId === 'pandora-raven') return 'object-cover object-[center_40%] scale-100 opacity-80';
  if (artistId === 'crimson-sparks') return 'object-cover object-center scale-100 opacity-85';
  if (artistId === 'elara-dawn') return 'object-cover object-center scale-100 opacity-80';
  if (artistId === 'maya') return 'object-cover object-[center_35%] scale-100 opacity-80';
  if (artistId === 'that-guy') return 'object-cover object-[center_35%] scale-100 opacity-80';
  if (artistId === 'solara') return 'object-cover object-[center_15%] scale-100 opacity-85';
  if (artistId === 'prima-timo') return 'object-cover object-[center_35%] scale-100 opacity-80';
  if (artistId === 'defective-detective') return 'object-cover object-center scale-100 opacity-85';
  return 'object-cover object-[center_25%] opacity-70';
};

// Dynamic banner backgrounds matching faction themes
const getFactionBanner = (artistId: string) => {
  if (artistId === 'pandora-raven') return 'from-purple-950 via-slate-900 to-indigo-950';
  if (artistId === 'elara-dawn') return 'from-amber-950/60 via-slate-900 to-yellow-950/40';
  if (artistId === 'crimson-sparks') return 'from-rose-950 via-slate-900 to-zinc-900';
  if (artistId === 'maya') return 'from-cyan-950 via-slate-900 to-indigo-950';
  if (artistId === 'that-guy') return 'from-emerald-950 via-slate-900 to-stone-900';
  if (artistId === 'prima-timo') return 'from-teal-950 via-slate-900 to-orange-950/40';
  if (artistId === 'solara') return 'from-purple-950 via-slate-900 to-amber-950/40';
  if (artistId === 'defective-detective') return 'from-cyan-950 via-slate-950 to-blue-950/50';
  return 'from-slate-900 via-slate-900 to-slate-900';
};

// Profile avatar image mapping
const getArtistAvatar = (artistId: string) => {
  if (artistId === 'pandora-raven') return '/images/artists/pandora-box.jpg';
  if (artistId === 'elara-dawn') return '/images/artists/elara-box.jpg';
  if (artistId === 'crimson-sparks') return '/images/artists/the-crimson-sparks.jpg';
  if (artistId === 'prima-timo') return '/images/artists/prime-and-timo.jpg';
  if (artistId === 'solara') return '/images/artists/Solara.jpg';
  if (artistId === 'defective-detective') return '/images/defective-detective/serah.png';
  return `/images/artists/${artistId}.jpg`;
};

// Dynamic styling configuration per artist faction
const getFactionClasses = (artistId: string) => {
  switch (artistId) {
    case 'pandora-raven':
      return {
        activeTab: 'bg-purple-900/60 text-purple-200 border-purple-500 shadow-purple-900/20',
        panelBg: 'bg-purple-950/20 border-purple-900/30',
        accentGlow: 'bg-purple-500/5',
        themeBorder: 'border-purple-900/40',
        textGlow: 'text-purple-300 drop-shadow-[0_0_10px_rgba(168,85,247,0.3)]',
        accentColor: 'purple'
      };
    case 'elara-dawn':
      return {
        activeTab: 'bg-amber-900/60 text-amber-200 border-amber-500 shadow-amber-900/20',
        panelBg: 'bg-amber-950/10 border-amber-900/30',
        accentGlow: 'bg-amber-500/5',
        themeBorder: 'border-amber-900/40',
        textGlow: 'text-amber-300 drop-shadow-[0_0_10px_rgba(245,158,11,0.3)]',
        accentColor: 'amber'
      };
    case 'crimson-sparks':
      return {
        activeTab: 'bg-red-900/60 text-red-200 border-red-500 shadow-red-900/20',
        panelBg: 'bg-slate-900/60 border-slate-800/80',
        accentGlow: 'bg-red-500/5',
        themeBorder: 'border-slate-800',
        textGlow: 'text-red-400',
        accentColor: 'red'
      };
    case 'maya':
      return {
        activeTab: 'bg-cyan-900/60 text-cyan-200 border-cyan-500 shadow-cyan-900/20',
        panelBg: 'bg-slate-900/40 border-cyan-950/30 backdrop-blur-md',
        accentGlow: 'bg-cyan-500/5',
        themeBorder: 'border-cyan-950/40',
        textGlow: 'text-cyan-400 drop-shadow-[0_0_10px_rgba(34,211,238,0.3)]',
        accentColor: 'cyan'
      };
    case 'that-guy':
      return {
        activeTab: 'bg-emerald-950 text-emerald-300 border-emerald-500 shadow-emerald-950/40',
        panelBg: 'bg-slate-950/80 border-emerald-950/40 font-mono',
        accentGlow: 'bg-emerald-500/5',
        themeBorder: 'border-emerald-950/30',
        textGlow: 'text-emerald-400',
        accentColor: 'emerald'
      };
    case 'prima-timo':
      return {
        activeTab: 'bg-teal-900/50 text-teal-200 border-teal-500 shadow-teal-900/20',
        panelBg: 'bg-slate-900/50 border-orange-950/30',
        accentGlow: 'bg-teal-500/5',
        themeBorder: 'border-orange-950/20',
        textGlow: 'text-teal-400',
        accentColor: 'teal'
      };
    case 'solara':
      return {
        activeTab: 'bg-indigo-900/50 text-indigo-200 border-indigo-500 shadow-indigo-900/20',
        panelBg: 'bg-slate-900/40 border-indigo-900/30',
        accentGlow: 'bg-indigo-500/5',
        themeBorder: 'border-indigo-900/30',
        textGlow: 'text-indigo-400 drop-shadow-[0_0_10px_rgba(99,102,241,0.3)]',
        accentColor: 'indigo'
      };
    case 'defective-detective':
      return {
        activeTab: 'bg-cyan-950/80 text-cyan-200 border-cyan-500 shadow-cyan-950/40',
        panelBg: 'bg-slate-950/70 border-cyan-950/50',
        accentGlow: 'bg-cyan-500/5',
        themeBorder: 'border-cyan-950/40',
        textGlow: 'text-cyan-300 drop-shadow-[0_0_10px_rgba(34,211,238,0.3)]',
        accentColor: 'cyan'
      };
    default:
      return {
        activeTab: 'bg-purple-900/60 text-purple-200 border-purple-500 shadow-purple-900/20',
        panelBg: 'bg-slate-900/40 border-slate-800',
        accentGlow: 'bg-purple-500/5',
        themeBorder: 'border-slate-800',
        textGlow: 'text-purple-400',
        accentColor: 'purple'
      };
  }
};

const fx = getFactionClasses(artist);
---

<Layout title={`${artistName} | Official Space`}>
  <main class="w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-10 py-6 sm:py-10">
    
    <!-- Navigation Back Link Bar (Sticky Top Sub-Header Bar) -->
    <div class="sticky top-[80px] z-40 -mx-4 sm:-mx-6 lg:-mx-10 px-4 sm:px-6 lg:px-10 py-3.5 mb-6 bg-black/85 backdrop-blur-xl border-b border-purple-900/40 shadow-2xl flex items-center justify-between transition-all">
      <a href="/artists" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-mono font-extrabold bg-purple-950/95 text-purple-200 border-2 border-purple-500/60 hover:bg-purple-900 hover:text-white transition-all shadow-xl hover:shadow-purple-900/60 hover:scale-105 flex items-center gap-2.5">
        <span class="text-purple-400 font-bold text-sm">&larr;</span>
        <span>Back to Roster</span>
      </a>
      <span class="text-[11px] font-mono text-purple-300/90 uppercase px-3.5 py-1.5 rounded-full bg-purple-950/80 border border-purple-700/50 backdrop-blur-md shadow-md">
        Cosmos Node :: {artist.replace('-', '_').toUpperCase()}
      </span>
    </div>

    <!-- Cinematic Header Banner (Centered & Open) -->
    <div class={`relative w-full rounded-3xl overflow-hidden bg-slate-950 border border-purple-900/30 shadow-2xl h-80 sm:h-96 flex items-center justify-center p-6 md:p-10 mb-8 group text-center`}>
      <!-- Banner Image (pandora_raven_36.jpg placeholder) -->
      <img 
        src={getArtistBannerImage(artist)} 
        alt="" 
        class={`absolute inset-0 w-full h-full ${getArtistBannerImageClass(artist)} group-hover:scale-105 transition-all duration-700 z-0`} 
        onerror="this.style.display='none'"
      />
      <!-- Gradient Overlays for Centered Readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent z-10"></div>
      <div class="absolute inset-0 bg-radial from-transparent via-black/40 to-black/80 z-10"></div>
      
      <!-- Glowing atmospheric orb -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-purple-500/15 rounded-full blur-[100px] pointer-events-none z-0"></div>

      <!-- Centered Artist Info Overlay -->
      <div class="relative z-20 flex flex-col items-center justify-center text-center space-y-4 max-w-2xl mx-auto">
        <!-- Circular Profile Avatar -->
        <img 
          src={getArtistAvatar(artist)} 
          alt={artistName}
          class="w-24 h-24 sm:w-28 sm:h-28 rounded-full border-4 border-purple-500/40 shadow-[0_0_30px_rgba(168,85,247,0.4)] object-cover bg-slate-900 flex-shrink-0"
        />
        <div class="space-y-2">
          <div class="flex flex-wrap items-center justify-center gap-2">
            <span class="px-3 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-purple-950/90 text-purple-300 border border-purple-800/50 font-mono shadow-md">
              {levelFold}
            </span>
            <span class="px-3 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wider bg-slate-900/90 text-slate-300 border border-slate-700/50 font-mono shadow-md">
              {status}
            </span>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black tracking-tight text-white leading-tight font-orbitron drop-shadow-lg">
            {artistName}
          </h1>
        </div>

        <!-- Streaming links in centered header -->
        <div class="flex flex-wrap items-center justify-center gap-3 z-30 pt-1">
          {spotify && (
            <a href={spotify} target="_blank" class="bg-emerald-600/90 hover:bg-emerald-500 text-white text-xs font-bold px-5 py-2.5 rounded-xl transition shadow-lg flex items-center gap-1.5 border border-emerald-500/30 hover:scale-105">
              <span>Spotify</span> &rarr;
            </a>
          )}
          {youtube && (
            <a href={youtube} target="_blank" class="bg-red-600/90 hover:bg-red-500 text-white text-xs font-bold px-5 py-2.5 rounded-xl transition shadow-lg flex items-center gap-1.5 border border-red-500/30 hover:scale-105">
              <span>YouTube</span> &rarr;
            </a>
          )}
        </div>
      </div>
    </div>

    <!-- Dossier Sub-Navigation Tabs -->
    <div class="flex items-center justify-start gap-1 overflow-x-auto scrollbar-none py-1 border-b border-slate-900 mb-8 font-mono text-[11px] uppercase tracking-wider">
      <button 
        data-tab="releases" 
        class={`px-4 py-2 rounded-xl font-bold border border-transparent transition-all shadow-md active-tab ${fx.activeTab}`}
      >
        💽 Releases
      </button>
      <button 
        data-tab="profile" 
        class="px-4 py-2 rounded-xl font-bold border border-transparent text-slate-400 hover:text-slate-200 transition-all"
      >
        📑 Profile Sheet
      </button>
      <button 
        data-tab="history" 
        class="px-4 py-2 rounded-xl font-bold border border-transparent text-slate-400 hover:text-slate-200 transition-all"
      >
        📜 History & Lore
      </button>
      <button 
        data-tab="media" 
        class="px-4 py-2 rounded-xl font-bold border border-transparent text-slate-400 hover:text-slate-200 transition-all"
      >
        🎬 Media & BTS
      </button>
    </div>

    <!-- TAB PANEL: RELEASES (SCATTERED VINYL LP RECORDS) -->
    <div data-panel="releases" class="space-y-12">
      
      <!-- Top Overview Bar & Key Quote -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 bg-slate-950/60 border border-purple-900/30 p-6 sm:p-8 rounded-3xl backdrop-blur-md space-y-3">
          <span class="text-xs font-mono uppercase tracking-widest text-purple-400 font-semibold">Artist Overview</span>
          <p class="text-sm sm:text-base text-slate-200 leading-relaxed font-light">
            {description}
          </p>
        </div>

        <div class="lg:col-span-4 bg-purple-950/20 border-l-4 border-purple-500/80 p-6 rounded-r-3xl italic text-purple-200 font-serif text-base sm:text-lg leading-relaxed shadow-lg">
          "{keyQuote}"
        </div>
      </div>

      <!-- Scattered Vinyl Record Spread (Canonically L-R 1 to N) -->
      <div class="space-y-6 pt-2">
        <div class="flex items-center justify-between border-b border-purple-900/30 pb-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-purple-400 font-semibold">Canonical Discography</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-orbitron tracking-tight mt-1">Official LP Vinyl Releases</h2>
          </div>
          <span class="text-xs font-mono text-purple-300/80 px-3 py-1.5 rounded-full bg-purple-950/60 border border-purple-800/40 shadow-sm">
            {albums.length} Vinyl LPs • Ordered L ➔ R
          </span>
        </div>

        <!-- Scattered Vinyl Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12 py-6 px-2">
          {albums.map((album, idx) => {
            // Organic tilt angles and subtle offsets for realistic scattered vinyl crate feel
            const tilts = [
              'rotate-[-3deg]',
              'rotate-[3deg]',
              'rotate-[-2deg]',
              'rotate-[4deg]',
              'rotate-[-4deg]',
              'rotate-[2deg]',
              'rotate-[-3deg]',
              'rotate-[3deg]'
            ];
            const offsets = [
              'translate-y-0',
              'translate-y-2 sm:translate-y-4',
              'translate-y-1',
              'translate-y-3 sm:translate-y-5',
              'translate-y-0',
              'translate-y-3 sm:translate-y-4',
              'translate-y-1',
              'translate-y-2'
            ];
            const currentTilt = tilts[idx % tilts.length];
            const currentOffset = offsets[idx % offsets.length];

            return (
              <a
                href={`/music/${artist}/${album.albumSlug}`}
                class={`group relative flex flex-col items-center text-center transition-transform duration-300 hover:z-40 cursor-pointer ${currentTilt} ${currentOffset}`}
              >
                <!-- Realistic Black LP Vinyl Disc sliding out from behind the sleeve -->
                <div class="w-48 h-48 sm:w-56 sm:h-56 rounded-full bg-gradient-to-tr from-neutral-950 via-zinc-900 to-black border-4 border-zinc-800/80 shadow-2xl relative flex items-center justify-center -mb-28 group-hover:-translate-y-10 transition-transform duration-500 pointer-events-none z-0 overflow-hidden">
                  
                  <!-- Vinyl Grooves Lines -->
                  <div class="absolute inset-2 rounded-full border border-zinc-800/60 pointer-events-none"></div>
                  <div class="absolute inset-5 rounded-full border border-zinc-800/40 pointer-events-none"></div>
                  <div class="absolute inset-9 rounded-full border border-zinc-800/40 pointer-events-none"></div>
                  <div class="absolute inset-14 rounded-full border border-zinc-800/40 pointer-events-none"></div>
                  <div class="absolute inset-20 rounded-full border border-zinc-800/30 pointer-events-none"></div>
                  
                  <!-- Vinyl Center Label Artwork -->
                  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-amber-500/60 relative flex items-center justify-center shadow-lg bg-black">
                    {album.coverImage ? (
                      <img src={album.coverImage} alt="" class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full bg-purple-950 flex items-center justify-center text-[10px] font-mono text-purple-300">LP</div>
                    )}
                    <!-- Center Spindle Hole -->
                    <div class="w-3.5 h-3.5 rounded-full bg-slate-950 border border-slate-700 absolute inset-auto z-10 shadow-inner"></div>
                  </div>
                </div>

                <!-- Vinyl Jacket Cover Sleeve -->
                <div class="w-full max-w-[270px] aspect-square rounded-2xl overflow-hidden bg-slate-950 border border-purple-500/30 shadow-2xl group-hover:shadow-[0_0_40px_rgba(168,85,247,0.45)] group-hover:border-purple-400/90 group-hover:scale-[1.03] transition-all duration-300 relative z-10">
                  
                  <!-- Album Cover Image -->
                  {album.coverImage ? (
                    <img
                      src={album.coverImage}
                      alt={album.albumName}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full bg-slate-900/90 flex items-center justify-center text-slate-500 font-mono text-xs">
                      Cover Pending
                    </div>
                  )}

                  <!-- Glossy Vinyl Sheen Gradient Overlay -->
                  <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/10 to-transparent pointer-events-none opacity-40 group-hover:opacity-80 transition-opacity"></div>

                  <!-- Album Number & Track Count Badge -->
                  <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
                    <span class="px-2.5 py-1 rounded-full text-[10px] font-mono font-bold bg-slate-950/85 text-purple-200 border border-purple-500/40 backdrop-blur-md shadow-md">
                      {album.albumName.startsWith('Album') ? album.albumName.split(':')[0] : (album.albumName.startsWith('(') ? album.albumName.split(')')[0] + ')' : `LP ${idx + 1}`)}
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-[9px] font-mono bg-purple-950/90 text-purple-300 border border-purple-800/40 backdrop-blur-md">
                      {album.trackCount} Tracks
                    </span>
                  </div>

                  <!-- Bottom Title & Hover Prompt -->
                  <div class="absolute inset-x-0 bottom-0 p-3.5 bg-gradient-to-t from-black via-black/85 to-transparent flex flex-col justify-end text-left">
                    <h3 class="text-sm font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-1">
                      {album.albumName}
                    </h3>
                    <span class="text-[10px] font-mono text-purple-400 group-hover:text-pink-300 transition-colors flex items-center gap-1 mt-0.5">
                      <span>Open Album & Tracklist</span>
                      <span class="group-hover:translate-x-1 transition-transform">→</span>
                    </span>
                  </div>
                </div>

              </a>
            );
          })}
        </div>
      </div>
    </div>

    <!-- TAB PANEL: PROFILE SHEET (CHARACTER DOSSIER) -->
    <div data-panel="profile" class="hidden">
      
      <!-- PANDORA RAVEN: Official Master Character Sheet & Grimoire -->
      {artist === 'pandora-raven' && (
        <div class="space-y-12">
          
          <!-- Master Character Sheet Poster (Unconstrained Full Page View) -->
          <div class="space-y-4">
            
            <!-- Clean Floating Control Header -->
