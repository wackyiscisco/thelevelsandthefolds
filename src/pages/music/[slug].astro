---
// src/pages/music/[slug].astro
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const songs = await getCollection('songs');
  return songs.map(song => ({
    params: { slug: song.slug },
    props: { song },
  }));
}

const { song } = Astro.props;
const { Content } = await song.render();
const lyricsAvailable = !String(song.body || '').includes('Full lyrics are not yet available.');

const artistSlug = (() => {
  const name = String(song.data.artist || '').toLowerCase().trim();
  if (name.includes('crimson')) return 'crimson-sparks';
  if (name.includes('maya')) return 'maya';
  if (name.includes('guy')) return 'that-guy';
  if (name.includes('pandora')) return 'pandora-raven';
  if (name.includes('elara')) return 'elara-dawn';
  if (name.includes('solara')) return 'solara';
  if (name.includes('prima')) return 'prima-timo';
  if (name.includes('defective')) return 'defective-detective';
  return 'artist';
})();
---

<Layout title={`${song.data.title} | ${song.data.artist}${lyricsAvailable ? ' Lyrics' : ''}`}>
  <main class="max-w-4xl mx-auto px-6 py-10">
    <!-- Navigation Back Link Bar (Sticky Top Sub-Header Bar) -->
    <div class="sticky top-[80px] z-40 -mx-6 px-6 py-3.5 mb-8 bg-black/85 backdrop-blur-xl border-b border-purple-900/40 shadow-2xl flex items-center justify-between flex-wrap gap-4 font-mono text-xs">
      <a href={`/music/${artistSlug}`} class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-mono font-extrabold bg-purple-950/95 text-purple-200 border-2 border-purple-500/60 hover:bg-purple-900 hover:text-white transition-all shadow-xl hover:shadow-purple-900/60 hover:scale-105 flex items-center gap-2.5">
        <span class="text-purple-400 font-bold text-sm">&larr;</span>
        <span>Back to {song.data.artist} Discography</span>
      </a>
      <a href="/music" class="px-4 py-2 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-slate-900/90 text-slate-300 border border-slate-700/50 hover:bg-slate-800 hover:text-white transition-all flex items-center gap-2 shadow-lg">
        <span>All Releases</span>
        <span class="text-slate-400 font-bold text-sm">&rarr;</span>
      </a>
    </div>

    <!-- Header Card -->
    <div class="bg-slate-900/60 p-8 rounded-2xl border border-slate-800/80 shadow-2xl mb-10 backdrop-blur-sm flex flex-col md:flex-row gap-6 items-center">
      {song.data.coverImage && (
        <img src={song.data.coverImage} alt={song.data.title} class="w-32 h-32 rounded-xl object-cover shadow-lg border border-slate-700/50 flex-shrink-0" />
      )}
      <div class="space-y-2 text-center md:text-left">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50 font-mono">
          {song.data.artist} — {song.data.album}
        </span>
        <h1 class="text-3xl md:text-5xl font-black text-white">{song.data.title}</h1>
        {song.data.quote && <p class="text-slate-400 text-sm italic">"{song.data.quote}"</p>}
      </div>
    </div>

    <!-- Lyrics Content Box (Preserves Line Breaks and Formatting) -->
    <article class="prose prose-invert max-w-none bg-slate-900/40 p-8 rounded-2xl border border-slate-800/60 shadow-xl whitespace-pre-line text-slate-200 leading-relaxed font-sans">
      <Content />
    </article>

    <!-- Bottom Navigation Actions -->
    <div class="mt-10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-purple-900/40">
      <a href={`/music/${artistSlug}`} class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-purple-950/90 text-purple-200 border border-purple-500/50 hover:bg-purple-900 hover:text-white transition-all flex items-center justify-center gap-2 shadow-xl hover:shadow-purple-900/50 hover:-translate-x-1">
        <span class="text-purple-400 font-bold text-sm">&larr;</span>
        <span>Back to {song.data.artist} Discography</span>
      </a>
      <a href="/artists" class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-slate-900/90 text-slate-300 border border-slate-700/50 hover:bg-slate-800 hover:text-white transition-all flex items-center justify-center gap-2 shadow-xl">
        <span>Back to Roster</span>
        <span class="text-slate-400 font-bold text-sm">&rarr;</span>
      </a>
    </div>

  </main>
</Layout>
