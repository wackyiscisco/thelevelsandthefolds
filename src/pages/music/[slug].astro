---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import cosmosData from '../../data/cosmos.json';

export async function getStaticPaths() {
  const songEntries = await getCollection('songs');
  return songEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { siteConfig } = cosmosData;
---

<Layout title={`${entry.data.title} — ${entry.data.artist}`}>
  <article class="max-w-4xl mx-auto px-6 py-16">
    <!-- Breadcrumb Header -->
    <div class="mb-8 flex items-center justify-between">
      <a href="/artists" class="text-xs font-mono text-slate-400 hover:text-purple-400 transition">&larr; Back to Roster</a>
      <span class="text-xs font-mono text-purple-400 bg-purple-950 px-3 py-1 rounded-full border border-purple-800/60">
        {entry.data.levelFold}
      </span>
    </div>

    <!-- Song Metadata Hero -->
    <header class="bg-slate-900 border border-slate-800 p-8 rounded-2xl mb-12 relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-48 h-48 bg-purple-600/10 rounded-full blur-3xl"></div>

      <span class="text-xs font-mono text-amber-400 uppercase tracking-widest font-bold">
        {entry.data.album}
      </span>

      <h1 class="text-4xl md:text-5xl font-black text-white mt-2 mb-3">
        {entry.data.title}
      </h1>

      <p class="text-base text-slate-300 font-semibold mb-6">
        By <span class="text-purple-400">{entry.data.artist}</span>
      </p>

      {entry.data.quote && (
        <blockquote class="italic text-sm text-slate-400 border-l-2 border-purple-500 pl-4 mb-6">
          "{entry.data.quote}"
        </blockquote>
      )}

      <!-- Audio / Streaming Action Row -->
      <div class="flex flex-wrap gap-4 pt-4 border-t border-slate-800/80">
        {entry.data.spotifyUrl && (
          <a href={entry.data.spotifyUrl} target="_blank" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-5 py-2.5 rounded-full transition shadow flex items-center gap-2">
            <span>Listen on Spotify</span> &rarr;
          </a>
        )}
        {entry.data.youtubeUrl && (
          <a href={entry.data.youtubeUrl} target="_blank" class="bg-red-600 hover:bg-red-500 text-white font-bold text-xs px-5 py-2.5 rounded-full transition shadow flex items-center gap-2">
            <span>Watch on YouTube</span> &rarr;
          </a>
        )}
        <a href={siteConfig.patreonUrl} target="_blank" class="bg-purple-900/60 hover:bg-purple-800 border border-purple-700 text-purple-200 font-bold text-xs px-5 py-2.5 rounded-full transition">
          Unlock Story Bibles on Patreon
        </a>
      </div>
    </header>

    <!-- Markdown Lyrics Body -->
    <div class="prose prose-invert prose-purple max-w-none bg-slate-950/40 p-8 rounded-2xl border border-slate-900 leading-relaxed font-sans text-slate-300">
      <Content />
    </div>
  </article>
</Layout>
