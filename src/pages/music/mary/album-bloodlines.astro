---
import Layout from '../../../layouts/Layout.astro';

const tracks = [
  { number: 1, title: 'Welcome to Ridgefall', slug: 'mary-01-welcome-to-ridgefall', quote: 'Welcome to Ridgefall' },
  { number: 2, title: 'Where Wolves Wait', slug: 'mary-02-where-wolves-wait', quote: 'Where Wolves Wait' },
  { number: 3, title: 'Which is Witch', slug: 'mary-03-which-is-witch', quote: 'Which is witch?' },
  { number: 4, title: 'Wendy I Go', slug: 'mary-04-wendy-i-go', quote: 'Show me proof, show me data' },
  { number: 5, title: 'Wraith or Wrong', slug: 'mary-05-wraith-or-wrong', quote: 'Wraith or wrong, here we go again' },
  { number: 6, title: 'Wild Child', slug: 'mary-06-wild-child', quote: "I'm a WILD CHILD" },
  { number: 7, title: 'Were Bears Here Tonight', slug: 'mary-07-were-bears-here-tonight', quote: "I make the best of what I've got" },
  { number: 8, title: 'Wight Noise', slug: 'mary-08-wight-noise', quote: "It's just WIGHT NOISE" },
  { number: 9, title: 'Wish You Were Hair', slug: 'mary-09-wish-you-were-hair', quote: 'Wish you were here? No.' },
  { number: 10, title: 'Whoof', slug: 'mary-10-whoof', quote: 'Whoof—what are you?' },
  { number: 11, title: 'When Wendy Met Mary', slug: 'mary-11-when-wendy-met-mary', quote: 'Funny how a night can change' },
  { number: 12, title: 'Who Are You', slug: 'mary-12-who-are-you', quote: 'Who are you? What happened here?' },
];
---

<Layout title="Bloodlines | Mary">
  <main class="bloodlines-album max-w-5xl mx-auto px-6 py-10 space-y-8">
    <div class="sticky top-[80px] z-40 -mx-6 px-6 py-3.5 mb-6 bg-black/85 backdrop-blur-xl border-b border-rose-900/40 shadow-2xl flex items-center justify-between">
      <a href="/music/mary" class="px-5 py-2.5 rounded-xl text-xs uppercase tracking-wider font-mono font-extrabold bg-rose-950/95 text-rose-100 border-2 border-rose-500/60 hover:bg-rose-900 transition-all shadow-xl flex items-center gap-2.5"><span>&larr;</span><span>Back to Mary</span></a>
      <span class="hidden sm:inline-block text-[11px] font-mono text-amber-100/90 uppercase px-3.5 py-1.5 rounded-full bg-stone-950/75 border border-amber-800/50">Canonical LP · Album 1</span>
    </div>

    <section class="p-8 md:p-10 rounded-2xl bg-slate-900/60 border border-rose-900/40 flex flex-col md:flex-row gap-8 items-center md:items-start shadow-2xl">
      <img src="/images/mary/bloodlines_mary_album_cover_01.webp" alt="Bloodlines - Album 1 by Mary" class="w-64 h-64 md:w-72 md:h-72 object-cover rounded-xl shadow-2xl border border-rose-500/30" />
      <div class="space-y-4 text-center md:text-left flex-1">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-rose-950/80 text-rose-100 border border-rose-700/40">Mary · Album 1</span>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-50 font-serif">Bloodlines</h1>
        <p class="text-sm text-slate-300 leading-relaxed max-w-2xl">Twelve locked songs follow eighteen-year-old Mary from an ordinary Ridgefall routine into a growing circle of questions. What she sees, reads, and believes remains her perspective until the story itself proves more.</p>
        <div class="flex flex-wrap justify-center md:justify-start gap-2 text-[10px] font-mono uppercase tracking-wider"><span class="px-3 py-1 rounded-full bg-rose-950/70 text-rose-100 border border-rose-800/40">6_66</span><span class="px-3 py-1 rounded-full bg-stone-950/80 text-amber-100 border border-amber-900/50">12 Locked Tracks</span></div>
      </div>
    </section>

    <section class="space-y-4">
      <div><span class="text-xs font-mono uppercase tracking-widest text-rose-300 font-semibold">Album 1</span><h2 class="text-2xl font-bold tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-rose-300 to-amber-200">Official Tracklist</h2></div>
      <ol class="space-y-3">
        {tracks.map((track) => (
          <li>
            <a href={`/music/${track.slug}`} class="block p-4 md:p-5 rounded-xl bg-slate-900/45 hover:bg-slate-900/80 border border-rose-900/30 hover:border-rose-600/55 transition-all shadow-md">
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-4 md:gap-6 min-w-0"><span class="text-lg md:text-xl font-mono font-bold text-rose-300">{String(track.number).padStart(2, '0')}</span><div class="min-w-0"><h3 class="text-base md:text-lg font-semibold text-slate-100">{track.title}</h3><p class="text-xs font-mono text-slate-500 mt-0.5">Mary · 6_66</p><p class="text-xs md:text-sm italic text-slate-400 mt-1">&ldquo;{track.quote}&rdquo;</p></div></div>
                <span class="hidden sm:inline text-[10px] font-mono uppercase tracking-wider text-rose-200/65 shrink-0">Read Lyrics &rarr;</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="pt-8 pb-4 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-rose-900/40"><a href="/music/mary" class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-rose-950/90 text-rose-100 border border-rose-500/50 hover:bg-rose-900 transition-all flex items-center justify-center gap-2 shadow-xl"><span>&larr;</span><span>Back to Discography</span></a><a href="/music" class="w-full sm:w-auto px-6 py-3.5 rounded-xl text-xs uppercase tracking-wider font-mono font-bold bg-slate-900/90 text-slate-300 border border-slate-700/50 hover:bg-slate-800 transition-all flex items-center justify-center gap-2 shadow-xl"><span>All Cosmos Releases</span><span>&rarr;</span></a></div>
  </main>
</Layout>

<style>
  :global(body) { background-color: #050816 !important; }
  .bloodlines-album { position: relative; z-index: 1; }
  .bloodlines-album::before { content: ''; position: fixed; inset: 0; z-index: -1; pointer-events: none; background: radial-gradient(circle at 18% 18%, rgba(136,19,55,.18), transparent 32rem), radial-gradient(circle at 82% 22%, rgba(137,98,43,.12), transparent 34rem); }
</style>
