---
import Layout from '../layouts/Layout.astro';
import cosmosData from '../data/cosmos.json';

const { siteConfig, patreonTiers } = cosmosData;
---

<Layout title="Patreon Vault — WackycsicO Records">
  <!-- Hero Section -->
  <section class="relative py-20 px-6 max-w-5xl mx-auto text-center overflow-hidden">
    <div class="absolute inset-0 -z-10 flex items-center justify-center">
      <div class="w-[500px] h-[500px] bg-purple-600/15 rounded-full blur-3xl"></div>
      <div class="w-[300px] h-[300px] bg-amber-500/15 rounded-full blur-3xl"></div>
    </div>

    <span class="text-xs uppercase tracking-widest font-bold text-amber-400 bg-amber-950/60 border border-amber-800/50 px-3 py-1 rounded-full">
      WackycsicO Records Inner Circle
    </span>

    <h1 class="mt-6 text-4xl md:text-6xl font-black tracking-tight leading-tight">
      Unlock the <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300 bg-clip-text text-transparent">Cosmos Vault</span>
    </h1>

    <p class="mt-4 text-slate-300 text-sm md:text-base max-w-2xl mx-auto leading-relaxed font-light">
      620+ songs, 17 twin albums, novelizations, and eons of lore. Step inside the official community vault to support independent creation and get exclusive early access.
    </p>
  </section>

  <!-- Patreon Tiers Grid -->
  <section class="max-w-5xl mx-auto px-6 pb-20">
    <div class="grid md:grid-cols-2 gap-8">
      {patreonTiers.map((tier) => (
        <div class={`relative p-8 rounded-2xl flex flex-col justify-between transition ${
          tier.highlighted 
            ? 'bg-gradient-to-b from-slate-900 to-purple-950/50 border-2 border-purple-500 shadow-2xl shadow-purple-950/60' 
            : 'bg-slate-900 border border-slate-800'
        }`}>
          {tier.highlighted && (
            <span class="absolute -top-3 right-6 bg-purple-500 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full shadow">
              Highlighted Tier
            </span>
          )}

          <div>
            <h2 class="text-2xl font-bold text-white">{tier.name}</h2>
            <div class="mt-3 flex items-baseline space-x-2">
              <span class="text-4xl font-black text-amber-400">{tier.price}</span>
              <span class="text-xs text-slate-400 font-mono">({tier.trial})</span>
            </div>
            <p class="text-sm text-purple-300 italic mt-3">{tier.tagline}</p>

            <div class="mt-6 pt-6 border-t border-slate-800">
              <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">What You Unlock:</h3>
              <ul class="space-y-3 text-sm text-slate-300">
                {tier.perks.map((perk) => (
                  <li class="flex items-start space-x-3">
                    <span class="text-purple-400 font-bold shrink-0">&check;</span>
                    <span class="leading-tight">{perk}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a 
            href={siteConfig.patreonUrl} 
            target="_blank" 
            class={`mt-8 block text-center py-3.5 rounded-xl font-bold text-sm transition shadow-lg hover:scale-105 ${
              tier.highlighted 
                ? 'bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white' 
                : 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700'
            }`}
          >
            Claim {tier.name} (7-Day Free Trial) &rarr;
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Creator Note / Rights Disclaimer -->
  <section class="max-w-4xl mx-auto px-6 pb-24">
    <div class="bg-slate-900/60 border border-slate-800/80 p-6 rounded-xl text-center">
      <p class="text-xs text-slate-400 italic font-mono leading-relaxed">
        "Songs generated using Suno AI. Lyrics written by me (Wacky / Francisco de Leon). All rights reserved."
      </p>
    </div>
  </section>
</Layout>
