---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('wiki'))
  .sort((a, b) => {
    const at = a.data.title || a.slug;
    const bt = b.data.title || b.slug;
    return at.localeCompare(bt);
  });

const groups = new Map();
for (const entry of entries) {
  const first = entry.slug.split('/')[0] || 'root';
  if (!groups.has(first)) groups.set(first, []);
  groups.get(first).push(entry);
}
---

<Layout title="Cosmos Wiki">
  <main class="relative z-10 max-w-[1500px] mx-auto px-5 md:px-8 py-10 md:py-14">
    <header class="mb-10 border-b border-slate-800 pb-8">
      <p class="font-mono text-xs uppercase tracking-[0.28em] text-amber-400">Creator Reference Wiki</p>
      <h1 class="mt-3 text-4xl md:text-6xl font-black tracking-tight text-slate-100">The Cosmos of Wacky</h1>
      <p class="mt-4 max-w-4xl text-slate-400 leading-7">
        A continuously generated reference from the Obsidian <strong class="text-slate-200">THE COSMOS</strong> knowledge tree.
        THE INNER COSMOS is excluded from this mirror.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/wiki/search" class="rounded-full border border-cyan-700/60 bg-cyan-950/40 px-4 py-2 text-sm text-cyan-200 hover:border-cyan-400 transition">Search the Wiki</a>
        <a href="/llms.txt" class="rounded-full border border-purple-700/60 bg-purple-950/40 px-4 py-2 text-sm text-purple-200 hover:border-purple-400 transition">AI / LLM Index</a>
        <a href="/wiki/index.json" class="rounded-full border border-amber-700/60 bg-amber-950/30 px-4 py-2 text-sm text-amber-200 hover:border-amber-400 transition">Machine-readable Index</a>
      </div>
    </header>

    {entries.length === 0 ? (
      <section class="rounded-2xl border border-slate-800 bg-slate-950/70 p-8">
        <h2 class="text-2xl font-bold">Wiki engine ready</h2>
        <p class="mt-3 text-slate-400">No Obsidian notes have been synced into this branch yet. Run <code class="text-amber-300">npm run wiki:sync</code> on the Cosmos workstation.</p>
      </section>
    ) : (
      <div class="space-y-10">
        {[...groups.entries()].map(([group, items]) => (
          <section>
            <div class="mb-4 flex items-center justify-between gap-4">
              <h2 class="font-orbitron text-xl md:text-2xl font-bold text-slate-100">{decodeURIComponent(group.replaceAll('-', ' '))}</h2>
              <span class="font-mono text-xs text-slate-500">{items.length} notes</span>
            </div>
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              {items.map((entry) => (
                <a href={`/wiki/${entry.slug}`} class="group rounded-xl border border-slate-800 bg-slate-950/70 p-4 hover:border-purple-600/70 hover:bg-purple-950/15 transition">
                  <strong class="block text-slate-200 group-hover:text-purple-200 transition">{entry.data.title || entry.slug.split('/').at(-1)}</strong>
                  <span class="mt-2 block truncate font-mono text-[11px] text-slate-500">{entry.data.sourcePath || entry.slug}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </main>
</Layout>
