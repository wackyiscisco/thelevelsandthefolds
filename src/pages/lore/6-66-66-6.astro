---
import Layout from '../../layouts/Layout.astro';

const ridgefall = [
  ['North Ridge', 'Affluent and restricted'],
  ['Central Ridgefall', 'University, commerce, and the bus station'],
  ['South Ridge', 'Poor and industrial'],
  ['West Ridge / West Docks', 'Forest, port, and logistics'],
];

const maryCast = [
  { name: 'Mary', role: 'Scholar · Library worker', image: '/images/mary/cast/mary_photo_01.png' },
  { name: 'Hansel', role: 'Scholar · Answers withheld', image: '/images/mary/cast/hansel_photo_01.png' },
  { name: 'Wendy', role: 'Mathematics · Tailoring', image: '/images/mary/cast/wendy_photo_01.png' },
  { name: 'Linda', role: 'Lore author · Researcher', image: '/images/mary/cast/linda_photo_01.png' },
  { name: 'Karina', role: 'Punk busker · Believer', image: '/images/mary/cast/karina_photo_01.png' },
  { name: 'Greg', role: 'Dock porter · Boatbuilder', image: '/images/mary/cast/greg_photo_01.png' },
];

const tridecagon = [
  ['Amdis', 'amdis'],
  ['Ambrosia', 'ambrosia'],
  ['Godfrey', 'godfrey'],
  ['Vlad', 'vlad'],
  ['Sapphira', 'sapphira'],
  ['Zeck', 'zeck'],
  ['Jezebel', 'jezebel'],
  ['Umbra', 'umbra'],
  ['Horasio', 'horasio'],
  ['Asura', 'asura'],
  ['Katherine', 'katherine'],
  ['Melchor', 'melchor'],
  ['Luchinda', 'luchinda'],
].map(([name, slug]) => ({
  name,
  image: `/images/count-wrongula/tridecagon/${slug}_photo_01.png`,
}));
const wrongulaPlaces = ["Wrongula's Castle", 'The Forest Detour', 'Coyoling Village'];
const wQuestions = ['WHO', 'WHAT', 'WHY', 'WHERE', 'WHEN'];
---

<Layout title="6_66 / 66_6 — Overlapping Pages">
  <section class="threshold-shell">
    <div class="threshold-heading">
      <p class="eyebrow">THE CROSSING ARCHIVE</p>
      <h1><span>6_66</span><i aria-hidden="true">/</i><span>66_6</span></h1>
      <p>Two realities touch at the edge of a page. Move across it to reveal <strong>6_66</strong> or <strong>66_6</strong>.</p>
    </div>

    <div
      class="overlap-book"
      data-overlap-book
      style="--reveal: 50%;"
      tabindex="0"
      role="slider"
      aria-label="Reveal the overlapping pages of 6_66 and 66_6"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-valuetext="Both pages overlap evenly"
    >
      <article class="page page-left" aria-label="Mary and Level 6 Fold 66">
        <div class="page-grain"></div>
        <div class="page-content">
          <span class="coordinate">6_66</span>
          <p class="page-number">PAGE I · THE BLOODLINES RECORD</p>
          <div class="ornament" aria-hidden="true">✦</div>
          <h2>Mary</h2>
          <p class="placeholder-copy">Ridgefall begins as scholarship, folklore, and questions. Then the evidence stops behaving like a story.</p>
          <a class="page-entry" href="#mary-record">Enter Mary’s record ↓</a>
        </div>
      </article>

      <article class="page page-right" aria-label="Count Wrongula and Level 66 Fold 6">
        <div class="page-grain"></div>
        <div class="page-content">
          <span class="coordinate">66_6</span>
          <p class="page-number">PAGE II · THE WHO RECORD</p>
          <div class="ornament" aria-hidden="true">◇</div>
          <h2>Count Wrongula</h2>
          <p class="placeholder-copy">A supernatural world is losing its crossings while its most irritating Count walks toward an unanswered summons.</p>
          <a class="page-entry" href="#wrongula-record">Enter Wrongula’s record ↓</a>
        </div>
      </article>

      <div class="reveal-edge" aria-hidden="true"><span></span></div>
      <div class="book-hint" aria-hidden="true">
        <b>6_66</b><span>MOVE · CLICK · USE ARROW KEYS</span><b>66_6</b>
      </div>
    </div>

    <div class="page-choices" aria-label="Choose which page to reveal">
      <button type="button" data-reveal="88">PAGE I · REVEAL 6_66</button>
      <span aria-hidden="true">✦</span>
      <button type="button" data-reveal="12">PAGE II · REVEAL 66_6</button>
    </div>
    <p class="status-note">Two distinct worlds · one controlled crossing</p>
  </section>

  <section class="boundary-law" id="boundary">
    <p class="section-number">THE LAW BETWEEN PAGES</p>
    <h2>Connected does not mean combined.</h2>
    <div class="law-grid">
      <article><b>TIME</b><p>Age, memory, sequence, knowledge, and consequence matter. The coordinates are not a simple past-and-future ladder.</p></article>
      <article><b>CROSSING</b><p>People, evidence, objects, histories, and questions may intersect without merging each world’s native rules.</p></article>
      <article><b>THE THRESHOLD</b><p>MARY leads narratively toward the WHO-era story. Cosmologically, 6_66 and 66_6 remain distinct realities.</p></article>
    </div>
  </section>

  <article class="lore-record mary-record" id="mary-record">
    <header class="record-hero">
      <div class="record-portrait"><img src="/images/mary/mary_artist_01.png" alt="Mary beneath the Ridgefall night sky" /></div>
      <div class="record-title">
        <p class="section-number">PAGE I · LEVEL 6, FOLD 66</p>
        <h2>Mary</h2>
        <p>A scholar enters the mystery carrying books, stubbornness, and the conviction that every monster can still be explained.</p>
        <div class="record-stamps"><span>AGE 18</span><span>BLOODLINES · 12/12</span><span>RIDGEFALL</span></div>
      </div>
    </header>
    <div class="record-body">
      <section class="opening-leaf">
        <p>Mary begins <em>Bloodlines</em> as an eighteen-year-old scholarship student, Ridgefall City Library worker, orphan, and dedicated monster-and-folklore nerd. The supernatural is still scholarship to her—until physical evidence appears that she cannot classify.</p>
        <blockquote>Folklore is testimony here, not automatic proof. Belief, skepticism, scholarship, and rumor remain knowledge states until the story earns an answer.</blockquote>
      </section>
      <section class="archive-panel">
        <div class="panel-heading"><div><p class="section-number">THE CITY</p><h3>Ridgefall</h3></div><span>6_66</span></div>
        <div class="ridge-grid">{ridgefall.map(([name, role], index) => <article><b>{String(index + 1).padStart(2, '0')}</b><h4>{name}</h4><p>{role}</p></article>)}</div>
        <div class="library-note"><span>CONVERGENCE POINT</span><strong>Ridgefall City Library</strong><p>The place where the album’s people, evidence, and unanswered histories begin arriving at the same door.</p></div>
      </section>
      <section class="archive-panel">
        <div class="panel-heading"><div><p class="section-number">THE BLOODLINES SIX</p><h3>Current Cast</h3></div><span>VISUALS LOCKED</span></div>
        <div class="portrait-roster bloodlines-roster">
          {maryCast.map((person, index) => (
            <article class="portrait-card">
              <div class="portrait-frame"><img src={person.image} alt={`${person.name} of the Bloodlines Six`} loading="lazy" /></div>
              <div class="portrait-caption"><span>{String(index + 1).padStart(2, '0')}</span><div><h4>{person.name}</h4><p>{person.role}</p></div></div>
            </article>
          ))}
        </div>
      </section>
      <section class="open-ledger">
        <div><p class="section-number">UNRESOLVED RECORD</p><h3>The questions still alive</h3><p>Active mysteries—not conclusions waiting to be spoiled.</p></div>
        <ul><li>Mary’s bloodline and parents</li><li>Hansel, Delona, and his father</li><li>The Ridgefall library anomaly</li><li>Where Wolves Wait</li><li>Linda and <em>The Wraith Way</em></li><li>The mechanics of TIME and CROSSING</li></ul>
      </section>
    </div>
  </article>

  <div class="crossing-mark" aria-hidden="true"><span>6_66</span><i></i><b>THE PAGE BLEEDS</b><i></i><span>66_6</span></div>

  <article class="lore-record wrongula-record" id="wrongula-record">
    <header class="record-hero">
      <div class="record-portrait"><img src="/images/count-wrongula/wrongula_01.png" alt="Count Wrongula in his candlelit castle" /></div>
      <div class="record-title">
        <p class="section-number">PAGE II · LEVEL 66, FOLD 6</p>
        <h2>Count<br/>Wrongula</h2>
        <p>Smug, elegant, theatrical—and moving through a supernatural reality whose crossings have begun to fail.</p>
        <div class="record-stamps"><span>WHO · 12/12</span><span>SUPERNATURAL NATIVE</span><span>CROSSING CRISIS</span></div>
      </div>
    </header>
    <div class="record-body">
      <section class="opening-leaf">
        <p>No humans naturally exist in 66_6. For roughly three months before the end of <em>WHO</em>, crossing restrictions tighten and species-specific food becomes scarce and expensive. Wrongula has never crossed planes, while his ordinary-food household remains an unexplained anomaly.</p>
        <blockquote>He casts a reflection, walks in sunlight, drinks no blood, and prefers ordinary prepared food, coffee, and tea. The reason he differs from vampire norms remains open.</blockquote>
      </section>
      <section class="archive-panel">
        <div class="panel-heading"><div><p class="section-number">THE PRESSURE MAP</p><h3>66_6</h3></div><span>ACTIVE CANON</span></div>
        <div class="pressure-grid"><article><span>01</span><h4>Crossings</h4><p>Movement between planes exists, but it is uneven, poorly understood, and currently failing.</p></article><article><span>02</span><h4>The Tridecagon</h4><p>An old thirteen-member power waits at the end of a summons Wrongula is moving toward.</p></article><article><span>03</span><h4>The Veilguards</h4><p>A protective order with confirmed relevance on both sides of the crossing bleed.</p></article></div>
      </section>
      <section class="archive-panel council-panel">
        <div class="panel-heading"><div><p class="section-number">THIRTEEN LOCKED SEATS</p><h3>The Tridecagon of Old</h3></div><span>VISUALS LOCKED</span></div>
        <div class="portrait-roster council-roster">
          {tridecagon.map((person, index) => (
            <article class="portrait-card">
              <div class="portrait-frame"><img src={person.image} alt={`${person.name} of the Tridecagon of Old`} loading="lazy" /></div>
              <div class="portrait-caption"><span>{String(index + 1).padStart(2, '0')}</span><div><p>TRIDECAGON SEAT</p><h4>{person.name}</h4></div></div>
            </article>
          ))}
        </div>
      </section>
      <section class="archive-panel">
        <div class="panel-heading"><div><p class="section-number">KNOWN LOCATIONS</p><h3>The road so far</h3></div><span>MAP IN PROGRESS</span></div>
        <div class="place-list">{wrongulaPlaces.map((place, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h4>{place}</h4><i aria-hidden="true">→</i></article>)}</div>
      </section>
      <section class="w-system"><p class="section-number">THE PRESERVED QUESTION</p><h3>WTF is Wrongula?</h3><p>Every answer must be earned. No shortcut gets to close the question early.</p><div>{wQuestions.map((question) => <span>{question}</span>)}</div></section>
      <section class="open-ledger">
        <div><p class="section-number">UNRESOLVED RECORD</p><h3>The questions still alive</h3><p>Album One closes its movement while leaving the threshold open.</p></div>
        <ul><li>The cause of the crossing restrictions</li><li>Why Wrongula differs from vampire norms</li><li>The origin of his household culture</li><li>The nature of the reactive forest</li><li>The purpose and location of the eleven keys</li><li>The significance of Eve’s necklace</li></ul>
      </section>
    </div>
  </article>

  <footer class="archive-footer"><p><span>THE ARCHIVE REMAINS OPEN</span>This foundation reflects the canon currently gathered. New leaves can be added as Mary and Wrongula continue to grow.</p><a href="/lore">← Back to the Levels &amp; Folds</a></footer>
</Layout>

<script>
  const book = document.querySelector('[data-overlap-book]');

  if (book instanceof HTMLElement) {
    const setReveal = (value: number) => {
      const reveal = Math.max(0, Math.min(100, value));
      book.style.setProperty('--reveal', `${reveal}%`);
      book.setAttribute('aria-valuenow', `${Math.round(reveal)}`);
      const description = reveal > 65
        ? '6_66 is mostly revealed'
        : reveal < 35
          ? '66_6 is mostly revealed'
          : 'Both pages overlap evenly';
      book.setAttribute('aria-valuetext', description);
    };

    const revealFromPointer = (event: PointerEvent) => {
      const bounds = book.getBoundingClientRect();
      setReveal(((event.clientX - bounds.left) / bounds.width) * 100);
    };

    book.addEventListener('pointermove', revealFromPointer);
    book.addEventListener('pointerdown', (event) => {
      book.setPointerCapture(event.pointerId);
      revealFromPointer(event);
    });
    book.addEventListener('keydown', (event) => {
      const current = Number(book.getAttribute('aria-valuenow') || 50);
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        setReveal(current - 10);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        setReveal(current + 10);
      }
      if (event.key === 'Home') setReveal(0);
      if (event.key === 'End') setReveal(100);
    });
    document.querySelectorAll('[data-reveal]').forEach((control) => {
      control.addEventListener('click', () => setReveal(Number(control.getAttribute('data-reveal'))));
    });
  }
</script>

