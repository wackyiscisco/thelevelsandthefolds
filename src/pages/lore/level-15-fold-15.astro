<script is:inline define:vars={{ allChars: [...foundFamily, ...lastBastion, ...datasTeam, ...councilMembers] }}>
  window.activeModalImgSrc = '';
  window.activeModalCaption = '';

  window.openModal = function(id) {
    const char = allChars.find(c => c.id === id);
    if (!char) return;

    document.getElementById('modalFaction').innerText = char.faction;
    document.getElementById('modalName').innerText = char.name;
    document.getElementById('modalRole').innerText = char.role;
    document.getElementById('modalQuote').innerText = `"${char.quote}"`;
    document.getElementById('modalBio').innerText = char.bio;
    document.getElementById('modalFunction').innerText = char.function;

    const modalImg = document.getElementById('modalImage');
    const placeholder = document.getElementById('placeholderBox');
    const btn = document.getElementById('lightboxTriggerBtn');

    if (char.hasImage && char.image) {
      modalImg.src = char.image;
      window.activeModalImgSrc = char.image;
      window.activeModalCaption = `${char.name} — Official Master Character Sheet`;
      modalImg.classList.remove('hidden');
      btn.classList.remove('hidden');
      placeholder.classList.add('hidden');
    } else {
      modalImg.classList.add('hidden');
      btn.classList.add('hidden');
      placeholder.classList.remove('hidden');
    }

    const traitsContainer = document.getElementById('modalTraits');
    traitsContainer.innerHTML = char.traits.map(t => `<span class="bg-slate-800 text-cyan-300 px-2.5 py-1 rounded border border-slate-700">${t}</span>`).join('');

    document.getElementById('characterModal').classList.remove('hidden');
  };

  window.closeModal = function() {
    document.getElementById('characterModal').classList.add('hidden');
  };

  window.triggerModalLightbox = function() {
    if (window.activeModalImgSrc) {
      window.openLightbox(window.activeModalImgSrc, window.activeModalCaption);
    }
  };

  window.openLightbox = function(src, caption) {
    document.getElementById('lightboxImg').src = src;
    document.getElementById('lightboxCaption').innerText = caption;
    document.getElementById('lightboxModal').classList.remove('hidden');
  };

  window.closeLightbox = function() {
    document.getElementById('lightboxModal').classList.add('hidden');
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      window.closeModal();
      window.closeLightbox();
    }
  });
</script>
