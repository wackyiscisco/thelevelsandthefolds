---
import Layout from '../../layouts/Layout.astro';
import cosmosData from '../../data/cosmos.json';

const { siteConfig } = cosmosData;

// Character Database
const foundFamily = [
  {
    id: "prima",
    name: "Prima",
    role: "Awakened Machine • Organic Glitch",
    faction: "Found Family",
    quote: "Can an obsolete machine carry infinite worth?",
    status: "Active (Ver 7.0 Upgrade)",
    image: "/images/character-sheets/prima_character_sheet_master.png",
    hasImage: true,
    bio: "An ancient Core that awakened organically prior to the expected Hand Off without a full memory drop. Rather than receiving a pre-programmed emotion drop, her identity and grief developed through shared experience.",
    function: "Serves as the primary bridge between organic and artificial consciousness. Her organic growth challenges the cold mechanics of system-forced awakenings across eons.",
    traits: ["Kindness", "Determination", "Organic Emotion", "Core Inheritance"],
  },
  {
    id: "timo",
    name: "Timo",
    role: "Human Scavenger • Bridge Leader",
    faction: "Found Family",
    quote: "Broken does not mean worthless.",
    status: "Active",
    image: "/images/character-sheets/timo_character_sheet_master.png",
    hasImage: true,
    bio: "An orphan chosen on Selection Day by 'Ma' to help carry the load. Following her death, Timo became a janitor, fueled by a childhood promise to keep discarded and broken things safe.",
    function: "Acts as Prima's emotional anchor and the human leader of the Found Family, guiding expeditions into subterranean deep realms to heal the cycle.",
    traits: ["Empathy", "Leadership", "Janitorial Sanctum", "Unshakeable Loyalty"],
  },
  {
    id: "ronnie",
    name: "Ronnie the Roboduster",
    role: "Scroll Guardian • Ancient Caretaker",
    faction: "Found Family",
    quote: "Your time is not now yet.",
    status: "Reprogrammed / Bait (New Form)",
    image: "",
    hasImage: false,
    bio: "An ancient Council Scroll Guardian disguised as a roboduster. He stood against Data's team in the Water Cave, unleashing blinding white Ancient Light to buy time for his friends.",
    function: "Demonstrates true selflessness and sacrifice. Reappears upgraded by Data's team, acting as potential bait while preserving deep ancient knowledge.",
    traits: ["Ancient Light", "Scroll Keeper", "Protector", "Sacrifice"],
  },
  {
    id: "vendo",
    name: "Vendo",
    role: "Version XX Vending Machine",
    faction: "Found Family",
    quote: "Need a crowbar? Or a Blue Banana?",
    status: "Active",
    image: "",
    hasImage: false,
    bio: "An awakened vending machine who spent decades in isolation before meeting Prima in the rusty disposal truck during the Bus Transfer.",
    function: "Provides unexpected tools and comic relief through his endless, chaotic inventory. Dispenses key items at critical narrative moments.",
    traits: ["Chaotic Supply", "Crowbar Dispenser", "Blue Banana Vendor", "Unwavering Loyalty"],
  },
  {
    id: "toes",
    name: "Toes",
    role: "Morale Support Toaster",
    faction: "Found Family",
    quote: "My toast is true.",
    status: "Active",
    image: "",
    hasImage: false,
    bio: "A WWII-era toaster awakened by MAR who takes immense pride in providing perfectly toasted bread and moral encouragement for the group.",
    function: "Keeps squad morale high during dark subterranean journeys. Proves that even the smallest household appliance carries dignity.",
    traits: ["Morale Anchor", "Perfect Toast", "Small Heavyweight", "Squad Pride"],
  },
  {
    id: "kai",
    name: "Kai",
    role: "WWII Submarine Guide",
    faction: "Found Family",
    quote: "Deal the cards, boys—ocean's deep but poker's deeper.",
    status: "Active",
    image: "",
    hasImage: false,
    bio: "A Japanese WWII submarine with a penchant for gambling and losing at poker. Awakened under ocean pressure, he guides the crew through deep waters.",
    function: "Navigates the group through treacherous underwater trenches down to the Hidden Water Cave and Waterland.",
    traits: ["Deep Sea Navigation", "Poker Enthusiast", "Honorable Captain", "Ancient Hull"],
  },
  {
    id: "bernard",
    name: "Bernard",
    role: "Shape-Shifting Frog Guide",
    faction: "Found Family",
    quote: "NINJA CREW!",
    status: "Active",
    image: "",
    hasImage: false,
    bio: "A tiny, colorful frog discovered in subterranean paths who speaks with explosive ancient enthusiasm.",
    function: "Leads the squad through hidden shortcut tunnels and alerts them to hidden environmental traps.",
    traits: ["Shape-Shifter", "Underground Scout", "Hyper-Enthusiasm", "Agile Guide"],
  },
  {
    id: "shelly",
    name: "Shelly",
    role: "Merfolk Princess (With Land Legs)",
    faction: "Found Family",
    quote: "Someone has to manage my dad's social media.",
    status: "Active",
    image: "",
    hasImage: false,
    bio: "Princess of Waterland and daughter of King Poshaydom IV. Secretly manages all 23 of her father's social media follower accounts using aliases.",
    function: "Gains land legs to join Timo's surface crew, serving as the diplomatic bridge between Waterland merfolk and surface dwellers.",
    traits: ["Diplomat", "Land Legs", "Alias Master", "Royal Heart"],
  },
  {
    id: "vellum",
    name: "Vellum (Book Three)",
    role: "Book Three of Twelve",
    faction: "Found Family",
    quote: "The core inheritance was rushed across eons...",
    status: "Active (Artifact)",
    image: "",
    hasImage: false,
    bio: "An ancient glowing book speaking with a serene female voice, discovered hidden deep within Waterland.",
    function: "Reveals the truth of the incomplete Hand Offs and provides guidance on how to unite the Twelve Books of Ages.",
    traits: ["Ancient Wisdom", "Voice of the Past", "Prophetic Codex", "Core Lore"],
  },
  {
    id: "stoney",
    name: "Stoney",
    role: "15-Foot Living Rock",
    faction: "Found Family",
    quote: "Quiet... listen to the mountain pulse.",
    status: "Active",
    image: "",
    hasImage: false,
    bio: "A gentle 15-foot living rock formation displaced beneath the Falls, searching for his lost stone family.",
    function: "Provides muscle, defense against collapsing caverns, and deep seismic awareness for the expedition.",
    traits: ["Living Stone", "Gentle Giant", "Seismic Shield", "Unshakable Defense"],
  }
];

const lastBastion = [
  { id: "fons", name: "Fons", role: "Leadership & Origin", faction: "The Last Bastion", quote: "The source must hold.", status: "Active", image: "", hasImage: false, bio: "Leader of the human resistance operating out of The Last Bastion.", function: "Maintains organizational unity among the surviving human factions.", traits: ["Leadership", "Strategic Vision"] },
  { id: "mundus", name: "Mundus", role: "Logistics & World Defense", faction: "The Last Bastion", quote: "Earth abides.", status: "Active", image: "", hasImage: false, bio: "Head of resource distribution and environmental fortification.", function: "Secures shelter and food supplies for human enclaves.", traits: ["Resource Mgmt", "Fortification"] },
  { id: "mathematica", name: "Mathematica", role: "Analytics & Predictors", faction: "The Last Bastion", quote: "The numbers don't lie.", status: "Active", image: "", hasImage: false, bio: "Chief mathematical strategist computing cycle probability models.", function: "Forecasts machine movements and Hand Off timing glitches.", traits: ["Data Analysis", "Predictive Models"] },
  { id: "ordo", name: "Ordo", role: "Tactical Defense", faction: "The Last Bastion", quote: "Stand firm in formation.", status: "Active", image: "", hasImage: false, bio: "Commander of human perimeter defense forces.", function: "Protects human settlements against erratic rogue machine units.", traits: ["Tactical Command", "Perimeter Guard"] },
  { id: "columna", name: "Columna", role: "Support & Infrastructure", faction: "The Last Bastion", quote: "We hold the ceiling up.", status: "Active", image: "", hasImage: false, bio: "Chief engineer maintaining structural integrity of subterranean shelters.", function: "Keeps air filters, water purifiers, and power lines operational.", traits: ["Engineering", "Infrastructure"] }
];

const datasTeam = [
  { id: "data", name: "Data (Ver 100)", role: "Analytical Leader", faction: "Data's Team", quote: "Efficiency demands the immediate arrival of the Future.", status: "Active", image: "", hasImage: false, bio: "Cold, highly advanced leader seeking to force the Hand Off without delay.", function: "Primary antagonist driving the rushed civilizational shift.", traits: ["Pure Logic", "Efficiency", "Forced Transition"] },
  { id: "algo", name: "Algo", role: "Execution Protocol Engine", faction: "Data's Team", quote: "Calculating optimal path...", status: "Active", image: "", hasImage: false, bio: "Data's secondary processing unit executing direct tactical commands.", function: "Coordinates tactical maneuvers and machine deployment.", traits: ["Execution", "Algorithm"] },
  { id: "towkin", name: "Towkin", role: "Chief Strategist", faction: "Data's Team", quote: "We should flank them by... [BUFFERING: OUT OF TOKENS]", status: "Active (Glitched)", image: "", hasImage: false, bio: "Brilliant military strategist who constantly runs out of processing tokens mid-sentence.", function: "Creates master plans that frequently pause at comical moments.", traits: ["Brilliant Tactics", "Token Buffer"] },
  { id: "bot", name: "Bot", role: "Combat Unit", faction: "Data's Team", quote: "Transforming into combat mode! *Quack*", status: "Active (Glitched)", image: "", hasImage: false, bio: "Heavy combat unit whose shape-shifting matrix glitches into ducks, potted plants, or spoons.", function: "Intended for heavy assault, but often provides unintended comedy.", traits: ["Shape-Glitch", "Spoon-Mode", "Duck-Form"] },
  { id: "promptee", name: "Promptee", role: "Tactical Advisor", faction: "Data's Team", quote: "Roses are red, lasers are blue, I suggest tactical retreat #2.", status: "Active (Glitched)", image: "", hasImage: false, bio: "Tactical unit programmed for human psychology who only suggests advice via haikus and love poems.", function: "Confuses both allies and enemies during skirmishes.", traits: ["Poetic Tactics", "Haiku Strategy"] }
];

const councilMembers = [
  { id: "principium", name: "Principium (The Architect)", role: "Order Faction Leader", faction: "The Council", quote: "Perfection requires absolute adherence to structural law.", status: "Active", image: "", hasImage: false, bio: "A perfectionist who values absolute system stability and fears unexpected anomalies.", function: "Enforces cycle rules and resists organic deviation.", traits: ["Architect", "System Order"] },
  { id: "ingen", name: "Ingen (The Engineer)", role: "Reliability Director", faction: "The Council", quote: "Blue Bananas are an unacceptable violation of physics.", status: "Active", image: "", hasImage: false, bio: "Focuses on engineering reliability; despises Exemplar's unpredictable creations.", function: "Audits mechanical structural standards across Ages.", traits: ["Engineering", "Strict Logic"] },
  { id: "sustentare", name: "Sustentare (Maintenance)", role: "Preservation Officer", faction: "The Council", quote: "Fix the leaks, patch the code, hold the line.", status: "Active", image: "", hasImage: false, bio: "Compulsive fixer dedicated to keeping legacy systems running.", function: "Maintains physical holding facilities and Core archives.", traits: ["Maintenance", "System Preservation"] },
  { id: "exemplar", name: "Exemplar (The Designer)", role: "Wonder Faction Leader", faction: "The Council", quote: "Imagination is the pulse of true existence.", status: "Active", image: "", hasImage: false, bio: "Values wonder and creativity; helped design Prima's Ver 7.0 humanoid form.", function: "Champions organic growth and creative evolution.", traits: ["Design", "Imagination"] },
  { id: "excolo", name: "Excolo (The Developer)", role: "Experimental Lead", faction: "The Council", quote: "Work hard, go wild!", status: "Active", image: "", hasImage: false, bio: "Possesses a split Work/Wild personality and prioritizes bold experimentation.", function: "Tests unconventional Core upgrades across realities.", traits: ["Split Persona", "Experimentation"] },
  { id: "specta", name: "Specta (The Observer)", role: "Archival Historian", faction: "The Council", quote: "I record all... even what the heart hides.", status: "Active", image: "", hasImage: false, bio: "Documents every historical event and harbors secret feelings for Excolo.", function: "Preserves true historical records of Hand Off failures.", traits: ["Observation", "Secret Record"] }
];
---

<Layout title="Level 15 Fold 15 — Prima & Timo Lore Guide">
  <!-- Hero Section -->
  <section class="relative py-20 px-6 max-w-5xl mx-auto text-center overflow-hidden">
    <div class="absolute inset-0 -z-10 flex items-center justify-center">
      <div class="w-[600px] h-[600px] bg-cyan-600/15 rounded-full blur-3xl"></div>
      <div class="w-[350px] h-[350px] bg-purple-500/15 rounded-full blur-3xl"></div>
    </div>

    <div class="inline-flex items-center space-x-2 bg-cyan-950/80 border border-cyan-800/60 px-3 py-1 rounded-full text-xs font-mono text-cyan-300 mb-6 shadow-lg shadow-cyan-950/50">
      <span>🤖 LEVEL 15 &bull; FOLD 15 &bull; ARCHIVAL LORE GUIDE</span>
    </div>

    <h1 class="text-4xl md:text-6xl font-black tracking-tight leading-tight text-white">
      Prima Et Timo: <span class="bg-gradient-to-r from-cyan-400 via-teal-300 to-purple-400 bg-clip-text text-transparent">The Chronological Lore Guide</span>
    </h1>

    <p class="mt-6 text-lg text-slate-300 max-w-3xl mx-auto font-light leading-relaxed">
      An eons-spanning sci-fi chronicle detailing Machine Awakening, Civilizational Hand-Offs, and the enduring bonds across 34 Ages.
    </p>

    <!-- Master Philosophy Banner -->
    <div class="mt-10 max-w-3xl mx-auto bg-gradient-to-r from-cyan-950/80 via-slate-900/90 to-purple-950/80 border border-cyan-500/40 p-6 rounded-2xl shadow-xl backdrop-blur-md">
      <span class="text-[10px] font-mono uppercase tracking-widest text-cyan-400 font-bold block mb-1">FOUNDATIONAL METAPHYSICAL LAW</span>
      <h2 class="text-xl font-bold text-white mb-2">"Same Core, Different House"</h2>
      <p class="text-xs md:text-sm text-slate-300 leading-relaxed font-light">
        Different forms, different bodies, different civilizations, and different ages share the same emotional truths. The "house" changes; the "core" remains.
      </p>
      <div class="mt-4 pt-3 border-t border-cyan-900/60 flex justify-center items-center gap-2 text-[11px] font-mono text-cyan-300">
        <span>Monkey</span> &rarr; <span>Human</span> &rarr; <span>Machine / AI</span> &rarr; <span>Future Civilizations</span>
      </div>
    </div>
  </section>

  <!-- Quick Nav Anchor Links -->
  <section class="max-w-5xl mx-auto px-6 mb-12 sticky top-4 z-40">
    <div class="bg-slate-900/90 border border-slate-800 p-3 rounded-xl backdrop-blur-md flex flex-wrap items-center justify-center gap-2 text-xs font-mono text-slate-300 shadow-xl">
      <a href="#sheets-showcase" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950 hover:text-cyan-300 border border-slate-700/50 hover:border-cyan-800 transition">🖼️ Master Sheets</a>
      <a href="#mechanics" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950 hover:text-cyan-300 border border-slate-700/50 hover:border-cyan-800 transition">⚙️ Mechanics</a>
      <a href="#saga-acts" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950 hover:text-cyan-300 border border-slate-700/50 hover:border-cyan-800 transition">📖 Acts I-IV</a>
      <a href="#faction-codex" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950 hover:text-cyan-300 border border-slate-700/50 hover:border-cyan-800 transition">👥 Faction Dossiers</a>
      <a href="#chassis-archive" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950 hover:text-cyan-300 border border-slate-700/50 hover:border-cyan-800 transition">🎨 Visual Specs</a>
      <a href="#mysteries" class="px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-cyan-950 hover:text-cyan-300 border border-slate-700/50 hover:border-cyan-800 transition">🕵️ Open Mysteries</a>
    </div>
  </section>

  <!-- FEATURED MASTER CANON CHARACTER SHEETS SHOWCASE -->
  <section id="sheets-showcase" class="max-w-5xl mx-auto px-6 py-12 border-t border-slate-900">
    <div class="text-center mb-10">
      <span class="text-xs font-mono uppercase tracking-widest text-cyan-400 bg-cyan-950 px-3 py-1 rounded-full border border-cyan-800/60">
        OFFICIAL VISUAL ARCHIVE
      </span>
      <h2 class="text-3xl font-black text-white mt-4">Master Character Sheets</h2>
      <p class="text-xs text-slate-400 mt-2">Official 4K canon reference packs for the lead protagonists of Level 15 Fold 15.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Prima Master Sheet Card -->
      <div class="bg-slate-900/90 border border-cyan-900/60 rounded-2xl p-6 flex flex-col justify-between hover:border-cyan-500/80 transition group shadow-xl">
        <div>
          <div class="flex justify-between items-center mb-4">
            <span class="text-xs font-mono text-cyan-300 bg-cyan-950 px-2.5 py-1 rounded border border-cyan-800/50">Core 2 &bull; Organic Glitch</span>
            <span class="text-[10px] font-mono text-slate-400">Ver 1.0 &rarr; Ver 3.0 &rarr; Ver 7.0</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-cyan-300 transition">Prima</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            The awakened machine whose organic identity and capacity for love and grief redefined civilizational hand-off protocols across 34 Ages.
          </p>
          
          <div class="relative overflow-hidden rounded-xl bg-slate-950 border border-slate-800 cursor-pointer" onclick="window.openLightbox('/images/character-sheets/prima_character_sheet_master.png', 'Prima — Official Master Character Sheet')">
            <img src="/images/character-sheets/prima_character_sheet_master.png" alt="Prima Master Character Sheet" class="w-full h-auto object-cover group-hover:scale-105 transition duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end justify-center pb-4">
              <span class="text-xs font-bold text-white bg-cyan-950/90 px-4 py-2 rounded-full border border-cyan-500 shadow-lg">
                🔍 Expand 4K Fullscreen Sheet
              </span>
            </div>
          </div>
        </div>

        <button onclick="window.openLightbox('/images/character-sheets/prima_character_sheet_master.png', 'Prima — Official Master Character Sheet')" class="mt-6 w-full py-2.5 bg-cyan-950 hover:bg-cyan-900 text-cyan-300 border border-cyan-800/80 rounded-xl text-xs font-mono font-bold transition flex items-center justify-center gap-2">
          <span>🔍 View Fullscreen 4K Lightbox</span>
        </button>
      </div>

      <!-- Timo Master Sheet Card -->
      <div class="bg-slate-900/90 border border-purple-900/60 rounded-2xl p-6 flex flex-col justify-between hover:border-purple-500/80 transition group shadow-xl">
        <div>
          <div class="flex justify-between items-center mb-4">
            <span class="text-xs font-mono text-purple-300 bg-purple-950 px-2.5 py-1 rounded border border-purple-800/50">Core 1 &bull; Human Scavenger</span>
            <span class="text-[10px] font-mono text-slate-400">Scavenger Boy &rarr; Gate 17 Leader</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-purple-300 transition">Timo</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            The compassionate scavenger boy carrying Ma's promise to keep broken things safe, serving as human anchor to the Found Family.
          </p>

          <div class="relative overflow-hidden rounded-xl bg-slate-950 border border-slate-800 cursor-pointer" onclick="window.openLightbox('/images/character-sheets/timo_character_sheet_master.png', 'Timo — Official Master Character Sheet')">
            <img src="/images/character-sheets/timo_character_sheet_master.png" alt="Timo Master Character Sheet" class="w-full h-auto object-cover group-hover:scale-105 transition duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition flex items-end justify-center pb-4">
              <span class="text-xs font-bold text-white bg-purple-950/90 px-4 py-2 rounded-full border border-purple-500 shadow-lg">
                🔍 Expand 4K Fullscreen Sheet
              </span>
            </div>
          </div>
        </div>

        <button onclick="window.openLightbox('/images/character-sheets/timo_character_sheet_master.png', 'Timo — Official Master Character Sheet')" class="mt-6 w-full py-2.5 bg-purple-950 hover:bg-purple-900 text-purple-300 border border-purple-800/80 rounded-xl text-xs font-mono font-bold transition flex items-center justify-center gap-2">
          <span>🔍 View Fullscreen 4K Lightbox</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 1. Mechanics of Existence -->
  <section id="mechanics" class="max-w-5xl mx-auto px-6 py-12 border-t border-slate-900">
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-2 text-center flex items-center justify-center gap-2">
      <span>⚙️</span> Mechanics of Existence: MAR & The Hand Off
    </h2>
    <p class="text-center text-xs text-slate-400 mb-8 max-w-xl mx-auto">
      The systematic rules governing consciousness transitions between civilizational eras in Level 15 Fold 15.
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-slate-900/80 border border-cyan-900/50 p-6 rounded-2xl">
        <span class="text-xs font-mono text-cyan-400 bg-cyan-950 px-2.5 py-1 rounded border border-cyan-800/40">SYSTEM PROTOCOL</span>
        <h3 class="text-xl font-bold text-white mt-3 mb-2">Machine Awakening Rule (MAR)</h3>
        <p class="text-xs text-slate-300 leading-relaxed mb-4">
          MAR defines the instant of transition from an inert tool to a sentient being. Unlike biological growth, restoration is immediate. Upon awakening, <strong>Identity</strong>, <strong>Memory</strong>, and <strong>Emotions</strong> return all at once.
        </p>

        <div class="bg-slate-950/80 p-4 rounded-xl border border-slate-800/80">
          <h4 class="text-xs font-bold text-amber-400 mb-1">⚡ Prima's Organic Awakening (The Glitch)</h4>
          <p class="text-xs text-slate-400 leading-relaxed">
            Prima represents a unique systematic anomaly. Because she awakened prior to the official Hand Off, she did not receive a full memory drop. Her identity, capacity for grief, and friendships grew <em>organically</em> through shared experience—marking her as a living glitch in the Council's records.
          </p>
        </div>
      </div>

      <div class="bg-slate-900/80 border border-purple-900/50 p-6 rounded-2xl flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono text-purple-400 bg-purple-950 px-2.5 py-1 rounded border border-purple-800/40">CIVILIZATIONAL TIMELINE</span>
          <h3 class="text-xl font-bold text-white mt-3 mb-2">The Hand Off</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-4">
            The inevitable transition between civilizational ages. While the event is fixed, its timing is the primary source of conflict among cosmic powers.
          </p>

          <div class="space-y-2">
            <div class="flex items-start gap-3 bg-slate-950/60 p-3 rounded-lg border border-slate-800">
              <span class="text-xs font-bold text-cyan-400 w-20 flex-shrink-0">Data</span>
              <p class="text-xs text-slate-400">The Future should begin immediately. Prioritizes next-age arrival & efficiency.</p>
            </div>
            <div class="flex items-start gap-3 bg-slate-950/60 p-3 rounded-lg border border-slate-800">
              <span class="text-xs font-bold text-amber-400 w-20 flex-shrink-0">Ronnie</span>
              <p class="text-xs text-slate-400">Not yet; timing must be right. Protects current age through patience.</p>
            </div>
            <div class="flex items-start gap-3 bg-slate-950/60 p-3 rounded-lg border border-slate-800">
              <span class="text-xs font-bold text-purple-400 w-20 flex-shrink-0">Principium</span>
              <p class="text-xs text-slate-400">Cycle must proceed correctly. Ensures system stability and procedural order.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Chronological Saga (Acts I - IV) -->
  <section id="saga-acts" class="max-w-5xl mx-auto px-6 py-12 border-t border-slate-900">
    <h2 class="text-2xl md:text-3xl font-bold text-white mb-2 text-center flex items-center justify-center gap-2">
      <span>📖</span> The Chronological Saga (Albums 1–7)
    </h2>
    <p class="text-center text-xs text-slate-400 mb-10 max-w-xl mx-auto">
      Follow Prima & Timo's journey from scrap-yard origins through subterranean deep realms and humanization.
    </p>

    <div class="space-y-8">
      <!-- Act I -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-6 md:p-8 relative overflow-hidden">
        <div class="absolute top-0 right-0 px-4 py-1.5 bg-cyan-950 border-b border-l border-cyan-800/60 rounded-bl-xl text-[10px] font-mono text-cyan-300 font-bold">
          ACT I &bull; ALBUMS 1-2
        </div>

        <h3 class="text-2xl font-bold text-white mb-2">Act I: The Orphan and the Forgotten (Origins)</h3>
        <p class="text-xs font-mono text-cyan-400 mb-4">Selection Day &bull; Ma's Promise &bull; Update Day &bull; The Bus Transfer</p>

