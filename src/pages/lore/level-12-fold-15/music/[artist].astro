---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

const artistProfiles = {
  'crimson-sparks': {
    name: 'The Crimson Sparks',
    eyebrow: 'The original ignition',
    headline: 'The Spark Radio',
    deck: 'Seven records trace a signal from its first honest note to the embers it left in everyone who listened.',
    image: '/images/artists/level_12_fold_15_open_group_01.png',
    imagePosition: 'center 28%',
    theme: 'sparks',
    device: 'Vacuum-tube broadcast',
  },
  maya: {
    name: 'Maya',
    eyebrow: 'The spark passed on',
    headline: 'The Headline Receiver',
    deck: 'Six records carry an inherited flame from the back of the crowd to the center of the stage.',
    image: '/images/artists/level_12_fold_15_maya_separator_01.png',
    imagePosition: '60% 10%',
    theme: 'maya',
    device: 'Neon cassette deck',
  },
  'that-guy': {
    name: 'That Guy',
    eyebrow: 'Saevit Animo',
    headline: 'The Breakroom Jukebox',
    deck: 'One enormous record turns office rage, terrible decisions, messy love, and ordinary survival into a public disturbance.',
    image: '/images/artists/level_12_fold_15_that_guy_separator_01.png',
    imagePosition: 'center 34%',
    theme: 'guy',
    device: 'Unauthorized office radio',
  },
} as const;

export async function getStaticPaths() {
  const routeProfiles = {
    'crimson-sparks': {
      name: 'The Crimson Sparks', eyebrow: 'The original ignition', headline: 'The Spark Radio',
      deck: 'Seven records trace a signal from its first honest note to the embers it left in everyone who listened.',
      image: '/images/artists/level_12_fold_15_open_group_01.png', imagePosition: 'center 28%', theme: 'sparks', device: 'Vacuum-tube broadcast',
    },
    maya: {
      name: 'Maya', eyebrow: 'The spark passed on', headline: 'The Headline Receiver',
      deck: 'Six records carry an inherited flame from the back of the crowd to the center of the stage.',
      image: '/images/artists/level_12_fold_15_maya_separator_01.png', imagePosition: '60% 10%', theme: 'maya', device: 'Neon cassette deck',
    },
    'that-guy': {
      name: 'That Guy', eyebrow: 'Saevit Animo', headline: 'The Breakroom Jukebox',
      deck: 'One enormous record turns office rage, terrible decisions, messy love, and ordinary survival into a public disturbance.',
      image: '/images/artists/level_12_fold_15_that_guy_separator_01.png', imagePosition: 'center 34%', theme: 'guy', device: 'Unauthorized office radio',
    },
  };

  return Object.entries(routeProfiles).map(([artist, profile]) => ({
    params: { artist },
    props: { profile },
  }));
}

const { artist } = Astro.params;
const { profile } = Astro.props;
const allSongs = await getCollection('songs');

const artistSlugFor = (name: string) => {
  const value = String(name || '').toLowerCase();
  if (value.includes('crimson')) return 'crimson-sparks';
  if (value.includes('maya')) return 'maya';
  if (value.includes('guy')) return 'that-guy';
  return '';
};

const albumSlugFor = (name: string) => String(name || '')
  .toLowerCase()
  .replace(/['’]/g, '')
  .replace(/^\s*album\s*/i, '')
  .replace(/^\s*\d+(?:\.\d+)?\s*[:—–-]?\s*/, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '');

const albumNumberFor = (name: string) => {
  const match = String(name || '').match(/^\s*album\s*(\d+)/i);
  return match ? Number(match[1]) : 999;
};

const trackNumberFor = (song: any) =>
  typeof song.data.trackNumber === 'number' ? song.data.trackNumber : 999;

let sourceSongs = allSongs.filter((song) => artistSlugFor(song.data.artist) === artist);

if (artist === 'crimson-sparks') {
  sourceSongs = sourceSongs.filter((song) => !(
    String(song.data.album).startsWith('Album 1:') &&
    trackNumberFor(song) === 12
  ));
}

const preparedSongs = await Promise.all(sourceSongs.map(async (song) => {
  const { Content } = await song.render();
  return { ...song, Content };
}));

if (artist === 'crimson-sparks') {
  const liveSource = allSongs.find((song) =>
    artistSlugFor(song.data.artist) === 'crimson-sparks' &&
    String(song.data.title).toLowerCase().includes('still we stand') &&
    String(song.data.title).toLowerCase().includes('live and loud')
  );

  if (liveSource) {
    const { Content } = await liveSource.render();
    preparedSongs.push({
      ...liveSource,
      slug: '12-still-we-stand-live-version',
      data: {
        ...liveSource.data,
        title: 'Still We Stand — Live Version',
        album: 'Album 1: The First Spark',
        trackNumber: 12,
        coverImage: '/images/albums/crimson-sparks/The First Spark.jpg',
      },
      Content,
    });
  }
}

const albumMap = new Map<string, any>();
for (const song of preparedSongs) {
  const albumName = String(song.data.album || 'Unfiled Record');
  const albumSlug = albumSlugFor(albumName);
  if (!albumMap.has(albumSlug)) {
    albumMap.set(albumSlug, {
      name: albumName.replace(/^\s*album\s*\d+(?:\.\d+)?\s*[:—–-]?\s*/i, ''),
      fullName: albumName,
      slug: albumSlug,
      number: albumNumberFor(albumName),
      cover: song.data.coverImage || '',
      songs: [],
    });
  }
  albumMap.get(albumSlug).songs.push(song);
}

const albums = Array.from(albumMap.values())
  .sort((a, b) => a.number - b.number || a.name.localeCompare(b.name))
  .map((album) => ({
    ...album,
    songs: album.songs.sort((a: any, b: any) =>
      trackNumberFor(a) - trackNumberFor(b) ||
      String(a.data.title).localeCompare(String(b.data.title))
    ),
  }));

const trackCount = albums.reduce((count, album) => count + album.songs.length, 0);
const lyricCount = albums.reduce((count, album) =>
  count + album.songs.filter((song: any) =>
    !String(song.body || '').includes('Full lyrics are not yet available.')
  ).length, 0);

const audioBase = String(
  import.meta.env.PUBLIC_AUDIO_BASE_URL || 'https://pub-c14abec721134d8ea9493de723a7e1ff.r2.dev'
).replace(/\/$/, '');
const audioUrlFor = (albumSlug: string, songSlug: string) => {
  const key = `${artist}/${albumSlug}/${songSlug}`;
  return audioBase ? `${audioBase}/12_15/${key}.mp3` : '';
};
---

<Layout title={`${profile.name} Music Archive | Level 12 Fold 15`}>
  <main class:list={['music-archive', profile.theme]}>
    <nav class="archive-nav" aria-label="Open universe music archive">
      <a href="/lore/level-12-fold-15">← Open 12_15</a>
      <a href="/lore/level-12-fold-15/music">The Cosmos Radio</a>
      <div>
        {Object.entries(artistProfiles).map(([slug, item]) => (
          <a href={`/lore/level-12-fold-15/music/${slug}`} aria-current={slug === artist ? 'page' : undefined}>{item.name}</a>
        ))}
      </div>
    </nav>

    <header class="archive-hero">
      <img src={profile.image} alt={profile.name} style={`object-position:${profile.imagePosition}`} />
      <div class="hero-shade"></div>
      <div class="hero-copy">
        <p>{profile.eyebrow} · Level 12 Fold 15</p>
        <h1>{profile.headline}</h1>
        <em>{profile.device}</em>
        <div class="archive-stats"><span>{albums.length} albums</span><span>{trackCount} tracks</span><span>{lyricCount} lyric records</span></div>
        <p class="hero-deck">{profile.deck}</p>
      </div>
    </header>

    <section class="jukebox" aria-labelledby="jukebox-title">
      <div class="device-face" aria-hidden="true">
        <span class="antenna"></span><span class="dial dial-a"></span><span class="dial dial-b"></span>
        <div class="speaker">{Array.from({ length: 28 }).map(() => <i></i>)}</div>
      </div>
      <div class="player-copy">
        <p class="micro">NOW RECEIVING · 12_15</p>
        <h2 id="jukebox-title">{profile.name} jukebox</h2>
        <p id="player-title">{audioBase ? 'Choose a track below.' : 'The archive is ready; the private masters still need their public broadcast line.'}</p>
        <p id="player-album" class="player-album">{audioBase ? 'Player standing by' : 'Album and lyrics access is open below'}</p>
        <audio id="archive-audio" preload="metadata"></audio>
        <div class="controls">
          <button id="previous-track" type="button" disabled aria-label="Previous track">|◀</button>
          <button id="toggle-play" type="button" disabled aria-label="Play or pause">▶</button>
          <button id="next-track" type="button" disabled aria-label="Next track">▶|</button>
          <button id="random-track" class="random-track" type="button" disabled aria-label="Play random songs from every album" aria-pressed="false">Random</button>
          <label>Volume <input id="player-volume" type="range" min="0" max="1" step="0.05" value="0.78" /></label>
        </div>
      </div>
      <div class="signal-lights" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    </section>

    <nav class="album-index" aria-label={`${profile.name} albums`}>
      {albums.map((album) => (
        <a href={`#${album.slug}`}><span>{String(album.number).padStart(2, '0')}</span>{album.name}</a>
      ))}
    </nav>

    <div class="album-stack">
      {albums.map((album) => (
        <section id={album.slug} class="album-record">
          <header class="album-heading">
            <figure>
              {album.cover ? <img src={album.cover} alt={`${album.name} album cover`} loading="lazy" /> : <div class="cover-fallback">12_15</div>}
              <figcaption>RECORD {String(album.number).padStart(2, '0')}</figcaption>
            </figure>
            <div>
              <p class="micro">{profile.name} · Official sequence</p>
              <h2>{album.name}</h2>
              <p>{album.songs.length} tracks. Open any lyric drawer without leaving the record; the jukebox will use this same sequence when the public audio line is connected.</p>
            </div>
          </header>

          <div class="track-list">
            {album.songs.map((song: any, index: number) => {
              const TrackLyrics = song.Content;
              const number = trackNumberFor(song) === 999 ? index + 1 : trackNumberFor(song);
              const audioUrl = audioUrlFor(album.slug, song.slug);
              const lyricsAvailable = !String(song.body || '').includes('Full lyrics are not yet available.');
              return (
                <article class="track-row">
                  <div class="track-main">
                    <button
                      class="track-play"
                      type="button"
                      disabled={!audioUrl}
                      data-audio={audioUrl || undefined}
                      data-title={song.data.title}
                      data-album={album.name}
                      aria-label={audioUrl ? `Play ${song.data.title}` : `${song.data.title} audio awaiting public host`}
                    >{audioUrl ? '▶' : '—'}</button>
                    <span class="track-number">{String(number).padStart(2, '0')}</span>
                    <div class="track-title"><h3>{song.data.title}</h3>{song.data.quote && <p>“{song.data.quote}”</p>}</div>
                    <span class="track-state">{audioUrl ? 'Play' : 'Audio queued'}</span>
                  </div>
                  {lyricsAvailable ? (
                    <details class="lyrics-drawer">
                      <summary>Read lyrics <span>＋</span></summary>
                      <div class="lyrics-copy"><TrackLyrics /></div>
                    </details>
                  ) : (
                    <p class="lyrics-pending">Lyrics record pending.</p>
                  )}
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>

    <footer class="archive-footer">
      <p>PUBLIC MUSIC RECORD · 12_15</p>
      <div><a href="/lore/level-12-fold-15/music">Choose another frequency</a><a href="/lore/level-12-fold-15">Return to the open universe</a></div>
    </footer>
  </main>

  <script>
    const audio = document.querySelector('#archive-audio');
    const playButton = document.querySelector('#toggle-play');
    const previousButton = document.querySelector('#previous-track');
    const nextButton = document.querySelector('#next-track');
    const randomButton = document.querySelector('#random-track');
    const volume = document.querySelector('#player-volume');
    const title = document.querySelector('#player-title');
    const album = document.querySelector('#player-album');
    const tracks = Array.from(document.querySelectorAll('.track-play[data-audio]'));

    if (audio instanceof HTMLAudioElement && playButton instanceof HTMLButtonElement) {
      let activeIndex = -1;
      let randomMode = false;
      const randomIndex = () => {
        if (tracks.length < 2) return 0;
        let next = activeIndex;
        while (next === activeIndex) next = Math.floor(Math.random() * tracks.length);
        return next;
      };
      const loadTrack = (index) => {
        const button = tracks[index];
        if (!(button instanceof HTMLButtonElement)) return;
        const source = button.dataset.audio;
        if (!source) return;
        tracks.forEach((track) => track.closest('.track-row')?.classList.remove('is-playing'));
        activeIndex = index;
        audio.src = source;
        if (title) title.textContent = button.dataset.title || 'Untitled transmission';
        if (album) album.textContent = button.dataset.album || '';
        button.closest('.track-row')?.classList.add('is-playing');
        playButton.disabled = false;
        if (previousButton instanceof HTMLButtonElement) previousButton.disabled = tracks.length < 2;
        if (nextButton instanceof HTMLButtonElement) nextButton.disabled = tracks.length < 2;
        if (randomButton instanceof HTMLButtonElement) randomButton.disabled = tracks.length < 2;
        audio.play().catch(() => {});
      };

      tracks.forEach((button, index) => button.addEventListener('click', () => loadTrack(index)));
      playButton.addEventListener('click', () => {
        if (!audio.src && tracks.length) loadTrack(0);
        else if (audio.paused) audio.play().catch(() => {});
        else audio.pause();
      });
      previousButton?.addEventListener('click', () => loadTrack((activeIndex - 1 + tracks.length) % tracks.length));
      nextButton?.addEventListener('click', () => loadTrack(randomMode ? randomIndex() : (activeIndex + 1) % tracks.length));
      if (randomButton instanceof HTMLButtonElement) {
        randomButton.disabled = tracks.length < 2;
        randomButton.addEventListener('click', () => {
          randomMode = !randomMode;
          randomButton.setAttribute('aria-pressed', String(randomMode));
          randomButton.textContent = randomMode ? 'Random on' : 'Random';
          if (randomMode) loadTrack(randomIndex());
        });
      }
      audio.addEventListener('play', () => { playButton.textContent = 'Ⅱ'; });
      audio.addEventListener('pause', () => { playButton.textContent = '▶'; });
      audio.addEventListener('ended', () => { if (tracks.length) loadTrack(randomMode ? randomIndex() : (activeIndex + 1) % tracks.length); });
      volume?.addEventListener('input', (event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement) audio.volume = Number(target.value);
      });
    }
  </script>
</Layout>

