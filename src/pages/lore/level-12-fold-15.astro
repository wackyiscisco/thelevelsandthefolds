---
import Layout from '../../layouts/Layout.astro';

const sparks = [
  { number: '01', name: 'Suki Moreau', gallery: 'suki', role: 'Vocals & Songwriter', signal: 'The Observer', bio: 'The narrative center of the band. Suki turns observation, loss, and the patterns people leave behind into songs carried in notebooks she never discards.', sheet: '/images/character-sheets/suki_moreau_character_sheet_master.png' },
  { number: '02', name: 'Soren Crane', gallery: 'soren', role: 'Bass & Co-Founder', signal: 'The Foundation', bio: 'A quiet mentor whose integrity anchors the group. Soren walked away from corporate label deals rather than let the music become something it was never meant to be.', sheet: '/images/character-sheets/soren_crane_character_sheet_master.png' },
  { number: '03', name: 'Sky Delacroix', gallery: 'sky', role: 'Lead Guitar', signal: 'The Wild Current', bio: "The band's chaotic creative energy. Sky plays by instinct and raw passion, treating every performance as a living thing that should never repeat itself exactly.", sheet: '/images/character-sheets/sky_delacroix_character_sheet_master.png' },
  { number: '04', name: 'Sol Kovic', gallery: 'sol', role: 'Drums', signal: 'The Pulse', bio: 'A self-taught, high-energy drummer whose ska-punk roots and infectious joy become the emotional heartbeat of the Crimson Sparks.', sheet: '/images/character-sheets/sol_kovic_character_sheet_master.png' },
  { number: '05', name: 'Sienna Aramaki', gallery: 'sienna', role: 'Rhythm Guitar & Keys', signal: 'The Harmonic Mind', bio: 'A classically trained prodigy who left conservatory expectations behind to choose genuine creation over flawless but empty performance.', sheet: '/images/character-sheets/sienna_aramaki_character_sheet_master.png' },
];

const successors = [
  { number: '06', name: 'Maya', role: 'Lead Vocalist & Guitarist', signal: 'The Spark Passed On', theme: 'maya', bio: 'Maya grew up with the Crimson Sparks as distant mentors, learning from their music without meeting them. Years later, she carries their legacy guitar onto a stadium stage and makes the spark unmistakably her own.', sheet: '/images/character-sheets/maya_character_sheet_master.png', feature: '/images/artists/level_12_fold_15_maya_separator_01.png', featureAlt: 'Maya seated with her guitar in a rehearsal studio', featureLabel: 'MAYA · THE SPARK PASSED ON', featureLine: 'A distant fan carries the fire forward—and makes it unmistakably her own.' },
  { number: '07', name: 'That Guy', role: 'Vocals, Rants & Corporate Meltdown', signal: 'Saevit Animo', theme: 'guy', bio: 'A corporate worker who finally broke after years of soul-draining routine. That Guy turns ordinary frustrations, messy love, bad decisions, and individual rebellion into one loud, unfiltered raging spirit.', sheet: '/images/character-sheets/that_guy_character_sheet_master.png', feature: '/images/artists/level_12_fold_15_that_guy_separator_01.png', featureAlt: 'That Guy outside his former corporate office carrying a briefcase', featureLabel: 'THAT GUY · SAEVIT ANIMO', featureLine: 'An ordinary life breaks open. A raging spirit finally answers.' },
];
---

<Layout title="Level 12 Fold 15 — The Open Universe">
  <div class="record-page">
    <section class="record-hero" aria-labelledby="record-title">
      <div class="hero-voices" aria-label="Suki, Maya, and That Guy">
        <figure class="voice-panel suki"><img src="/images/artists/level_12_fold_15_suki_01.png" alt="Suki Moreau seated beside her guitar" /><figcaption>Suki</figcaption></figure>
        <figure class="voice-panel maya"><img src="/images/artists/level_12_fold_15_maya_01.png" alt="Maya" /><figcaption>Maya</figcaption></figure>
        <figure class="voice-panel guy"><img src="/images/artists/level_12_fold_15_that_guy_01.png" alt="That Guy" /><figcaption>That Guy</figcaption></figure>
      </div>
      <a class="cosmos-radio-entry" href="/lore/level-12-fold-15/music" aria-label="Enter The Cosmos Radio music archive">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M18 15 48 5" />
          <rect x="7" y="16" width="50" height="36" rx="4" />
          <circle cx="21" cy="34" r="9" />
          <circle cx="21" cy="34" r="3" />
          <path d="M37 27h12M37 33h12M37 39h12M13 57h8M43 57h8" />
        </svg>
        <span><small>PUBLIC MUSIC SIGNAL · 12_15</small><strong>The Cosmos Radio</strong><em>Albums, lyrics, and every open song</em></span>
        <b>ENTER →</b>
      </a>
      <div class="hero-smoke smoke-a" aria-hidden="true"></div>
      <div class="hero-smoke smoke-b" aria-hidden="true"></div>
      <div class="spark-field" aria-hidden="true"></div>
      <div class="hero-copy">
        <div class="record-code"><span>PUBLIC RECORD</span> 12_15</div>
        <p class="kicker">The one universe presently open to everyone</p>
        <h1 id="record-title">Three voices.<br /><em>One living signal.</em></h1>
        <p class="hero-deck">Suki lit the first spark. Maya inherited its warmth. That Guy found a different flame entirely. Three voices carry the open record of 12_15.</p>
        <div class="hero-actions" aria-label="Explore the public artists of Level 12 Fold 15">
          <a href="#suki">Suki</a><a href="#maya">Maya</a><a href="#that-guy">That Guy</a>
        </div>
      </div>
      <div class="hero-foot"><span>LEVEL 12</span><b></b><span>FOLD 15</span><b></b><span>PUBLICLY OPEN</span></div>
    </section>

    <section class="transmission" aria-labelledby="transmission-title">
      <p class="kicker">The transmission line</p>
      <h2 id="transmission-title">Spark <span>→</span> Fire <span>→</span> Wildfire <span>→</span> Embers</h2>
      <p>“The music was never about us. It was always about what came next.”</p>
    </section>

    <section id="crimson-sparks" class="chapter sparks-chapter" aria-labelledby="sparks-title">
      <header class="chapter-heading">
        <div><p class="chapter-number">CHAPTER I · THE LEGENDARY MOVEMENT</p><h2 id="sparks-title">The Crimson Sparks</h2></div>
        <p>Five musicians began in dive bars searching for something honest. What followed was not simply a band, but an emotional fire passed from person to person until it belonged to everyone.</p>
      </header>

      <figure class="group-record">
        <img src="/images/artists/level_12_fold_15_open_group_01.png" alt="The five members of The Crimson Sparks" />
        <figcaption><span>THE CRIMSON FIVE</span><em>One spark. Five keepers. A movement carried forward.</em></figcaption>
      </figure>
      <a class="band-gallery-link" href="/lore/level-12-fold-15/gallery#band">Open the Crimson Sparks band gallery <span>→</span></a>
      <a class="band-gallery-link music-link" href="/lore/level-12-fold-15/music/crimson-sparks">Tune the Crimson Sparks on The Cosmos Radio <span>→</span></a>

      <div class="profile-stack">
        {sparks.map((person, index) => (
          <article id={person.gallery} class:list={['profile-record', index % 2 === 1 && 'reverse']}>
            <a class="sheet-frame" href={person.sheet} target="_blank" rel="noopener noreferrer" aria-label={`Open ${person.name}'s full character sheet`}>
              <img src={person.sheet} alt={`${person.name} character sheet`} loading="lazy" />
              <span class="sheet-cue">OPEN FULL CHARACTER SHEET <b>↗</b></span>
            </a>
            <div class="profile-copy">
              <div class="profile-index"><span>{person.number}</span><b>{person.signal}</b></div>
              <h3>{person.name}</h3><p class="role">{person.role}</p><p class="bio">{person.bio}</p>
              <a class="record-link gallery-link" href={`/lore/level-12-fold-15/gallery#${person.gallery}`}>Open {person.name.split(' ')[0]}'s photo gallery <span>→</span></a>
              <a class="record-link" href={person.sheet} target="_blank" rel="noopener noreferrer">Read the complete record <span>→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="chapter next-chapter" aria-labelledby="next-title">
      <header class="chapter-heading">
        <div><p class="chapter-number">CHAPTER II · TWO PATHS AFTER THE SPARK</p><h2 id="next-title">What came next</h2></div>
        <p>One artist receives a legacy from afar. Another tears his own voice out of an ordinary life. Neither repeats the Crimson Sparks; both prove that music keeps moving.</p>
      </header>

      <div class="successor-stack">
        {successors.map((person) => (
          <section class:list={['successor-path', person.theme]}>
            <figure id={`${person.theme === 'maya' ? 'maya' : 'that-guy'}-introduction`} class:list={['successor-divider', person.theme]}>
              <img src={person.feature} alt={person.featureAlt} loading="lazy" />
              <figcaption><span>{person.featureLabel}</span><em>{person.featureLine}</em></figcaption>
            </figure>
            <div class:list={['feature-actions', person.theme]}>
              <a class="band-gallery-link" href={`/lore/level-12-fold-15/gallery#${person.theme === 'maya' ? 'maya' : 'that-guy'}`}>Open {person.name}'s photo gallery <span>→</span></a>
              <a class="band-gallery-link music-link" href={`/lore/level-12-fold-15/music/${person.theme === 'maya' ? 'maya' : 'that-guy'}`}>Tune {person.name} on The Cosmos Radio <span>→</span></a>
            </div>
            <article id={person.theme === 'maya' ? 'maya' : 'that-guy'} class:list={['successor-record', person.theme]}>
              <div class="successor-glow" aria-hidden="true"></div>
              <a class="successor-sheet" href={person.sheet} target="_blank" rel="noopener noreferrer" aria-label={`Open ${person.name}'s full character sheet`}>
                <img src={person.sheet} alt={`${person.name} character sheet`} loading="lazy" /><span>FULL CHARACTER SHEET <b>↗</b></span>
              </a>
              <div class="successor-copy">
                <div class="profile-index"><span>{person.number}</span><b>{person.signal}</b></div>
                <h3>{person.name}</h3><p class="role">{person.role}</p><p class="bio">{person.bio}</p>
                <a class="record-link gallery-link" href={`/lore/level-12-fold-15/gallery#${person.theme === 'maya' ? 'maya' : 'that-guy'}`}>Open photo gallery <span>→</span></a>
                <a class="record-link music-record-link" href={`/lore/level-12-fold-15/music/${person.theme === 'maya' ? 'maya' : 'that-guy'}`}>Open music archive <span>→</span></a>
                {person.theme === 'maya' ? <p class="chapter-note">Fan in the crowd <i>→</i> Headline stadium era</p> : <p class="chapter-note">Break the cage <i>→</i> Real life <i>→</i> Love? <i>→</i> Consequences!</p>}
                <a class="record-link" href={person.sheet} target="_blank" rel="noopener noreferrer">Read the complete record <span>→</span></a>
              </div>
            </article>
          </section>
        ))}
      </div>
    </section>

    <section class="chapter frequency-chapter" aria-labelledby="frequency-title">
      <header class="chapter-heading">
        <div><p class="chapter-number">CHAPTER III · THE PUBLIC AIRWAVES</p><h2 id="frequency-title">The Cosmos Radio</h2></div>
        <p>Each voice keeps its own machine, its own color, and its own archive. Tune one receiver to enter the albums, lyrics, and jukebox for that artist.</p>
      </header>
      <div class="frequency-grid">
        <a class="frequency-device sparks" href="/lore/level-12-fold-15/music/crimson-sparks">
          <span class="frequency-code">01 · VACUUM-TUBE BROADCAST</span>
          <div class="radio-ui" aria-hidden="true"><i></i><b></b><b></b><b></b><b></b></div>
          <h3>The Spark Radio</h3><p>The Crimson Sparks</p><em>7 albums · enter archive →</em>
        </a>
        <a class="frequency-device maya" href="/lore/level-12-fold-15/music/maya">
          <span class="frequency-code">02 · NEON CASSETTE DECK</span>
          <div class="radio-ui" aria-hidden="true"><i></i><b></b><b></b><b></b><b></b></div>
          <h3>The Headline Receiver</h3><p>Maya</p><em>6 albums · enter archive →</em>
        </a>
        <a class="frequency-device guy" href="/lore/level-12-fold-15/music/that-guy">
          <span class="frequency-code">03 · UNAUTHORIZED OFFICE RADIO</span>
          <div class="radio-ui" aria-hidden="true"><i></i><b></b><b></b><b></b><b></b></div>
          <h3>The Breakroom Jukebox</h3><p>That Guy</p><em>1 album · enter archive →</em>
        </a>
      </div>
      <a class="all-frequencies" href="/lore/level-12-fold-15/music">Enter The Cosmos Radio <span>→</span></a>
    </section>

    <section class="closing-record">
      <p class="kicker">Level 12 · Fold 15</p><h2>The signal remains open.</h2><p>Explore the three voices, then return whenever the public record grows.</p>
      <div><a href="/lore/level-12-fold-15/music">Enter The Cosmos Radio <span>→</span></a><a href="/lore/level-12-fold-15/gallery">Enter the photo galleries <span>→</span></a><a href="/#worlds">Return to the Cosmos <span>↗</span></a></div>
    </section>
  </div>
</Layout>

<style>
  .record-page{--cream:#f3e5bd;--gold:#d9a441;--ember:#d85032;--cyan:#29d1dc;--magenta:#e253b5;--green:#62cf79;position:relative;overflow:hidden;color:#f5eddd;background:radial-gradient(circle at 12% 14%,rgba(143,33,32,.17),transparent 28rem),radial-gradient(circle at 88% 72%,rgba(14,100,88,.12),transparent 34rem),linear-gradient(180deg,rgba(5,5,10,.3),rgba(3,5,10,.78))}
  .record-page:before{content:'';position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.18;background-image:repeating-linear-gradient(0deg,transparent 0 3px,rgba(255,255,255,.035) 4px)}
  .record-hero{position:relative;display:block;overflow:hidden;isolation:isolate;border-bottom:1px solid rgba(217,164,65,.35);background:#07070c}
  .hero-voices{position:relative;z-index:-4;height:clamp(30rem,45vw,48rem);display:grid;grid-template-columns:repeat(3,minmax(0,1fr));overflow:hidden;background:#08080d}.hero-voices:before{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(0deg,#05050a 0%,rgba(5,5,10,.08) 24%,transparent 48%),linear-gradient(90deg,rgba(5,5,10,.2),transparent 12%,transparent 88%,rgba(5,5,10,.2))}
  .voice-panel{position:relative;margin:0;overflow:hidden;border-left:1px solid rgba(217,164,65,.22)}.voice-panel img{width:100%;height:100%;display:block;object-fit:cover;filter:saturate(.8) contrast(1.08) brightness(.72);transition:filter .55s ease,transform .75s ease}.voice-panel.suki img{object-position:58% 42%;transform:scale(1.04)}.voice-panel.maya img{object-position:50% 4%}.voice-panel.guy img{object-position:50% 3%}.voice-panel figcaption{position:absolute;z-index:3;right:1.1rem;top:1.2rem;color:rgba(244,225,183,.72);font:700 .56rem/1 'JetBrains Mono',monospace;letter-spacing:.18em;text-transform:uppercase}.voice-panel:hover img{filter:saturate(1) contrast(1.05) brightness(.92);transform:scale(1.035)}.voice-panel.suki:hover img{transform:scale(1.08)}
  .cosmos-radio-entry{position:relative;z-index:5;width:min(calc(100% - 3rem),1500px);margin:-1px auto 0;display:grid;grid-template-columns:auto 1fr auto;gap:1.25rem;align-items:center;padding:1.1rem 1.35rem;color:#f0e5cf;border:1px solid rgba(217,164,65,.48);background:linear-gradient(105deg,rgba(22,11,9,.98),rgba(5,8,13,.98) 55%,rgba(8,25,25,.96));box-shadow:0 22px 55px rgba(0,0,0,.42),0 0 34px rgba(217,164,65,.08);transition:transform .3s ease,border-color .3s ease,box-shadow .3s ease}.cosmos-radio-entry:hover{transform:translateY(-3px);border-color:#e3b457;box-shadow:0 28px 64px rgba(0,0,0,.52),0 0 42px rgba(217,164,65,.14)}.cosmos-radio-entry svg{width:4rem;height:4rem;padding:.45rem;color:#e0ac4f;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;border:1px solid rgba(217,164,65,.36);background:#08090c}.cosmos-radio-entry span{display:grid;gap:.2rem}.cosmos-radio-entry small{color:#d69b43;font:700 .55rem 'JetBrains Mono',monospace;letter-spacing:.14em}.cosmos-radio-entry strong{font:italic 400 clamp(1.65rem,3vw,2.8rem)/1 Georgia,serif}.cosmos-radio-entry em{color:#8f948f;font:500 .7rem 'JetBrains Mono',monospace;font-style:normal;text-transform:uppercase;letter-spacing:.06em}.cosmos-radio-entry>b{color:#e5b457;font:800 .6rem 'JetBrains Mono',monospace;letter-spacing:.12em}
  .hero-smoke{position:absolute;z-index:-2;width:42rem;height:18rem;border-radius:50%;filter:blur(60px);opacity:.24;mix-blend-mode:screen;animation:smokeDrift 13s ease-in-out infinite alternate}.smoke-a{right:6%;top:4%;background:rgba(207,69,38,.28)}.smoke-b{right:24%;bottom:4%;background:rgba(219,153,50,.17);animation-delay:-6s}
  .spark-field,.spark-field:before,.spark-field:after{position:absolute;inset:0;z-index:-1;content:'';pointer-events:none;background-image:radial-gradient(circle at 72% 18%,rgba(255,218,139,.9) 0 1px,transparent 2px),radial-gradient(circle at 82% 42%,rgba(224,89,47,.86) 0 1px,transparent 2px),radial-gradient(circle at 62% 74%,rgba(255,224,168,.8) 0 1.5px,transparent 2.5px),radial-gradient(circle at 91% 68%,rgba(255,160,70,.65) 0 1px,transparent 2px);animation:sparksRise 9s linear infinite}.spark-field:before{transform:translate(-12%,28%);animation-delay:-3s}.spark-field:after{transform:translate(7%,52%);animation-delay:-6s}
  .hero-copy{position:relative;z-index:4;width:min(100%,1600px);margin:0 auto;padding:clamp(3.5rem,6vw,6rem) clamp(1.5rem,7vw,7rem) clamp(5rem,8vw,8rem);background:radial-gradient(circle at 18% 0,rgba(183,62,35,.14),transparent 31rem),linear-gradient(180deg,#05050a 0%,#07070c 100%)}
  .record-code,.kicker,.chapter-number,.profile-index,.role,.sheet-cue,.successor-sheet>span{font-family:'JetBrains Mono',monospace;text-transform:uppercase;letter-spacing:.17em}
  .record-code{display:inline-flex;align-items:center;gap:.7rem;margin-bottom:1.4rem;color:var(--cream);font-size:.72rem}.record-code span{padding:.55rem .7rem;border:1px solid rgba(217,164,65,.65);color:#161009;background:linear-gradient(135deg,#f0d68c,#c98b2e)}
  .kicker{margin:0 0 .9rem;color:#d9ad63;font-size:.68rem;font-weight:700}
  .record-hero h1{max-width:900px;margin:0;font:900 clamp(3.4rem,7.6vw,8.2rem)/.84 'Orbitron',sans-serif;letter-spacing:-.075em;text-transform:uppercase;color:#f7f0df;text-shadow:0 18px 60px rgba(0,0,0,.78)}.record-hero h1 em{display:inline-block;margin-top:.22em;font:italic 400 .48em/1 Georgia,serif;letter-spacing:-.025em;text-transform:none;color:#e1b455}
  .hero-deck{max-width:720px;margin:1.7rem 0 0;color:#c8c2b8;font-size:clamp(.96rem,1.4vw,1.15rem);line-height:1.85}.hero-actions{display:flex;flex-wrap:wrap;gap:.7rem;margin-top:2rem}
  .hero-actions a,.closing-record a{min-height:2.9rem;display:inline-flex;align-items:center;padding:.75rem 1rem;border:1px solid rgba(217,164,65,.42);color:#ead9af;background:rgba(6,7,12,.7);font:700 .66rem/1 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase;transition:transform .25s ease,border-color .25s ease,background .25s ease}.hero-actions a:hover,.closing-record a:hover{transform:translateY(-3px);border-color:#e7b854;background:rgba(217,164,65,.12)}
  .hero-foot{position:absolute;right:clamp(1.5rem,5vw,5rem);bottom:1.5rem;display:flex;align-items:center;gap:.8rem;color:rgba(240,222,183,.62);font:700 .55rem/1 'JetBrains Mono',monospace;letter-spacing:.16em}.hero-foot b{width:2rem;height:1px;background:rgba(217,164,65,.4)}
  .transmission{padding:clamp(4rem,8vw,7rem) 1.5rem;text-align:center;border-bottom:1px solid rgba(217,164,65,.17);background:radial-gradient(circle,rgba(122,31,22,.12),transparent 65%)}.transmission h2{margin:0;font:italic 400 clamp(2rem,5vw,4.8rem)/1.05 Georgia,serif;color:var(--cream)}.transmission h2 span{color:#be5736;font-style:normal}.transmission>p:last-child{margin:1.1rem 0 0;color:#918a7e;font:italic 1rem/1.6 Georgia,serif}
  .chapter{width:min(calc(100% - 3rem),1500px);margin:0 auto;padding:clamp(5rem,9vw,9rem) 0}.chapter-heading{display:grid;grid-template-columns:minmax(0,1fr) minmax(18rem,34rem);gap:clamp(2rem,6vw,8rem);align-items:end;margin-bottom:clamp(2.5rem,5vw,5rem)}.chapter-number{margin:0 0 .8rem;color:#be8050;font-size:.64rem}.chapter-heading h2,.closing-record h2{margin:0;color:#f4ead4;font:italic 400 clamp(2.8rem,6vw,6.4rem)/.9 Georgia,serif;letter-spacing:-.045em}.chapter-heading>p{margin:0;color:#9fa3ad;font-size:.95rem;line-height:1.8}
  .group-record{position:relative;margin:0 0 1rem;overflow:hidden;border:1px solid rgba(211,146,58,.5);box-shadow:0 38px 80px rgba(0,0,0,.38),0 0 45px rgba(179,61,34,.08);background:#07070a}.group-record:before,.sheet-frame:before,.successor-sheet:before{content:'';position:absolute;inset:0;z-index:2;pointer-events:none;box-shadow:inset 0 0 0 9px rgba(0,0,0,.18),inset 0 0 0 10px rgba(224,176,78,.18)}.group-record img{width:100%;height:clamp(24rem,53vw,49rem);display:block;object-fit:cover;object-position:center 29%;filter:saturate(.85) contrast(1.05)}.group-record figcaption{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:1.4rem clamp(1.2rem,3vw,2.7rem);color:var(--cream);background:linear-gradient(90deg,rgba(4,4,7,.98),rgba(14,8,6,.83));border-top:1px solid rgba(217,164,65,.36)}.group-record figcaption span{font:800 .65rem/1 'JetBrains Mono',monospace;letter-spacing:.16em}.group-record figcaption em{color:#c9b486;font:italic 1rem/1.3 Georgia,serif}.band-gallery-link{display:inline-flex;align-items:center;gap:.8rem;margin:0 0 clamp(4rem,8vw,8rem);padding:.85rem 1rem;border:1px solid rgba(217,164,65,.42);color:#f0c66c;background:rgba(217,164,65,.07);font:700 .62rem/1.4 'JetBrains Mono',monospace;letter-spacing:.1em;text-transform:uppercase}.band-gallery-link span{transition:transform .2s ease}.band-gallery-link:hover span{transform:translateX(5px)}
  .profile-stack{display:grid;gap:clamp(4rem,8vw,8rem)}.profile-record{display:grid;grid-template-columns:minmax(0,1.62fr) minmax(18rem,.72fr);gap:clamp(2rem,5vw,5rem);align-items:center}.profile-record.reverse{grid-template-columns:minmax(18rem,.72fr) minmax(0,1.62fr)}.profile-record.reverse .sheet-frame{grid-column:2;grid-row:1}.profile-record.reverse .profile-copy{grid-column:1;grid-row:1}
  .sheet-frame,.successor-sheet{position:relative;display:block;overflow:hidden;border:1px solid rgba(217,164,65,.37);background:#06070b;box-shadow:0 32px 72px rgba(0,0,0,.4)}.sheet-frame img,.successor-sheet img{width:100%;height:auto;display:block;transition:transform .5s ease,filter .5s ease}.sheet-frame:hover img,.successor-sheet:hover img{transform:scale(1.018);filter:brightness(1.07)}.sheet-cue,.successor-sheet>span{position:absolute;z-index:3;right:.8rem;bottom:.8rem;display:flex;align-items:center;gap:.55rem;padding:.7rem .8rem;color:#f0d89f;background:rgba(4,5,8,.9);border:1px solid rgba(217,164,65,.4);font-size:.54rem}
