---
import Layout from '../layouts/Layout.astro';
import cosmosData from '../data/cosmos.json';

const { siteConfig, artists } = cosmosData;

// Group artists by Level & Fold Epochs
const level1Fold1 = artists.filter(a => a.id === 'pandora-raven' || a.id === 'elara-dawn' || a.id === 'solara');
const level8Fold39 = artists.filter(a => a.id === 'defective-detective');
const level12Fold15 = artists.filter(a => a.id === 'crimson-sparks' || a.id === 'maya' || a.id === 'that-guy');
const level15Fold15 = artists.filter(a => a.id === 'prima-timo');

// Helper: dynamic border color mapping on hover
const getArtistGlow = (artistId: string) => {
  if (artistId === 'pandora-raven') return 'hover:border-purple-500/80 hover:shadow-[0_0_30px_rgba(147,51,234,0.3)]';
  if (artistId === 'elara-dawn') return 'hover:border-amber-500/80 hover:shadow-[0_0_30px_rgba(245,158,11,0.3)]';
  if (artistId === 'crimson-sparks') return 'hover:border-red-500/80 hover:shadow-[0_0_30px_rgba(239,68,68,0.3)]';
  if (artistId === 'maya') return 'hover:border-cyan-500/80 hover:shadow-[0_0_30px_rgba(6,182,212,0.3)]';
  if (artistId === 'that-guy') return 'hover:border-emerald-500/80 hover:shadow-[0_0_30px_rgba(16,185,129,0.3)]';
  if (artistId === 'prima-timo') return 'hover:border-teal-500/80 hover:shadow-[0_0_30px_rgba(20,184,166,0.3)]';
  if (artistId === 'solara') return 'hover:border-indigo-500/80 hover:shadow-[0_0_30px_rgba(99,102,241,0.3)]';
  if (artistId === 'defective-detective') return 'hover:border-sky-400/80 hover:shadow-[0_0_30px_rgba(56,189,248,0.3)]';
  return 'hover:border-purple-500/80 hover:shadow-[0_0_30px_rgba(147,51,234,0.3)]';
};

const getArtistPill = (artistId: string) => {
  if (artistId === 'pandora-raven') return 'bg-purple-900 text-purple-100 border-purple-700 shadow-md';
  if (artistId === 'elara-dawn') return 'bg-amber-900 text-amber-100 border-amber-600 shadow-md';
  if (artistId === 'crimson-sparks') return 'bg-red-950 text-red-100 border-red-800 shadow-md';
  if (artistId === 'maya') return 'bg-cyan-950 text-cyan-100 border-cyan-800 shadow-md';
  if (artistId === 'that-guy') return 'bg-emerald-900 text-emerald-100 border-emerald-700 shadow-md';
  if (artistId === 'prima-timo') return 'bg-teal-900 text-teal-100 border-teal-700 shadow-md';
  if (artistId === 'solara') return 'bg-indigo-900 text-indigo-100 border-indigo-700 shadow-md';
  if (artistId === 'defective-detective') return 'bg-sky-950 text-sky-100 border-sky-700 shadow-md';
  return 'bg-purple-900 text-purple-100 border-purple-700 shadow-md';
};

const getArtistBackgroundPhoto = (artistId: string) => {
  if (artistId === 'pandora-raven') return '/images/artists/pandora-box.jpg';
  if (artistId === 'elara-dawn') return '/images/artists/elara-box.jpg';
  if (artistId === 'crimson-sparks') return '/images/artists/the-crimson-sparks.jpg';
  if (artistId === 'prima-timo') return '/images/artists/prime-and-timo.jpg';
  if (artistId === 'solara') return '/images/artists/Solara.jpg';
  if (artistId === 'defective-detective') return '/images/artists/the_defective_detective_02.jpg';
  return `/images/artists/${artistId}.jpg`;
};

const getArtistImageClass = (artistId: string) => {
  if (artistId === 'that-guy') return 'scale-105 group-hover:scale-100 object-[center_20%]';
  if (artistId === 'elara-dawn') return 'scale-[1.2] group-hover:scale-[1.15] object-[center_35%]';
  if (artistId === 'maya') return 'scale-105 group-hover:scale-100 object-[center_30%]';
  if (artistId === 'pandora-raven') return 'scale-105 group-hover:scale-100 object-[center_20%]';
  if (artistId === 'solara') return 'scale-105 group-hover:scale-100 object-[center_15%]';
  if (artistId === 'crimson-sparks') return 'scale-105 group-hover:scale-100 object-[center_20%]';
  return 'scale-105 group-hover:scale-100 object-center';
};

const getArtistFontClass = (artistId: string) => {
  if (artistId === 'pandora-raven') return 'font-serif italic tracking-widest text-purple-200 drop-shadow-[0_0_10px_rgba(168,85,247,0.4)]';
  if (artistId === 'elara-dawn') return 'font-serif tracking-widest text-amber-200 drop-shadow-[0_0_10px_rgba(245,158,11,0.4)]';
  if (artistId === 'crimson-sparks') return 'font-sans font-black tracking-wider text-red-500 uppercase';
  if (artistId === 'maya') return 'font-sans font-black tracking-widest text-cyan-400 uppercase';
  if (artistId === 'that-guy') return 'font-mono font-extrabold tracking-tighter text-emerald-400 uppercase';
  if (artistId === 'prima-timo') return 'font-mono tracking-widest text-teal-400 uppercase';
  if (artistId === 'solara') return 'font-serif italic tracking-widest text-indigo-300 uppercase';
  if (artistId === 'defective-detective') return 'font-mono font-black tracking-wide text-sky-200 uppercase';
  return 'font-sans font-extrabold tracking-widest text-white';
};
---

<Layout title="Roster & Factions">
  <!-- Hero Section -->
  <section class="relative py-20 px-6 max-w-5xl mx-auto text-center overflow-hidden">
    <div class="absolute inset-0 -z-10 flex items-center justify-center">
      <div class="w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-3xl"></div>
      <div class="w-[300px] h-[300px] bg-amber-500/10 rounded-full blur-3xl"></div>
    </div>

    <span class="text-xs uppercase tracking-widest font-bold text-purple-400 bg-purple-950/60 border border-purple-800/50 px-4 py-1.5 rounded-full font-mono shadow-md">
      620+ Tracks Active Across 4 Multiversal Epochs
    </span>

    <h1 class="mt-6 text-4xl md:text-6xl font-black tracking-tight leading-tight font-orbitron">
      The Official Roster & <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300 bg-clip-text text-transparent">Ecosystem Artists</span>
    </h1>

    <p class="mt-4 text-slate-400 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
      In the Cosmos, every artist anchors a distinct emotional thesis within their Level and Fold. Explore our 8 core acts grouped by their multiversal era below.
    </p>
  </section>

  <!-- EPOCH SECTIONS CONTAINER -->
  <section class="max-w-6xl mx-auto px-6 pb-24 space-y-16">

    <!-- ========================================== -->
    <!-- EPOCH 1: LEVEL 1 FOLD 1 (CELESTIAL ORIGIN) -->
    <!-- ========================================== -->
    <div class="space-y-6">
      <!-- Section Header Banner with Image Backdrop -->
      <div class="relative overflow-hidden rounded-3xl border border-purple-900/60 bg-slate-950 p-8 shadow-[0_0_50px_rgba(147,51,234,0.15)]">
        <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
          <img 
            src="/images/artists/Solara.jpg" 
            alt="" 
            class="w-full h-full object-cover opacity-[0.28] filter brightness-135 scale-105 object-[center_15%]"
            style="mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0) 100%);"
          />
        </div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-purple-950 text-purple-200 border border-purple-700 shadow-md">
                LEVEL 1 FOLD 1 (1_1)
              </span>
              <span class="text-[10px] font-mono uppercase bg-slate-900 text-slate-300 border border-slate-750 px-2.5 py-1 rounded-full">
                Celestial Origin Plane &bull; 300,000 YA — Present
              </span>
            </div>
            <h2 class="text-2xl md:text-3xl font-black font-orbitron text-purple-300">
              The Celestial Origin & Twin-Flame Convergence
            </h2>
            <p class="text-xs md:text-sm text-slate-300 max-w-3xl font-light leading-relaxed">
              The primordial plane where Ra blessed the union of Time & Fate, giving birth to Pandora Raven and Elara Dawn. Separated across dimensions, they march toward the Album 9 Convergence as Solara.
            </p>
          </div>
        </div>
      </div>

      <!-- Level 1 Fold 1 Grid (3 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {level1Fold1.map((artist) => (
          <div 
            class={`group relative w-full h-[420px] rounded-3xl overflow-hidden bg-black border border-slate-900 flex flex-col justify-between p-7 transition-all duration-300 ${getArtistGlow(artist.id)}`}
          >
            <!-- 1. Faded Portrait Background Layer -->
            <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden rounded-3xl">
              <img 
                src={getArtistBackgroundPhoto(artist.id)} 
                alt="" 
                class={`absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-[0.72] filter brightness-[1.35] group-hover:brightness-[1.45] transition-all duration-750 ${getArtistImageClass(artist.id)}`}
                style="mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%);"
                onerror="this.style.display='none'"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/60 to-black z-10 md:hidden"></div>
            </div>

            <!-- 2. Canvas Background Animation Layer -->
            <canvas 
              data-canvas-artist={artist.id} 
              class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-70 group-hover:opacity-100 transition-opacity duration-300"
            ></canvas>

            <!-- 3. Absolute Hidden Link Overlay -->
            <a 
              href={`/music/${artist.id}`} 
              class="absolute inset-0 z-20 pointer-events-auto"
              aria-label={`Enter space for ${artist.name}`}
            ></a>

            <!-- 4. Foreground Content -->
            <div class="relative z-30 flex flex-col justify-end h-full w-full pointer-events-none">
              <!-- Bottom Row: Title & Bio -->
              <div class="w-full text-center flex flex-col items-center justify-end mt-auto pointer-events-none select-none">
                <h3 class={`text-2xl md:text-3xl font-black leading-tight group-hover:scale-[1.01] transition-transform duration-500 ${getArtistFontClass(artist.id)}`}>
                  {artist.name}
                </h3>
                <p class="text-[11px] text-slate-400 font-sans tracking-wide leading-relaxed mt-2.5">
                  {artist.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ========================================== -->
    <!-- EPOCH 2: LEVEL 8 FOLD 39 (NOIR MYSTERY)    -->
    <!-- ========================================== -->
    <div class="space-y-6">
      <div class="relative overflow-hidden rounded-3xl border border-sky-900/60 bg-slate-950 p-8 shadow-[0_0_50px_rgba(56,189,248,0.12)]">
        <div class="absolute inset-0 -z-10 pointer-events-none bg-[radial-gradient(circle_at_top_right,rgba(56,189,248,0.12),transparent_45%)]"></div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-sky-950 text-sky-200 border border-sky-700 shadow-md">
                LEVEL 8 FOLD 39 (8_39)
              </span>
              <span class="text-[10px] font-mono uppercase bg-slate-900 text-slate-300 border border-slate-700 px-2.5 py-1 rounded-full">
                Noir Mystery Plane &bull; Investigations in Progress
              </span>
            </div>
            <h2 class="text-2xl md:text-3xl font-black font-orbitron text-sky-300">
              The Defective Detective
            </h2>
            <p class="text-xs md:text-sm text-slate-300 max-w-3xl font-light leading-relaxed">
              Serah Solves operates beyond a corrupt system in a world of private investigation, mystical creatures, institutional dysfunction, and answers that create larger questions.
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 gap-6">
        {level8Fold39.map((artist) => (
          <div
            data-detective-card
            class={`detective-card group relative w-full h-[420px] rounded-3xl overflow-hidden bg-black border border-slate-900 flex flex-col justify-between p-8 transition-all duration-300 ${getArtistGlow(artist.id)}`}
          >
            <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden rounded-3xl">
              <img
                src={getArtistBackgroundPhoto(artist.id)}
                alt=""
                class="absolute inset-0 w-full h-full object-cover object-center opacity-35 blur-xl scale-110 filter brightness-125 transition-all duration-700"
                aria-hidden="true"
              />
              <img
                src={getArtistBackgroundPhoto(artist.id)}
                alt="The Defective Detective ensemble"
                class="absolute inset-0 w-full h-full object-contain object-center opacity-95 group-hover:opacity-100 filter brightness-125 group-hover:brightness-135 transition-all duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/20 to-transparent"></div>
            </div>

            <canvas
              data-canvas-artist={artist.id}
              class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-70 group-hover:opacity-100 transition-opacity duration-300"
            ></canvas>

            <div
              data-detective-lens
              data-magnifier-image={getArtistBackgroundPhoto(artist.id)}
              class="detective-lens absolute z-20 pointer-events-none"
              aria-hidden="true"
            ></div>

            <a
              href={`/music/${artist.id}`}
              class="absolute inset-0 z-30 pointer-events-auto"
              aria-label={`Enter space for ${artist.name}`}
            ></a>

            <div class="relative z-40 flex flex-col justify-end h-full w-full pointer-events-none">
              <div class="w-full text-center flex flex-col items-center justify-end mt-auto pointer-events-none select-none">
                <h3 class={`text-3xl md:text-4xl font-black leading-tight group-hover:scale-[1.01] transition-transform duration-500 ${getArtistFontClass(artist.id)}`}>
                  {artist.name}
                </h3>
                <p class="text-xs md:text-sm text-slate-400 font-sans tracking-wide leading-relaxed mt-2.5 max-w-2xl">
                  {artist.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ========================================== -->
    <!-- EPOCH 3: LEVEL 12 FOLD 15 (INDIE & POP ERA)-->
    <!-- ========================================== -->
    <div class="space-y-6">
      <!-- Section Header Banner with Image Backdrop -->
      <div class="relative overflow-hidden rounded-3xl border border-red-900/60 bg-slate-950 p-8 shadow-[0_0_50px_rgba(239,68,68,0.15)]">
        <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
          <img 
            src="/images/artists/the-crimson-sparks.jpg" 
            alt="" 
            class="w-full h-full object-cover opacity-[0.28] filter brightness-135 scale-105 object-[center_35%]"
            style="mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0) 100%);"
          />
        </div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-red-950 text-red-200 border border-red-700 shadow-md">
                LEVEL 12 FOLD 15 (12_15)
              </span>
              <span class="text-[10px] font-mono uppercase bg-slate-900 text-slate-300 border border-slate-750 px-2.5 py-1 rounded-full">
                Indie Rock & Stadium Pop Era &bull; Modern Era
              </span>
            </div>
            <h2 class="text-2xl md:text-3xl font-black font-orbitron text-red-400">
              The Musical Revolution & Stadium Pop Legends
            </h2>
            <p class="text-xs md:text-sm text-slate-300 max-w-3xl font-light leading-relaxed">
              The vibrant era where raw underground ska-punk transforms into stadium pop. The Crimson Sparks ignite the movement, Maya inherits the legacy guitar, and That Guy breaks cages against corporate chains.
            </p>
          </div>
        </div>
      </div>

      <!-- Level 12 Fold 15 Grid (3 Columns) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {level12Fold15.map((artist) => (
          <div 
            class={`group relative w-full h-[420px] rounded-3xl overflow-hidden bg-black border border-slate-900 flex flex-col justify-between p-7 transition-all duration-300 ${getArtistGlow(artist.id)}`}
          >
            <!-- 1. Faded Portrait Background Layer -->
            <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden rounded-3xl">
              <img 
                src={getArtistBackgroundPhoto(artist.id)} 
                alt="" 
                class={`absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-[0.72] filter brightness-[1.35] group-hover:brightness-[1.45] transition-all duration-750 ${getArtistImageClass(artist.id)}`}
                style="mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%);"
                onerror="this.style.display='none'"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/60 to-black z-10 md:hidden"></div>
            </div>

            <!-- 2. Canvas Background Animation Layer -->
            <canvas 
              data-canvas-artist={artist.id} 
              class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-70 group-hover:opacity-100 transition-opacity duration-300"
            ></canvas>

            <!-- 3. Absolute Hidden Link Overlay -->
            <a 
              href={`/music/${artist.id}`} 
              class="absolute inset-0 z-20 pointer-events-auto"
              aria-label={`Enter space for ${artist.name}`}
            ></a>

            <!-- 4. Foreground Content -->
            <div class="relative z-30 flex flex-col justify-end h-full w-full pointer-events-none">
              <!-- Bottom Row: Title & Bio -->
              <div class="w-full text-center flex flex-col items-center justify-end mt-auto pointer-events-none select-none">
                <h3 class={`text-2xl md:text-3xl font-black leading-tight group-hover:scale-[1.01] transition-transform duration-500 ${getArtistFontClass(artist.id)}`}>
                  {artist.name}
                </h3>
                <p class="text-[11px] text-slate-400 font-sans tracking-wide leading-relaxed mt-2.5">
                  {artist.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- ========================================== -->
    <!-- EPOCH 4: LEVEL 15 FOLD 15 (SCAVENGER ERA)  -->
    <!-- ========================================== -->
    <div class="space-y-6">
      <!-- Section Header Banner with Image Backdrop -->
      <div class="relative overflow-hidden rounded-3xl border border-teal-900/60 bg-slate-950 p-8 shadow-[0_0_50px_rgba(20,184,166,0.15)]">
        <div class="absolute inset-0 -z-10 pointer-events-none overflow-hidden">
          <img 
            src="/images/artists/prime-and-timo.jpg" 
            alt="" 
            class="w-full h-full object-cover opacity-[0.28] filter brightness-135 scale-105 object-[center_35%]"
            style="mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0.5) 50%, rgba(0,0,0,0) 100%);"
          />
        </div>
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="px-3 py-1 rounded-full text-[10px] font-mono font-bold bg-teal-950 text-teal-200 border border-teal-700 shadow-md">
                LEVEL 15 FOLD 15 (15_15)
              </span>
              <span class="text-[10px] font-mono uppercase bg-slate-900 text-slate-300 border border-slate-750 px-2.5 py-1 rounded-full">
                Scavenger Plane & Wasteland Sanctuary &bull; Wasteland Era
              </span>
            </div>
            <h2 class="text-2xl md:text-3xl font-black font-orbitron text-teal-300">
              The Scavenger End Game & Primatown Sanctuary
            </h2>
            <p class="text-xs md:text-sm text-slate-300 max-w-3xl font-light leading-relaxed">
              The post-collapse scrap dunes where an Awakened Machine (Core 2) and Scavenger Boy (Core 1) build Primatown, rescue discarded machines, and prepare for Solara's arrival at Gate 17.
            </p>
          </div>
        </div>
      </div>

      <!-- Level 15 Fold 15 Grid (Hero Card) -->
      <div class="grid grid-cols-1 gap-6">
        {level15Fold15.map((artist) => (
          <div 
            class={`group relative w-full h-[420px] rounded-3xl overflow-hidden bg-black border border-slate-900 flex flex-col justify-between p-8 transition-all duration-300 ${getArtistGlow(artist.id)}`}
          >
            <!-- 1. Faded Portrait Background Layer -->
            <div class="absolute inset-0 z-0 pointer-events-none select-none overflow-hidden rounded-3xl">
              <img 
                src={getArtistBackgroundPhoto(artist.id)} 
                alt="" 
                class={`absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-[0.72] filter brightness-[1.35] group-hover:brightness-[1.45] transition-all duration-750 ${getArtistImageClass(artist.id)}`}
                style="mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%); -webkit-mask-image: linear-gradient(to right, rgba(0,0,0,0) 0%, rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%);"
                onerror="this.style.display='none'"
              />
              <div class="absolute inset-0 bg-gradient-to-b from-transparent via-black/60 to-black z-10 md:hidden"></div>
            </div>

            <!-- 2. Canvas Background Animation Layer -->
            <canvas 
              data-canvas-artist={artist.id} 
              class="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-70 group-hover:opacity-100 transition-opacity duration-300"
            ></canvas>

            <!-- 3. Absolute Hidden Link Overlay -->
            <a 
              href={`/music/${artist.id}`} 
              class="absolute inset-0 z-20 pointer-events-auto"
              aria-label={`Enter space for ${artist.name}`}
            ></a>

            <!-- 4. Foreground Content -->
            <div class="relative z-30 flex flex-col justify-end h-full w-full pointer-events-none">
              <!-- Bottom Row: Title & Bio -->
              <div class="w-full text-center flex flex-col items-center justify-end mt-auto pointer-events-none select-none">
                <h3 class={`text-3xl md:text-4xl font-black leading-tight group-hover:scale-[1.01] transition-transform duration-500 ${getArtistFontClass(artist.id)}`}>
                  {artist.name}
                </h3>
                <p class="text-xs md:text-sm text-slate-400 font-sans tracking-wide leading-relaxed mt-2.5 max-w-2xl">
                  {artist.description}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </section>
</Layout>

<style>
  /* Infinite Marquee Loop animation */
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    display: flex;
    width: 200%;
    animation: marquee 25s linear infinite;
  }

  .detective-lens {
    width: 156px;
    height: 156px;
    border-radius: 9999px;
    border: 4px solid rgba(186, 230, 253, 0.95);
    background-repeat: no-repeat;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.82);
    transition: opacity 140ms ease, transform 140ms ease;
    box-shadow:
      0 0 0 2px rgba(2, 132, 199, 0.72),
      0 12px 34px rgba(0, 0, 0, 0.75),
      0 0 28px rgba(56, 189, 248, 0.42),
      inset 0 0 24px rgba(255, 255, 255, 0.16);
  }

  .detective-lens::after {
    content: '';
    position: absolute;
    width: 62px;
    height: 14px;
    right: -46px;
    bottom: -25px;
    border: 3px solid rgba(186, 230, 253, 0.95);
    border-left: 0;
    border-radius: 0 9999px 9999px 0;
    background: linear-gradient(90deg, rgba(7, 89, 133, 0.98), rgba(15, 23, 42, 0.98));
    transform: rotate(45deg);
    transform-origin: left center;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.55);
  }

  .detective-card.is-investigating .detective-lens {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .detective-card,
    .detective-card a {
      cursor: none;
    }
  }
</style>

<script is:inline>
  // High-performance canvas animators inside each card container
  document.addEventListener('DOMContentLoaded', () => {
    const canUseMagnifier = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const detectiveCard = document.querySelector('[data-detective-card]');
    const detectiveLens = detectiveCard?.querySelector('[data-detective-lens]');
    const detectiveImage = detectiveCard?.querySelector('img');

    if (canUseMagnifier && detectiveCard && detectiveLens && detectiveImage) {
      const zoom = 2.15;
      const lensSize = 156;
      const lensRadius = lensSize / 2;
      const magnifierImage = detectiveLens.getAttribute('data-magnifier-image');

      detectiveLens.style.backgroundImage = `url("${magnifierImage}")`;

      const moveLens = (event) => {
        const rect = detectiveCard.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const naturalWidth = detectiveImage.naturalWidth || 1792;
        const naturalHeight = detectiveImage.naturalHeight || 1008;
        const coverScale = Math.max(rect.width / naturalWidth, rect.height / naturalHeight);
        const renderedWidth = naturalWidth * coverScale;
        const renderedHeight = naturalHeight * coverScale;
        const cropX = (renderedWidth - rect.width) / 2;
        const cropY = (renderedHeight - rect.height) / 2;

        detectiveLens.style.left = `${x}px`;
        detectiveLens.style.top = `${y}px`;
        detectiveLens.style.backgroundSize = `${renderedWidth * zoom}px ${renderedHeight * zoom}px`;
        detectiveLens.style.backgroundPosition = `${lensRadius - (x + cropX) * zoom}px ${lensRadius - (y + cropY) * zoom}px`;
      };

      detectiveCard.addEventListener('mouseenter', (event) => {
        detectiveCard.classList.add('is-investigating');
        moveLens(event);
      });
      detectiveCard.addEventListener('mousemove', moveLens);
      detectiveCard.addEventListener('mouseleave', () => {
        detectiveCard.classList.remove('is-investigating');
      });
    }

    const canvases = document.querySelectorAll('canvas[data-canvas-artist]');
    
    canvases.forEach(canvas => {
      const artistId = canvas.getAttribute('data-canvas-artist');
      const ctx = canvas.getContext('2d');
      let animationFrameId = null;
      let width = 0;
      let height = 0;
      
      // Mouse coordinates relative to card
      let mouseX = -9999;
      let mouseY = -9999;
      let isHovering = false;
      
      const parent = canvas.parentElement;

      // Mouse Listeners
      parent.addEventListener('mousemove', (e) => {
        const rect = parent.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });
      parent.addEventListener('mouseenter', () => {
        isHovering = true;
      });
      parent.addEventListener('mouseleave', () => {
        isHovering = false;
        mouseX = -9999;
        mouseY = -9999;
      });

      // Resize function
      const resize = () => {
        const rect = parent.getBoundingClientRect();
        width = canvas.width = rect.width;
        height = canvas.height = rect.height;
      };
      
      resize();
      window.addEventListener('resize', resize);

      // PARTICLE ENGINE SYSTEM CONFIGS PER ARTIST
      let particles = [];
      let extraTimer = 0;

      // Initialize structures
      if (artistId === 'crimson-sparks') {
        // Sparks initial
        for (let i = 0; i < 40; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.2) * 2 + 1, // shoot left to right
            vy: (Math.random() - 0.5) * 1,
            size: Math.random() * 2.5 + 0.5,
            color: Math.random() > 0.4 ? '#f97316' : '#ef4444', // Orange/Red sparks
            life: Math.random() * 60 + 30
          });
        }
      } else if (artistId === 'pandora-raven') {
        // Shadow fog/sun orbits
        for (let i = 0; i < 60; i++) {
          const side = Math.random() > 0.5 ? 'left' : 'right';
          particles.push({
            x: side === 'left' ? Math.random() * (width / 2) : (width / 2) + Math.random() * (width / 2),
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            size: Math.random() * 20 + 10,
            alpha: Math.random() * 0.3 + 0.1,
            side: side
          });
        }
      } else if (artistId === 'elara-dawn') {
        // Solar grid shield
        for (let i = 0; i < 30; i++) {
          particles.push({
            angle: Math.random() * Math.PI * 2,
            radius: Math.random() * 120 + 30,
            speed: (Math.random() * 0.01 + 0.003) * (Math.random() > 0.5 ? 1 : -1),
            size: Math.random() * 3 + 1
          });
        }
      } else if (artistId === 'that-guy') {
        // Glitch Matrix characters
        for (let i = 0; i < 25; i++) {
          particles.push({
            x: (width / 25) * i + Math.random() * 10,
            y: Math.random() * -height,
            speed: Math.random() * 2.5 + 1.5,
            char: String.fromCharCode(33 + Math.floor(Math.random() * 93))
          });
        }
      } else if (artistId === 'maya') {
        // Equalizer wave values
        for (let i = 0; i < 50; i++) {
          particles.push({
            x: (width / 50) * i,
            targetAmp: Math.random() * 40 + 5,
            currentAmp: 5,
            speed: Math.random() * 0.1 + 0.05
          });
        }
      } else if (artistId === 'prima-timo') {
        // Radar Sweep
        extraTimer = 0; // Sweep angle
        // Targets
        for (let i = 0; i < 6; i++) {
          particles.push({
            x: Math.random() * (width - 100) + 50,
            y: Math.random() * (height - 100) + 50,
            active: false,
            intensity: 0
          });
        }
      } else if (artistId === 'solara') {
        // Convergence pull particles
        for (let i = 0; i < 50; i++) {
          const angle = Math.random() * Math.PI * 2;
          const radius = Math.random() * 150 + 50;
          particles.push({
            x: width / 2 + Math.cos(angle) * radius,
            y: height / 2 + Math.sin(angle) * radius,
            angle: angle,
            radius: radius,
            speed: Math.random() * 0.02 + 0.005,
            size: Math.random() * 2 + 0.5,
            color: Math.random() > 0.5 ? '#a855f7' : '#f59e0b'
          });
        }
      }

      // LOOP ANIMATOR
      const loop = () => {
        ctx.clearRect(0, 0, width, height);

        // 1. CRIMSON SPARKS: Sparkler trail
        if (artistId === 'crimson-sparks') {
          // Add new sparks
          if (isHovering && mouseX > -999) {
            // Emits from cursor
            for (let j = 0; j < 3; j++) {
              particles.push({
                x: mouseX,
                y: mouseY,
                vx: (Math.random() - 0.4) * 6 + 2,
                vy: (Math.random() - 0.5) * 6,
                size: Math.random() * 3 + 1,
                color: Math.random() > 0.4 ? '#f59e0b' : '#ef4444',
                life: Math.random() * 40 + 20
              });
            }
          } else {
            // Shoots from left edge
            if (Math.random() > 0.5) {
              particles.push({
                x: 0,
                y: height / 2 + (Math.random() - 0.5) * 50,
                vx: Math.random() * 4 + 4,
                vy: (Math.random() - 0.5) * 3,
                size: Math.random() * 3 + 1,
                color: '#f59e0b',
                life: Math.random() * 60 + 40
              });
            }
          }

          // Update & Draw sparks
          for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.life--;

            // Draw line trails
            ctx.beginPath();
            ctx.strokeStyle = p.color;
            ctx.lineWidth = p.size;
            ctx.lineCap = 'round';
            ctx.moveTo(p.x - p.vx * 2, p.y - p.vy * 2);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();

            if (p.life <= 0 || p.x > width || p.y < 0 || p.y > height) {
              particles.splice(i, 1);
            }
          }
        }

        // 2. PANDORA RAVEN: Swirling Purple/Gold mist
        else if (artistId === 'pandora-raven') {
          particles.forEach(p => {
            // Swirl behavior on mouse hover
            if (isHovering && mouseX > -999) {
              const dx = mouseX - p.x;
              const dy = mouseY - p.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 150) {
                p.vx += (dy / dist) * 0.05 * (p.side === 'left' ? 1 : -1);
                p.vy -= (dx / dist) * 0.05 * (p.side === 'left' ? 1 : -1);
              }
            }
            
            p.x += p.vx;
            p.y += p.vy;

            // Bounce check inside side boundaries
            if (p.side === 'left') {
              if (p.x < 0 || p.x > width / 2) p.vx *= -1;
            } else {
              if (p.x < width / 2 || p.x > width) p.vx *= -1;
            }
            if (p.y < 0 || p.y > height) p.vy *= -1;

            // Draw gradient glowing circles
            ctx.beginPath();
            const radG = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
            if (p.side === 'left') {
              radG.addColorStop(0, `rgba(147, 51, 234, ${p.alpha})`);
              radG.addColorStop(1, 'rgba(147, 51, 234, 0)');
            } else {
              radG.addColorStop(0, `rgba(245, 158, 11, ${p.alpha * 0.8})`);
              radG.addColorStop(1, 'rgba(245, 158, 11, 0)');
            }
            ctx.fillStyle = radG;
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();
          });
        }

        // 3. ELARA DAWN: Concentric sun-shield radar grid
        else if (artistId === 'elara-dawn') {
          const cx = isHovering && mouseX > -999 ? mouseX : width / 2;
          const cy = isHovering && mouseY > -999 ? mouseY : height / 2;

          // Draw orbital lines
          ctx.strokeStyle = 'rgba(245, 158, 11, 0.08)';
          ctx.lineWidth = 1;
          for (let r = 40; r < 200; r += 40) {
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.stroke();
          }

          // Draw rotating orbital satellites
          particles.forEach(p => {
            p.angle += p.speed;
            const px = cx + Math.cos(p.angle) * p.radius;
            const py = cy + Math.sin(p.angle) * p.radius;

            ctx.beginPath();
            ctx.fillStyle = 'rgba(245, 158, 11, 0.6)';
            ctx.arc(px, py, p.size, 0, Math.PI * 2);
            ctx.fill();
            
            // Subtle glow tail
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(245, 158, 11, 0.15)';
            ctx.lineWidth = p.size;
            ctx.moveTo(px - Math.cos(p.angle + p.speed) * 10, py - Math.sin(p.angle + p.speed) * 10);
            ctx.lineTo(px, py);
            ctx.stroke();
          });
        }

        // 4. THAT GUY: Matrix Code Glitched Rain
        else if (artistId === 'that-guy') {
          ctx.fillStyle = 'rgba(16, 185, 129, 0.6)';
          ctx.font = '10px monospace';

          particles.forEach(p => {
            // Draw random glitch line
            if (isHovering && Math.random() > 0.96) {
              ctx.fillStyle = 'rgba(16, 185, 129, 0.9)';
              ctx.fillText(String.fromCharCode(33 + Math.floor(Math.random() * 93)), p.x, p.y + Math.random() * 20);
            }

            ctx.fillText(p.char, p.x, p.y);
            p.y += p.speed * (isHovering ? 2.5 : 1);

            if (p.y > height) {
              p.y = -20;
              p.speed = Math.random() * 2.5 + 1.5;
            }
            if (Math.random() > 0.95) {
              p.char = String.fromCharCode(33 + Math.floor(Math.random() * 93));
            }
          });
        }

        // 5. MAYA: Audio visualizer waves
        else if (artistId === 'maya') {
          ctx.strokeStyle = 'rgba(6, 182, 212, 0.25)';
          ctx.lineWidth = 4;
          ctx.lineCap = 'round';

          particles.forEach((p, idx) => {
            // Target amplitude moves
            if (Math.random() > 0.9) {
              p.targetAmp = Math.random() * (isHovering ? 70 : 35) + 5;
            }
            p.currentAmp += (p.targetAmp - p.currentAmp) * p.speed;

            // Draw cyan bar
            ctx.beginPath();
            ctx.strokeStyle = idx % 2 === 0 ? 'rgba(6, 182, 212, 0.3)' : 'rgba(236, 72, 153, 0.3)';
            ctx.moveTo(p.x, height / 2 - p.currentAmp / 2);
            ctx.lineTo(p.x, height / 2 + p.currentAmp / 2);
            ctx.stroke();
          });
        }

        // 6. PRIMA & TIMO: Circular scan radar scope
        else if (artistId === 'prima-timo') {
          const rx = width / 2;
          const ry = height / 2;
          const maxRadius = Math.min(width, height) / 2.2;

          extraTimer += 0.015; // Radar sweep angle

          // Draw radar circle grids
          ctx.strokeStyle = 'rgba(20, 184, 166, 0.08)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(rx, ry, maxRadius, 0, Math.PI * 2);
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(rx, ry, maxRadius / 2, 0, Math.PI * 2);
          ctx.stroke();

          // Radar sweep line
          const sx = rx + Math.cos(extraTimer) * maxRadius;
          const sy = ry + Math.sin(extraTimer) * maxRadius;
          ctx.strokeStyle = 'rgba(20, 184, 166, 0.2)';
          ctx.beginPath();
          ctx.moveTo(rx, ry);
          ctx.lineTo(sx, sy);
          ctx.stroke();

          // Highlight target dots when swept
          particles.forEach(p => {
            const dx = p.x - rx;
            const dy = p.y - ry;
            const angle = Math.atan2(dy, dx);
            
            // Check if sweep line is close to target angle
            let diff = Math.abs(angle - (extraTimer % (Math.PI * 2)));
            if (diff > Math.PI) diff = Math.PI * 2 - diff;

            if (diff < 0.15) {
              p.active = true;
              p.intensity = 1.0;
            }

            if (p.active) {
              p.intensity -= 0.01;
              if (p.intensity <= 0) p.active = false;
            }

            if (p.active) {
              ctx.beginPath();
              ctx.fillStyle = `rgba(249, 115, 22, ${p.intensity})`; // Orange coordinates
              ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
              ctx.fill();
              
              // Target coordinate tag
              ctx.fillStyle = `rgba(20, 184, 166, ${p.intensity * 0.6})`;
              ctx.font = '8px monospace';
              ctx.fillText(`[X:${Math.floor(p.x)} Y:${Math.floor(p.y)}]`, p.x + 8, p.y + 2);
            }
          });
        }

        // 7. SOLARA: Celestial Convergence Spiral
        else if (artistId === 'solara') {
          const cx = width / 2;
          const cy = height / 2;

          particles.forEach(p => {
            p.angle -= p.speed;
            p.radius -= 0.3 * (isHovering ? 2.5 : 1); // pull toward center

            if (p.radius <= 5) {
              p.radius = Math.random() * 150 + 50;
              p.angle = Math.random() * Math.PI * 2;
            }

            const px = cx + Math.cos(p.angle) * p.radius;
            const py = cy + Math.sin(p.angle) * p.radius;

            ctx.beginPath();
            ctx.fillStyle = p.color;
            ctx.arc(px, py, p.size, 0, Math.PI * 2);
            ctx.fill();
          });
        }

        // Keep looping
        animationFrameId = requestAnimationFrame(loop);
      };

      // Intersection Observer to prevent offscreen rendering
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            loop();
          } else {
            cancelAnimationFrame(animationFrameId);
          }
        });
      }, { threshold: 0.1 });

      observer.observe(parent);
    });
  });
</script>
