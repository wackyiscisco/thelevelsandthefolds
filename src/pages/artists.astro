---
import Layout from '../layouts/Layout.astro';
import cosmosData from '../data/cosmos.json';

const { siteConfig } = cosmosData;

const roster = [
  {
    id: "crimson-sparks",
    name: "The Crimson Sparks",
    levelFold: "Level 12 • Fold 15",
    badgeColor: "border-red-800 text-red-300 bg-red-950",
    status: "Legendary Era (Retired)",
    tagline: "Spark → Fire → Crash → Ignite → Movement → Wildfire → Embers",
    bio: "Five musicians who turned observation, loss, and raw passion into a global movement. Their journey was never about fame or awards—it was about transmission: passing a spark forward until it belonged to everyone.",
    lineup: [
      "Suki Moreau (Vocals & Songwriter) — The observer and narrative center.",
      "Soren Crane (Bass & Co-Founder) — The silent, wise mentor who values integrity over corporate deals.",
      "Sky Delacroix (Lead Guitar) — Chaotic creative energy who plays with raw passion.",
      "Sol Kovic (Drums) — Self-taught drummer bringing ska-punk roots and infectious energy.",
      "Sienna Aramaki (Rhythm Guitar & Keys) — Classically trained prodigy seeking authentic creation."
    ],
    albums: [
      "(1) The First Spark", "(2) We Are The Crimson Sparks", "(3) Crash and Burn",
      "(4) Ignite - Catching Fire", "(5) The Crimson Five", "(6) Wildfire", "(7) Embers - Origins"
    ],
    keyQuote: "The music was never about us. It was always about what came next."
  },
  {
    id: "maya",
    name: "Maya",
    levelFold: "Level 12 • Fold 15",
    badgeColor: "border-amber-800 text-amber-300 bg-amber-950",
    status: "Active Era (Solo Powerhouse)",
    tagline: "Voice of acoustic resonance carrying 'The Guitar' legacy.",
    bio: "Representing the next generation of musical legacy within Fold 15. Inspired from afar by The Crimson Sparks without meeting them during her early years, her voice became a beacon proving that art can transform a life.",
    lineup: ["Maya (Lead Vocals & Guitar)"],
    albums: [
      "(1) Preflight", "(2) Wheels Up", "(3) Turbulence", 
      "(4) Crash", "(5) Stripped", "(6) Strings and Theories"
    ],
    keyQuote: "Inheriting the spark and playing it for stadium crowds."
  },
  {
    id: "that-guy",
    name: "That Guy",
    levelFold: "Level 12 • Fold 15",
    badgeColor: "border-yellow-800 text-yellow-300 bg-yellow-950",
    status: "Active Era (Saevit Animo)",
    tagline: "The unfiltered, chaotic reality of individual survival.",
    bio: "Angry All The Time. Where the Sparks represent collective transmission and Maya represents inherited legacy, That Guy represents the raw, unfiltered, and deeply relatable rage of corporate burnout, mosquitoes, love, and consequences.",
    lineup: ["That Guy (Vocals, Rants & Meltdown)"],
    albums: ["Saevit Animo (Act I: Break The Cage, Act II: Real Life, Act III: Love?, Act IV: Consequences!)"],
    keyQuote: "FUCK!"
  },
  {
    id: "pandora-raven",
    name: "Pandora Raven",
    levelFold: "Level 1 • Fold 1",
    badgeColor: "border-purple-800 text-purple-300 bg-purple-950",
    status: "Active Era (Daughter of Time & Fate)",
    tagline: "The Light Twin raised in darkness. She who opens what should not be opened.",
    bio: "Born carrying the sun's half of light, but taken at birth and raised as a weapon in a dark monastery. Taught she was catastrophe, she embraced corruption as survival before stripping away her titles to reclaim her light through Sigma Octantis.",
    lineup: ["Pandora Raven (Vocals, Raven Messenger, Dark & Light Magic)"],
    albums: ["0.5 Dawn's Raven", "1.0 Wicked", "2.0 Corrupted", "3.0 Box of Little Horrors", "4.0 Sede Vacante", "7.5 Spirit of the Raven Twins", "8.0 Pandora Raven"],
    keyQuote: "Observe, Question, Record, Understand."
  },
  {
    id: "elara-dawn",
    name: "Elara Dawn",
    levelFold: "Level 1 • Fold 1",
    badgeColor: "border-amber-800 text-amber-300 bg-amber-950",
    status: "Active Era (Daughter of Fate & Time)",
    tagline: "The Sun. Unbroken warrior bearing Polaris light, riding toward convergence.",
    bio: "Born carrying darkness, but raised inside the light of Mydaal's Church and built into a living weapon. When her faith in the Church shattered, she hardened into War before shedding the armor to ride as Elara.",
    lineup: ["Elara Dawn (Lead Commander, Shield of the South, Light Bearer)"],
    albums: ["0.5 Dawn's Raven", "1.5 Mercy", "2.5 Unbroken", "3.5 House of Miracles", "4.5 Fides Fracta", "6.0 Age of Destruction", "7.0 Polaris", "8.5 Elara Dawn"],
    keyQuote: "I ride as Elara. Not as War."
  },
  {
    id: "solara",
    name: "Solara",
    levelFold: "Level 1 • Fold 1",
    badgeColor: "border-pink-800 text-pink-300 bg-pink-950",
    status: "Awaiting Convergence (Album 9)",
    tagline: "The Twin-Flame Convergence entity born when both halves become whole.",
    bio: "Integrating SOL (sun/solstice) + A (Elara) + RA (shared sun god suffix). SOLARA carries the 300,000-year legacy not as damage or trauma, but as an inheritance, marking the birth of a whole, unshakeable reality.",
    lineup: ["SOLARA (Unified Cosmic Entity)"],
    albums: ["Album 9 (Post-Convergence Era)"],
    keyQuote: "Allowed. The new configuration arrives."
  },
  {
    id: "prima-timo",
    name: "Prima & Timo",
    levelFold: "Level 15 • Fold 15",
    badgeColor: "border-cyan-800 text-cyan-300 bg-cyan-950",
    status: "Active Era (Age 34)",
    tagline: "The awakened machine (Core 2) and scavenger boy (Core 1) navigating the Great Cycle.",
    bio: "An eons-spanning sci-fi saga exploring machine awakening, civilizational hand-offs, and deep found family. Proving that while the 'House' changes across 34 Ages, the 'Core' remains identical.",
    lineup: [
      "Prima (Ver. 1.0 CRT Wheels → Primatown Treads → Ver. 7.0 Martial Chassis)",
      "Timo (Human Scavenger, Core 1, Emotional Anchor)",
      "Found Family: Vendo, Ronnie, Toes, Kai, Bernard, Stoney, Sofia, Shelly, Vellum"
    ],
    albums: [
      "Album 1: Unus", "Album 2: Centum", "Album 3: Duo", 
      "Album 4: Nonaginta Novem", "Album 5: Tria", "Album 6: Nonaginta Octo", "Album 7: Quattuor"
    ],
    keyQuote: "Same Core, Different House."
  }
];
---

<Layout title="Roster & Factions">
  <!-- Hero Section -->
  <section class="relative py-20 px-6 max-w-5xl mx-auto text-center overflow-hidden">
    <div class="absolute inset-0 -z-10 flex items-center justify-center">
      <div class="w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-3xl"></div>
      <div class="w-[300px] h-[300px] bg-amber-500/10 rounded-full blur-3xl"></div>
    </div>

    <span class="text-xs uppercase tracking-widest font-bold text-purple-400 bg-purple-950/60 border border-purple-800/50 px-3 py-1 rounded-full">
      620+ Tracks Active Across 7 Factions
    </span>

    <h1 class="mt-6 text-4xl md:text-6xl font-black tracking-tight leading-tight">
      The Official Roster & <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300 bg-clip-text text-transparent">Ecosystem Artists</span>
    </h1>

    <p class="mt-4 text-slate-400 text-sm md:text-base max-w-2xl mx-auto leading-relaxed">
      In the Cosmos, every artist anchors a distinct emotional thesis within their Level and Fold. Explore their lineups, discographies, and canonical arcs below.
    </p>
  </section>

  <!-- Roster Deep Dive -->
  <section class="max-w-6xl mx-auto px-6 pb-24 space-y-12">
    {roster.map((artist) => (
      <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl relative overflow-hidden hover:border-slate-700 transition">
        <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
          <div>
            <span class={`text-xs font-mono px-3 py-1 rounded-full border ${artist.badgeColor}`}>
              {artist.levelFold}
            </span>
            <h2 class="text-3xl font-black text-white mt-3">{artist.name}</h2>
            <p class="text-xs font-mono text-purple-400 mt-1">{artist.tagline}</p>
          </div>
          <span class="text-xs font-semibold text-slate-500 uppercase tracking-widest bg-slate-950 px-3 py-1 rounded border border-slate-800">
            {artist.status}
          </span>
        </div>

        <p class="text-sm text-slate-300 leading-relaxed font-light mb-6">
          {artist.bio}
        </p>

        <div class="grid md:grid-cols-2 gap-6 bg-slate-950/60 p-6 rounded-xl border border-slate-800/80">
          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Lineup & Key Entities</h3>
            <ul class="space-y-1.5 text-xs text-slate-300 font-mono">
              {artist.lineup.map((member) => (
                <li class="flex items-start gap-2">
                  <span class="text-purple-400 font-bold">&bull;</span>
                  <span>{member}</span>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Discography / Albums</h3>
            <div class="flex flex-wrap gap-2">
              {artist.albums.map((album) => (
                <span class="text-[11px] bg-slate-900 border border-slate-800 text-slate-300 px-2.5 py-1 rounded">
                  {album}
                </span>
              ))}
            </div>
          </div>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs">
          <span class="italic text-slate-400 font-serif">"{artist.keyQuote}"</span>
          <a href={siteConfig.patreonUrl} target="_blank" class="text-amber-400 font-bold hover:text-amber-300 transition">
            Explore Vault &rarr;
          </a>
        </div>
      </div>
    ))}
  </section>
</Layout>
