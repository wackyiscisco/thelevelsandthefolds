  .codex-selection.has-choice .codex-choice-prompt { opacity: 0; }

  @keyframes codex-drift { to { transform: translate(16px, -10px); opacity: .7; } }
  @keyframes codex-spark { 0%,100% { transform: translateY(0) scale(.7); opacity: .35; } 50% { transform: translateY(-17px) scale(1.25); opacity: 1; } }
  @keyframes codex-smoke-rise {
    0%, 100% { translate: -50% 18px; scale: .72; opacity: .2; }
    42% { translate: -35% -8px; scale: 1.12; opacity: .58; }
    70% { translate: -64% -30px; scale: .94; opacity: .34; }
  }
  @keyframes codex-smoke-orbit {
    0% { translate: -8px 8px; rotate: -4deg; opacity: .28; }
    100% { translate: 12px -12px; rotate: 8deg; opacity: .62; }
  }

  @media (max-width: 640px) {
    .codex-sanctum { padding: .8rem; }
    .living-codex { min-height: 390px; padding: .8rem; }
    .codex-page { inset: .8rem; }
    .codex-copy { left: 1.5rem; right: 1.5rem; bottom: 3rem; }
    .codex-page-wrongula .codex-copy { left: 1.5rem; right: 1.5rem; }
    .codex-page-wrongula .codex-copy h3 { max-width: none; text-align: right; }
    .codex-copy span { width: 76%; margin-left: auto; margin-right: auto; padding: .8rem 1rem; font-size: .7rem; line-height: 1.36; }
    .codex-page-wrongula .codex-copy span { margin-left: auto; margin-right: auto; }
    .codex-coordinate { top: 1.6rem; left: 1.5rem; }
    .codex-page-wrongula .codex-coordinate { right: 1.5rem; }
    .codex-whisper { letter-spacing: .12em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .codex-sanctum::before,
    .codex-sanctum::after,
    .codex-turn span,
    .codex-turn i,
    .codex-turn b,
    .codex-smoke i,
    .codex-smoke::before,
    .codex-smoke::after { animation: none; }
  }

  .detective-lens {
    width: 156px;
    height: 156px;
    border-radius: 9999px;
    border: 4px solid rgba(186, 230, 253, 0.95);
    background-repeat: no-repeat;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.82);
    transition: opacity 140ms ease, transform 140ms ease;
    box-shadow:
      0 0 0 2px rgba(2, 132, 199, 0.72),
      0 12px 34px rgba(0, 0, 0, 0.75),
      0 0 28px rgba(56, 189, 248, 0.42),
      inset 0 0 24px rgba(255, 255, 255, 0.16);
  }

  .detective-lens::after {
    content: '';
    position: absolute;
    width: 62px;
    height: 14px;
    right: -46px;
    bottom: -25px;
    border: 3px solid rgba(186, 230, 253, 0.95);
    border-left: 0;
    border-radius: 0 9999px 9999px 0;
    background: linear-gradient(90deg, rgba(7, 89, 133, 0.98), rgba(15, 23, 42, 0.98));
    transform: rotate(45deg);
    transform-origin: left center;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.55);
  }

  .detective-card.is-investigating .detective-lens {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .detective-card,
    .detective-card a {
      cursor: none;
    }
  }
</style>

<script is:inline>
  // High-performance canvas animators inside each card container
  document.addEventListener('DOMContentLoaded', () => {
    const livingCodex = document.querySelector('[data-living-codex]');

    if (livingCodex) {
      const codexSelection = document.querySelector('.codex-selection');
      const codexPrompt = document.querySelector('[data-codex-choice-prompt]');
      const maryChoice = document.querySelector('[data-codex-choice="mary"]');
      const wrongulaChoice = document.querySelector('[data-codex-choice="count-wrongula"]');

      const setCodexReveal = (value) => {
        const reveal = Math.max(0, Math.min(100, value));
        const direction = (reveal - 50) / 50;
        const maryIsOpen = reveal <= 12;
        const wrongulaIsOpen = reveal >= 88;
        livingCodex.style.setProperty('--codex-position', `${reveal}%`);
        livingCodex.style.setProperty('--codex-clip', `${100 - reveal}%`);
        livingCodex.style.setProperty('--codex-curl', `${direction * 16}deg`);
        livingCodex.style.setProperty('--pupil-x', `${direction * 4}px`);
        livingCodex.setAttribute('aria-valuenow', String(Math.round(reveal)));
        livingCodex.setAttribute(
          'aria-valuetext',
          reveal < 35 ? 'Mary is revealed' : reveal > 65 ? 'Count Wrongula is revealed' : 'Mary and Count Wrongula overlap'
        );
        maryChoice?.classList.toggle('is-active', maryIsOpen);
        wrongulaChoice?.classList.toggle('is-active', wrongulaIsOpen);
        maryChoice?.setAttribute('aria-hidden', String(!maryIsOpen));
        wrongulaChoice?.setAttribute('aria-hidden', String(!wrongulaIsOpen));
        maryChoice?.setAttribute('tabindex', maryIsOpen ? '0' : '-1');
        wrongulaChoice?.setAttribute('tabindex', wrongulaIsOpen ? '0' : '-1');
        codexSelection?.classList.toggle('has-choice', maryIsOpen || wrongulaIsOpen);
        if (codexPrompt) {
          codexPrompt.textContent = maryIsOpen ? 'Mary is waiting beyond the page' : wrongulaIsOpen ? 'Count Wrongula is waiting beyond the page' : 'Turn to either edge to choose a page';
        }
      };

      const turnCodexPage = (event) => {
        const rect = livingCodex.getBoundingClientRect();
        const reveal = ((event.clientX - rect.left) / rect.width) * 100;
        const pupilY = Math.max(-3, Math.min(3, ((event.clientY - rect.top) / rect.height - .5) * 6));
        livingCodex.style.setProperty('--pupil-y', `${pupilY}px`);
        setCodexReveal(reveal);
      };

      livingCodex.addEventListener('pointermove', turnCodexPage);
      livingCodex.addEventListener('pointerdown', (event) => {
        livingCodex.setPointerCapture?.(event.pointerId);
        turnCodexPage(event);
      });
      livingCodex.addEventListener('keydown', (event) => {
        const current = Number(livingCodex.getAttribute('aria-valuenow')) || 50;
        if (event.key === 'ArrowLeft') { event.preventDefault(); setCodexReveal(current - 5); }
        if (event.key === 'ArrowRight') { event.preventDefault(); setCodexReveal(current + 5); }
        if (event.key === 'Home') { event.preventDefault(); setCodexReveal(0); }
        if (event.key === 'End') { event.preventDefault(); setCodexReveal(100); }
      });
    }

    const canUseMagnifier = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const detectiveCard = document.querySelector('[data-detective-card]');
    const detectiveLens = detectiveCard?.querySelector('[data-detective-lens]');
    const detectiveImage = detectiveCard?.querySelector('img');

    if (canUseMagnifier && detectiveCard && detectiveLens && detectiveImage) {
      const zoom = 2.15;
      const lensSize = 156;
      const lensRadius = lensSize / 2;
      const magnifierImage = detectiveLens.getAttribute('data-magnifier-image');

      detectiveLens.style.backgroundImage = `url("${magnifierImage}")`;

      const moveLens = (event) => {
        const rect = detectiveCard.getBoundingClientRect();
        const x = event.clientX - rect.left;
        const y = event.clientY - rect.top;
        const naturalWidth = detectiveImage.naturalWidth || 1792;
        const naturalHeight = detectiveImage.naturalHeight || 1008;
        const coverScale = Math.max(rect.width / naturalWidth, rect.height / naturalHeight);
        const renderedWidth = naturalWidth * coverScale;
        const renderedHeight = naturalHeight * coverScale;
        const cropX = (renderedWidth - rect.width) / 2;
        const cropY = (renderedHeight - rect.height) / 2;

        detectiveLens.style.left = `${x}px`;
        detectiveLens.style.top = `${y}px`;
        detectiveLens.style.backgroundSize = `${renderedWidth * zoom}px ${renderedHeight * zoom}px`;
        detectiveLens.style.backgroundPosition = `${lensRadius - (x + cropX) * zoom}px ${lensRadius - (y + cropY) * zoom}px`;
      };

      detectiveCard.addEventListener('mouseenter', (event) => {
        detectiveCard.classList.add('is-investigating');
        moveLens(event);
      });
      detectiveCard.addEventListener('mousemove', moveLens);
      detectiveCard.addEventListener('mouseleave', () => {
        detectiveCard.classList.remove('is-investigating');
      });
    }

    const canvases = document.querySelectorAll('canvas[data-canvas-artist]');
    
    canvases.forEach(canvas => {
      const artistId = canvas.getAttribute('data-canvas-artist');
      const ctx = canvas.getContext('2d');
      let animationFrameId = null;
      let width = 0;
      let height = 0;
      
      // Mouse coordinates relative to card
      let mouseX = -9999;
      let mouseY = -9999;
      let isHovering = false;
      
      const parent = canvas.parentElement;

      // Mouse Listeners
      parent.addEventListener('mousemove', (e) => {
        const rect = parent.getBoundingClientRect();
        mouseX = e.clientX - rect.left;
        mouseY = e.clientY - rect.top;
      });
      parent.addEventListener('mouseenter', () => {
        isHovering = true;
      });
      parent.addEventListener('mouseleave', () => {
        isHovering = false;
        mouseX = -9999;
        mouseY = -9999;
      });

      // Resize function
      const resize = () => {
        const rect = parent.getBoundingClientRect();
        width = canvas.width = rect.width;
        height = canvas.height = rect.height;
      };
      
      resize();
      window.addEventListener('resize', resize);

      // PARTICLE ENGINE SYSTEM CONFIGS PER ARTIST
      let particles = [];
      let extraTimer = 0;

      // Initialize structures
      if (artistId === 'crimson-sparks') {
        // Sparks initial
        for (let i = 0; i < 40; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.2) * 2 + 1, // shoot left to right
            vy: (Math.random() - 0.5) * 1,
            size: Math.random() * 2.5 + 0.5,
            color: Math.random() > 0.4 ? '#f97316' : '#ef4444', // Orange/Red sparks
            life: Math.random() * 60 + 30
          });
        }
      } else if (artistId === 'pandora-raven') {
        // Shadow fog/sun orbits
        for (let i = 0; i < 60; i++) {
          const side = Math.random() > 0.5 ? 'left' : 'right';
          particles.push({
            x: side === 'left' ? Math.random() * (width / 2) : (width / 2) + Math.random() * (width / 2),
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            size: Math.random() * 20 + 10,
            alpha: Math.random() * 0.3 + 0.1,
            side: side
          });
        }
      } else if (artistId === 'elara-dawn') {
        // Solar grid shield
        for (let i = 0; i < 30; i++) {
          particles.push({
            angle: Math.random() * Math.PI * 2,
            radius: Math.random() * 120 + 30,
            speed: (Math.random() * 0.01 + 0.003) * (Math.random() > 0.5 ? 1 : -1),
            size: Math.random() * 3 + 1
          });
        }
      } else if (artistId === 'that-guy') {
        // Glitch Matrix characters
        for (let i = 0; i < 25; i++) {
          particles.push({
            x: (width / 25) * i + Math.random() * 10,
            y: Math.random() * -height,
            speed: Math.random() * 2.5 + 1.5,
            char: String.fromCharCode(33 + Math.floor(Math.random() * 93))
          });
        }
      } else if (artistId === 'maya') {
        // Equalizer wave values
        for (let i = 0; i < 50; i++) {
          particles.push({
            x: (width / 50) * i,
            targetAmp: Math.random() * 40 + 5,
            currentAmp: 5,
            speed: Math.random() * 0.1 + 0.05
          });
        }
      } else if (artistId === 'prima-timo') {
        // Radar Sweep
        extraTimer = 0; // Sweep angle
        // Targets
        for (let i = 0; i < 6; i++) {
          particles.push({
            x: Math.random() * (width - 100) + 50,
            y: Math.random() * (height - 100) + 50,
            active: false,
            intensity: 0
          });
        }
      } else if (artistId === 'solara') {
        // Convergence pull particles
        for (let i = 0; i < 50; i++) {
          const angle = Math.random() * Math.PI * 2;
          const radius = Math.random() * 150 + 50;
          particles.push({
            x: width / 2 + Math.cos(angle) * radius,
            y: height / 2 + Math.sin(angle) * radius,
            angle: angle,
            radius: radius,
            speed: Math.random() * 0.02 + 0.005,
            size: Math.random() * 2 + 0.5,
            color: Math.random() > 0.5 ? '#a855f7' : '#f59e0b'
          });
        }
      }

      // LOOP ANIMATOR
      const loop = () => {
        ctx.clearRect(0, 0, width, height);

        // 1. CRIMSON SPARKS: Sparkler trail
        if (artistId === 'crimson-sparks') {
          // Add new sparks
          if (isHovering && mouseX > -999) {
            // Emits from cursor
            for (let j = 0; j < 3; j++) {
              particles.push({
                x: mouseX,
                y: mouseY,
                vx: (Math.random() - 0.4) * 6 + 2,
                vy: (Math.random() - 0.5) * 6,
                size: Math.random() * 3 + 1,
                color: Math.random() > 0.4 ? '#f59e0b' : '#ef4444',
                life: Math.random() * 40 + 20
              });
            }
          } else {
            // Shoots from left edge
            if (Math.random() > 0.5) {
              particles.push({
                x: 0,
                y: height / 2 + (Math.random() - 0.5) * 50,
                vx: Math.random() * 4 + 4,
                vy: (Math.random() - 0.5) * 3,
                size: Math.random() * 3 + 1,
                color: '#f59e0b',
                life: Math.random() * 60 + 40
              });
            }
          }

          // Update & Draw sparks
          for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.life--;

            // Draw line trails
            ctx.beginPath();
            ctx.strokeStyle = p.color;
            ctx.lineWidth = p.size;
            ctx.lineCap = 'round';
            ctx.moveTo(p.x - p.vx * 2, p.y - p.vy * 2);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();

            if (p.life <= 0 || p.x > width || p.y < 0 || p.y > height) {
              particles.splice(i, 1);
            }
          }
        }

        // 2. PANDORA RAVEN: Swirling Purple/Gold mist
        else if (artistId === 'pandora-raven') {
          particles.forEach(p => {
            // Swirl behavior on mouse hover
            if (isHovering && mouseX > -999) {
              const dx = mouseX - p.x;
              const dy = mouseY - p.y;
              const dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 150) {
                p.vx += (dy / dist) * 0.05 * (p.side === 'left' ? 1 : -1);
                p.vy -= (dx / dist) * 0.05 * (p.side === 'left' ? 1 : -1);
              }
            }
            
            p.x += p.vx;
            p.y += p.vy;

            // Bounce check inside side boundaries
            if (p.side === 'left') {
              if (p.x < 0 || p.x > width / 2) p.vx *= -1;
            } else {
              if (p.x < width / 2 || p.x > width) p.vx *= -1;
            }
            if (p.y < 0 || p.y > height) p.vy *= -1;

            // Draw gradient glowing circles
            ctx.beginPath();
            const radG = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size);
            if (p.side === 'left') {
              radG.addColorStop(0, `rgba(147, 51, 234, ${p.alpha})`);
              radG.addColorStop(1, 'rgba(147, 51, 234, 0)');
            } else {
              radG.addColorStop(0, `rgba(245, 158, 11, ${p.alpha * 0.8})`);
              radG.addColorStop(1, 'rgba(245, 158, 11, 0)');
            }
            ctx.fillStyle = radG;
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fill();
          });
        }

        // 3. ELARA DAWN: Concentric sun-shield radar grid
        else if (artistId === 'elara-dawn') {
          const cx = isHovering && mouseX > -999 ? mouseX : width / 2;
          const cy = isHovering && mouseY > -999 ? mouseY : height / 2;

          // Draw orbital lines
          ctx.strokeStyle = 'rgba(245, 158, 11, 0.08)';
          ctx.lineWidth = 1;
          for (let r = 40; r < 200; r += 40) {
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, Math.PI * 2);
            ctx.stroke();
          }

          // Draw rotating orbital satellites
          particles.forEach(p => {
            p.angle += p.speed;
            const px = cx + Math.cos(p.angle) * p.radius;
            const py = cy + Math.sin(p.angle) * p.radius;

            ctx.beginPath();
            ctx.fillStyle = 'rgba(245, 158, 11, 0.6)';
            ctx.arc(px, py, p.size, 0, Math.PI * 2);
            ctx.fill();
            
            // Subtle glow tail
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(245, 158, 11, 0.15)';
            ctx.lineWidth = p.size;
            ctx.moveTo(px - Math.cos(p.angle + p.speed) * 10, py - Math.sin(p.angle + p.speed) * 10);
            ctx.lineTo(px, py);
            ctx.stroke();
          });
        }

        // 4. THAT GUY: Matrix Code Glitched Rain
        else if (artistId === 'that-guy') {
          ctx.fillStyle = 'rgba(16, 185, 129, 0.6)';
          ctx.font = '10px monospace';

          particles.forEach(p => {
            // Draw random glitch line
            if (isHovering && Math.random() > 0.96) {
              ctx.fillStyle = 'rgba(16, 185, 129, 0.9)';
              ctx.fillText(String.fromCharCode(33 + Math.floor(Math.random() * 93)), p.x, p.y + Math.random() * 20);
            }

            ctx.fillText(p.char, p.x, p.y);
            p.y += p.speed * (isHovering ? 2.5 : 1);

            if (p.y > height) {
              p.y = -20;
              p.speed = Math.random() * 2.5 + 1.5;
            }
            if (Math.random() > 0.95) {
              p.char = String.fromCharCode(33 + Math.floor(Math.random() * 93));
            }
          });
        }

        // 5. MAYA: Audio visualizer waves
        else if (artistId === 'maya') {
          ctx.strokeStyle = 'rgba(6, 182, 212, 0.25)';
          ctx.lineWidth = 4;
          ctx.lineCap = 'round';

          particles.forEach((p, idx) => {
            // Target amplitude moves
            if (Math.random() > 0.9) {
              p.targetAmp = Math.random() * (isHovering ? 70 : 35) + 5;
            }
            p.currentAmp += (p.targetAmp - p.currentAmp) * p.speed;

            // Draw cyan bar
            ctx.beginPath();
            ctx.strokeStyle = idx % 2 === 0 ? 'rgba(6, 182, 212, 0.3)' : 'rgba(236, 72, 153, 0.3)';
            ctx.moveTo(p.x, height / 2 - p.currentAmp / 2);
            ctx.lineTo(p.x, height / 2 + p.currentAmp / 2);
            ctx.stroke();
          });
        }

        // 6. PRIMA & TIMO: Circular scan radar scope
        else if (artistId === 'prima-timo') {
          const rx = width / 2;
          const ry = height / 2;
          const maxRadius = Math.min(width, height) / 2.2;

          extraTimer += 0.015; // Radar sweep angle

          // Draw radar circle grids
          ctx.strokeStyle = 'rgba(20, 184, 166, 0.08)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.arc(rx, ry, maxRadius, 0, Math.PI * 2);
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(rx, ry, maxRadius / 2, 0, Math.PI * 2);
          ctx.stroke();

          // Radar sweep line
          const sx = rx + Math.cos(extraTimer) * maxRadius;
          const sy = ry + Math.sin(extraTimer) * maxRadius;
          ctx.strokeStyle = 'rgba(20, 184, 166, 0.2)';
          ctx.beginPath();
          ctx.moveTo(rx, ry);
          ctx.lineTo(sx, sy);
          ctx.stroke();

          // Highlight target dots when swept
          particles.forEach(p => {
            const dx = p.x - rx;
            const dy = p.y - ry;
            const angle = Math.atan2(dy, dx);
            
            // Check if sweep line is close to target angle
            let diff = Math.abs(angle - (extraTimer % (Math.PI * 2)));
            if (diff > Math.PI) diff = Math.PI * 2 - diff;

            if (diff < 0.15) {
              p.active = true;
              p.intensity = 1.0;
            }

            if (p.active) {
              p.intensity -= 0.01;
              if (p.intensity <= 0) p.active = false;
            }

            if (p.active) {
              ctx.beginPath();
              ctx.fillStyle = `rgba(249, 115, 22, ${p.intensity})`; // Orange coordinates
              ctx.arc(p.x, p.y, 4, 0, Math.PI * 2);
              ctx.fill();
              
              // Target coordinate tag
              ctx.fillStyle = `rgba(20, 184, 166, ${p.intensity * 0.6})`;
              ctx.font = '8px monospace';
              ctx.fillText(`[X:${Math.floor(p.x)} Y:${Math.floor(p.y)}]`, p.x + 8, p.y + 2);
            }
          });
        }

        // 7. SOLARA: Celestial Convergence Spiral
        else if (artistId === 'solara') {
          const cx = width / 2;
          const cy = height / 2;

          particles.forEach(p => {
            p.angle -= p.speed;
            p.radius -= 0.3 * (isHovering ? 2.5 : 1); // pull toward center

            if (p.radius <= 5) {
              p.radius = Math.random() * 150 + 50;
              p.angle = Math.random() * Math.PI * 2;
            }

            const px = cx + Math.cos(p.angle) * p.radius;
            const py = cy + Math.sin(p.angle) * p.radius;

            ctx.beginPath();
            ctx.fillStyle = p.color;
            ctx.arc(px, py, p.size, 0, Math.PI * 2);
            ctx.fill();
          });
        }

        // Keep looping
        animationFrameId = requestAnimationFrame(loop);
      };

      // Intersection Observer to prevent offscreen rendering
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            loop();
          } else {
            cancelAnimationFrame(animationFrameId);
          }
        });
      }, { threshold: 0.1 });

      observer.observe(parent);
    });
  });
</script>
