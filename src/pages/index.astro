---
import Layout from '../layouts/Layout.astro';
import cosmosData from '../data/cosmos.json';

const { siteConfig, artists, patreonTiers } = cosmosData;
---

<Layout title="Home Portal">
  <!-- Hero Section -->
  <section class="relative py-24 px-6 max-w-5xl mx-auto text-center overflow-hidden">
    <div class="absolute inset-0 -z-10 flex items-center justify-center">
      <div class="w-[500px] h-[500px] bg-purple-600/10 rounded-full blur-3xl"></div>
      <div class="w-[300px] h-[300px] bg-amber-500/10 rounded-full blur-3xl"></div>
    </div>
    
    <span class="text-xs uppercase tracking-widest font-bold text-purple-400 bg-purple-950/60 border border-purple-800/50 px-3 py-1 rounded-full">
      620+ Songs Active &bull; All Levels Coexist
    </span>
    
    <h1 class="mt-6 text-5xl md:text-7xl font-extrabold tracking-tight leading-none">
      One Greater Cosmos.<br />
      <span class="bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300 bg-clip-text text-transparent">
        All Levels & Folds Exist Together.
      </span>
    </h1>
    
    <p class="mt-6 text-lg text-slate-400 max-w-2xl mx-auto font-light">
      {siteConfig.tagline}
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="#artists" class="bg-slate-100 text-slate-950 hover:bg-white px-8 py-3.5 rounded-full font-bold text-sm transition">
        Explore Roster
      </a>
      <a href="#patreon" class="border border-slate-700 bg-slate-900/50 hover:border-slate-500 px-8 py-3.5 rounded-full font-bold text-sm text-slate-200 transition">
        Join Patreon Vault
      </a>
    </div>
  </section>

  <!-- Roster Section (All 7 Artists) -->
  <section id="artists" class="py-20 bg-slate-900/40 border-y border-slate-800/60">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-3xl font-bold">Active Roster & Factions</h2>
          <p class="text-slate-400 text-sm mt-1">Cross-platform releases active across all Levels and Folds.</p>
        </div>
        <span class="text-xs font-mono text-purple-400 bg-purple-950 px-3 py-1 rounded-full border border-purple-800/50">
          7 Artists Initialized
        </span>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {artists.map((artist) => (
          <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl flex flex-col justify-between hover:border-purple-500/50 transition">
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs font-mono text-purple-400 bg-purple-950/80 px-2.5 py-0.5 rounded border border-purple-800/40">
                  {artist.levelFold}
                </span>
                <span class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">
                  {artist.status}
                </span>
              </div>
              <h3 class="text-xl font-bold text-white">{artist.name}</h3>
              <p class="mt-2 text-slate-400 text-sm leading-relaxed">{artist.description}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-800/80 flex justify-between items-center">
              <span class="text-xs text-slate-500">Track: <strong class="text-slate-300">{artist.featuredTrack}</strong></span>
              <span class="text-xs text-amber-400 font-semibold">&rarr;</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Patreon Funnel Section (Updated 2 Tiers) -->
  <section id="patreon" class="py-24 max-w-5xl mx-auto px-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-3xl font-bold">Support WackycsicO Records</h2>
      <p class="text-slate-400 text-sm mt-2">Unlock early music drops, character backstories, timeline maps, and exclusive lore vaults.</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">
      {patreonTiers.map((tier) => (
        <div class={`relative p-8 rounded-2xl flex flex-col justify-between transition ${
          tier.highlighted 
            ? 'bg-gradient-to-b from-slate-900 to-purple-950/40 border-2 border-purple-500 shadow-xl shadow-purple-950/50' 
            : 'bg-slate-900 border border-slate-800'
        }`}>
          {tier.highlighted && (
            <span class="absolute -top-3 right-6 bg-purple-500 text-white text-[10px] font-black uppercase tracking-widest px-3 py-1 rounded-full shadow">
              Highlighted Tier
            </span>
          )}
          <div>
            <h3 class="text-2xl font-bold text-white">{tier.name}</h3>
            <div class="mt-3 flex items-baseline space-x-2">
              <span class="text-4xl font-black text-amber-400">{tier.price}</span>
              <span class="text-xs text-slate-400 font-mono">({tier.trial})</span>
            </div>
            <p class="text-sm text-slate-300 italic mt-3">{tier.tagline}</p>

            <ul class="mt-6 space-y-2.5 text-sm text-slate-300 border-t border-slate-800/80 pt-4">
              {tier.perks.map((perk) => (
                <li class="flex items-start space-x-2">
                  <span class="text-purple-400 font-bold">&check;</span>
                  <span>{perk}</span>
                </li>
              ))}
            </ul>
          </div>
          <a href={siteConfig.patreonUrl} target="_blank" class={`mt-8 block text-center py-3 rounded-xl font-bold text-sm transition ${
            tier.highlighted 
              ? 'bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white shadow-lg' 
              : 'bg-slate-800 hover:bg-slate-700 text-slate-200'
          }`}>
            Get Started (7-Day Trial)
          </a>
        </div>
      ))}
    </div>
  </section>
</Layout>
