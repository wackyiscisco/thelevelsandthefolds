---
// src/pages/music/index.astro
// Notice: TWO '../../' because this sits inside src/pages/music/
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSongs = await getCollection('songs');

// Group songs by Artist -> Album
const musicCatalog: Record<string, Record<string, { coverImage: string; songs: any[] }>> = {};

allSongs.forEach((song: any) => {
  const artist = song.data && song.data.artist ? String(song.data.artist) : 'Unknown Artist';
  const album = song.data && song.data.album ? String(song.data.album) : 'Singles & Vault';

  if (!musicCatalog[artist]) {
    musicCatalog[artist] = {};
  }
  if (!musicCatalog[artist][album]) {
    musicCatalog[artist][album] = {
      coverImage: song.data.coverImage || '/images/default-album.jpg',
      songs: []
    };
  }

  musicCatalog[artist][album].songs.push(song);
});
---

<Layout title="The Cosmos Discography | Music Vault">
  <main class="max-w-7xl mx-auto px-6 py-12">
    <!-- Album Cards Grid -->
    <div class="space-y-16">
      {Object.entries(musicCatalog).map(([artist, albums]) => (
        <section class="space-y-6" key={artist}>
          <h2 class="text-3xl font-bold text-purple-400">{artist}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {Object.entries(albums).map(([albumName, albumData]) => {
              const artistSlug = artist.toLowerCase().replace(/[^a-z0-9]+/g, '-');
              const albumSlug = albumName.toLowerCase().replace(/[^a-z0-9]+/g, '-');
              return (
                <a href={`/music/${artistSlug}/${albumSlug}`} class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 hover:border-purple-500 transition">
                  <div class="aspect-square w-full bg-slate-950 overflow-hidden">
                    <img src={albumData.coverImage} alt={albumName} class="w-full h-full object-cover" />
                  </div>
                  <div class="p-4">
                    <h3 class="font-bold text-white">{albumName}</h3>
                    <p class="text-xs text-slate-400">{albumData.songs.length} Tracks</p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>
