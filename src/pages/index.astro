---
// src/pages/index.astro (Notice: ONE '../' because it sits directly in src/pages/)
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allSongs = await getCollection('songs');
---

<Layout title="The Cosmos Ecosystem | Home">
  <main class="max-w-7xl mx-auto px-6 py-16 space-y-12">
    
    <!-- Hero Banner -->
    <div class="text-center space-y-6 max-w-3xl mx-auto">
      <span class="px-3.5 py-1 rounded-full text-xs font-mono font-semibold bg-purple-950/80 text-purple-300 border border-purple-800/50">
        Level 1 Fold 1 • Level 15 Fold 15
      </span>
      <h1 class="text-5xl md:text-7xl font-black tracking-tight text-white">
        Welcome to <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-amber-300">The Cosmos</span>
      </h1>
      <p class="text-slate-400 text-base md:text-lg leading-relaxed">
        Explore a multi-layered universe where music, lore, stories, and digital worlds exist simultaneously across all Levels and Folds.
      </p>
      <div class="flex items-center justify-center gap-4 pt-4">
        <a href="/music" class="px-6 py-3 rounded-xl font-bold bg-purple-600 hover:bg-purple-500 text-white transition shadow-lg shadow-purple-900/30">
          Explore Discography →
        </a>
        <a href="https://www.patreon.com/c/wackyciscorecords/" target="_blank" class="px-6 py-3 rounded-xl font-bold bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-200 transition">
          Join Vault
        </a>
      </div>
    </div>

  </main>
</Layout>
