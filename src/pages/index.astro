---
import Layout from '../layouts/Layout.astro';

const universes = [
  {
    coordinate: '12_15',
    label: 'The Open Universe',
    status: 'OPEN',
    copy: 'The one universe whose audience-facing music, artists, stories, lore, and imagery are open to everyone.',
    detail: 'The Crimson Sparks · Maya · That Guy',
    href: '/lore/level-12-fold-15',
    accent: 'amber',
  },
  {
    coordinate: '1_1',
    label: 'The Twins Saga',
    status: 'JOURNEY',
    accent: 'purple',
    effect: 'twins',
    copy: 'Two sisters. Two paths. One truth neither can see whole.',
  },
  {
    coordinate: '1_1',
    label: 'What Comes Next?',
    status: 'JOURNEY',
    accent: 'yellow',
    effect: 'next',
    copy: 'The next story has already begun. You just haven’t reached it yet.',
  },
  {
    coordinate: '6_66',
    label: 'The Phantom Patrol',
    status: 'JOURNEY',
    accent: 'blue',
    effect: 'phantom',
    copy: 'A small town. Old stories. And far too many things that should not be real.',
  },
  {
    coordinate: '66_6',
    label: 'Another Plane?',
    status: 'JOURNEY',
    accent: 'red',
    effect: 'plane',
    copy: 'A way between worlds is failing. What happens when it opens again?',
  },
  {
    coordinate: '8_39',
    label: 'The Defective Detective',
    status: 'JOURNEY',
    accent: 'orange',
    effect: 'detective',
    copy: 'Every answer creates another question. Some questions are dangerous to ask.',
  },
  {
    coordinate: '15_15',
    label: 'Prima Et Timo',
    status: 'JOURNEY',
    accent: 'green',
    effect: 'prima-timo',
    copy: 'One was built to function. One was trying to find his way. Neither expected the other.',
  },
];
---

<Layout title="Enter The Cosmos">
  <div class="portal-page">
    <section class="portal-hero" aria-labelledby="portal-title">
      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>
      <div class="hero-signal signal-one"></div>
      <div class="hero-signal signal-two"></div>

      <div class="portal-eyebrow">
        <span></span>
        The Levels and The Folds
        <span></span>
      </div>

      <h1 id="portal-title">
        The Cosmos is not meant<br />
        <em>to be explained.</em>
      </h1>

      <p class="hero-reveal">It is meant to be entered.</p>
      <p class="hero-copy">
        Every Level and Fold exists. What you discover—and when you discover it—belongs to your journey.
      </p>

      <div class="hero-actions">
        <a class="portal-button primary" href="/journey">
          <span>Begin Your Journey</span>
          <b aria-hidden="true">→</b>
        </a>
        <a class="portal-button secondary" href="/lore/level-12-fold-15">
          <span>Enter Open Universe 12_15</span>
          <b aria-hidden="true">↗</b>
        </a>
      </div>

      <a href="#worlds" class="scroll-cue">
        <span>See the known coordinates</span>
        <i aria-hidden="true"></i>
      </a>
    </section>

    <section class="worlds-section" id="worlds" aria-labelledby="worlds-heading">
      <div class="section-heading">
        <div>
          <p class="kicker">Known Coordinates</p>
          <h2 id="worlds-heading">Every universe has a door.</h2>
        </div>
        <p class="section-intro">
          The Cosmos can be seen from here. Only what has been opened—or earned—can be entered.
        </p>
      </div>

      <div class="universe-grid">
        {universes.map((universe, index) => (
          <article class:list={[
            'universe-card',
            'accent-' + universe.accent,
            universe.effect && 'effect-' + universe.effect,
            universe.status === 'OPEN' && 'is-open',
          ]}>
            <div class="universe-visual">
              {universe.status === 'OPEN' ? (
                <div class="open-world-gallery" aria-label="The publicly open artists of Level 12 Fold 15">
                  <a class="open-world-panel crimson-panel" href="/lore/level-12-fold-15" aria-label="Explore The Crimson Sparks in open universe 12_15">
                    <figure>
                      <div
                        class="open-world-image crimson-image"
                        role="img"
                        aria-label="The Crimson Sparks"
                      ></div>
                      <figcaption>
                        <span>Public Artist 01</span>
                        <strong>The Crimson Sparks</strong>
                      </figcaption>
                    </figure>
                  </a>

                  <a class="open-world-panel maya-panel" href="/lore/level-12-fold-15" aria-label="Explore Maya in open universe 12_15">
                    <figure>
                      <div
                        class="open-world-image maya-image"
                        role="img"
                        aria-label="Maya"
                      ></div>
                      <figcaption>
                        <span>Public Artist 02</span>
                        <strong>Maya</strong>
                      </figcaption>
                    </figure>
                  </a>

                  <a class="open-world-panel that-guy-panel" href="/lore/level-12-fold-15" aria-label="Explore That Guy in open universe 12_15">
                    <figure>
                      <div
                        class="open-world-image that-guy-image"
                        role="img"
                        aria-label="That Guy"
                      ></div>
                      <figcaption>
                        <span>Public Artist 03</span>
                        <strong>That Guy</strong>
                      </figcaption>
                    </figure>
                  </a>
                </div>
              ) : (
                <>
                  <div class="sealed-echo" aria-hidden="true">
                    <span class="echo-image echo-a"></span>
                    <span class="echo-image echo-b"></span>
                    <span class="echo-shadow"></span>
                  </div>
                </>
              )}
              <div class="visual-smoke smoke-one" aria-hidden="true"></div>
              <div class="visual-smoke smoke-two" aria-hidden="true"></div>
              <div class="visual-sparks" aria-hidden="true"></div>
              <div class="visual-frame" aria-hidden="true"></div>
              <div class="visual-topline">
                <span class="card-number">{String(index + 1).padStart(2, '0')}</span>
                <span class:list={['state-pill', universe.status === 'OPEN' ? 'open' : 'sealed']}>
                  {universe.status === 'OPEN' ? 'Publicly Open' : 'Journey Sealed'}
                </span>
              </div>
            </div>

            <div class="universe-info">
              <div class="coordinate">{universe.coordinate}</div>
              <div class="universe-copy">
                <h3>{universe.label}</h3>
                {universe.status === 'OPEN' ? (
                  <>
                    <p>{universe.copy}</p>
                    <small>{universe.detail}</small>
                    <a class="card-entry" href={universe.href}>
                      Explore everything in 12_15 <span aria-hidden="true">→</span>
                    </a>
                  </>
                ) : (
                  <>
                    <p>{universe.copy}</p>
                    <div class="sealed-line">
                      <span aria-hidden="true">✦</span>
                      Revealed through Transmissions
                    </div>
                  </>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="journey-section" id="journey" aria-labelledby="journey-heading">
      <div class="journey-mark" aria-hidden="true">
        <span class="mark-ring ring-a"></span>
        <span class="mark-ring ring-b"></span>
        <span class="mark-core">✦</span>
      </div>

      <div class="journey-copy">
        <p class="kicker">Your Personal Journey Space</p>
        <h2 id="journey-heading">The Cosmos remembers what you have discovered.</h2>
        <p>
          Transmissions open characters, places, artifacts, music, and lore according to your position in the Journey.
          What you have earned remains with you. What lies ahead remains a mystery.
        </p>
        <p class="journey-note">
          The private Journey space is being prepared. Patreon remains the membership key and entrance.
        </p>
        <a
          class="portal-button primary"
          href="/journey"
        >
          <span>Preview Your Journey Space</span>
          <b aria-hidden="true">→</b>
        </a>
      </div>
    </section>

    <section class="threshold-footer" aria-label="Cosmos invitation">
      <p>One Cosmos.</p>
      <span>Many thresholds.</span>
      <strong>Your path is your own.</strong>
    </section>
  </div>
</Layout>

<style>
  :global(html) {
    scroll-padding-top: 6rem;
  }

  .portal-page {
    --cream: #f3e5bd;
    --gold: #d6a84d;
    --ink: #05060b;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 18%, rgba(97, 53, 180, 0.18), transparent 31rem),
      radial-gradient(circle at 84% 52%, rgba(16, 113, 140, 0.12), transparent 26rem),
      linear-gradient(180deg, rgba(3, 4, 9, 0.35), rgba(3, 5, 13, 0.84));
  }

  .portal-hero {
    position: relative;
    min-height: calc(100vh - 5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 7rem 1.5rem 6rem;
    text-align: center;
    isolation: isolate;
  }

  .portal-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      linear-gradient(90deg, rgba(0,0,0,.72), transparent 23%, transparent 77%, rgba(0,0,0,.72)),
      radial-gradient(circle at 50% 43%, transparent 0 8rem, rgba(4, 5, 12, .12) 8.2rem 12rem, transparent 12.2rem);
  }

  .portal-hero::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(80vw, 70rem);
    height: min(80vw, 70rem);
    z-index: -2;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 217, 132, .07), transparent 62%);
    filter: blur(5px);
  }

  .hero-orbit {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    border: 1px solid rgba(229, 200, 132, .17);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-12deg);
    pointer-events: none;
  }

  .orbit-one { width: min(76vw, 59rem); height: min(32vw, 24rem); }
  .orbit-two { width: min(61vw, 47rem); height: min(58vw, 45rem); transform: translate(-50%, -50%) rotate(54deg); }

  .hero-signal {
    position: absolute;
    width: 1px;
    height: 12rem;
    background: linear-gradient(transparent, rgba(223, 190, 115, .62), transparent);
    opacity: .45;
  }

  .signal-one { left: 16%; top: 12%; transform: rotate(24deg); }
  .signal-two { right: 14%; bottom: 10%; transform: rotate(38deg); }

  .portal-eyebrow,
  .kicker {
    font: 700 .68rem/1 'JetBrains Mono', monospace;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: #d5ad59;
  }

  .portal-eyebrow {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .portal-eyebrow span {
    width: 2.7rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(213, 173, 89, .75));
  }

  .portal-eyebrow span:last-child { transform: scaleX(-1); }

  h1 {
    margin: 0;
    max-width: 72rem;
    font: 700 clamp(3.15rem, 8vw, 7.5rem)/.92 Georgia, 'Times New Roman', serif;
    letter-spacing: -.055em;
    color: #f3ead6;
    text-wrap: balance;
  }

  h1 em {
    font-weight: 400;
    color: transparent;
    -webkit-text-stroke: 1px rgba(239, 215, 158, .7);
  }

  .hero-reveal {
    margin: 1.3rem 0 0;
    font: italic 400 clamp(1.7rem, 4vw, 3.2rem)/1.1 Georgia, serif;
    color: var(--gold);
  }

  .hero-copy {
    max-width: 42rem;
    margin: 2rem auto 0;
    color: #aeb7c8;
    font-size: clamp(.98rem, 1.7vw, 1.15rem);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .9rem;
    margin-top: 2.4rem;
  }

  .portal-button {
    min-height: 3.35rem;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: .95rem 1.25rem;
    border: 1px solid rgba(210, 169, 76, .55);
    font: 800 .68rem/1.2 'JetBrains Mono', monospace;
    letter-spacing: .11em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
  }

  .portal-button:hover {
    transform: translateY(-3px);
    border-color: #f0c668;
    box-shadow: 0 18px 45px rgba(0, 0, 0, .38), 0 0 30px rgba(190, 126, 44, .15);
  }

  .portal-button.primary { color: #171006; background: linear-gradient(135deg, #efd991, #d69836); }
  .portal-button.secondary { color: #e9ddc2; background: rgba(7, 8, 15, .72); }
  .portal-button b { font-size: 1rem; }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .65rem;
    transform: translateX(-50%);
    color: #727d91;
    font: 700 .55rem/1 'JetBrains Mono', monospace;
    letter-spacing: .18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .scroll-cue i {
    width: 1px;
    height: 2rem;
    background: linear-gradient(#d6a84d, transparent);
  }

  .worlds-section,
  .journey-section {
    width: min(92rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .worlds-section { padding: clamp(5rem, 10vw, 9rem) 0; }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(17rem, 32rem);
    gap: 3rem;
    align-items: end;
    padding-bottom: 2.2rem;
    border-bottom: 1px solid rgba(163, 177, 201, .17);
  }

  .section-heading h2,
  .journey-copy h2 {
    margin: .85rem 0 0;
    font: 600 clamp(2.25rem, 5vw, 4.5rem)/1 Georgia, serif;
    letter-spacing: -.045em;
    color: #eee7da;
  }

  .section-intro {
    margin: 0;
    color: #929caf;
    line-height: 1.75;
  }

  .universe-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 5vw, 5rem) 1.25rem;
    margin-top: 3rem;
  }

  .universe-card {
    --accent: 148, 163, 184;
    position: relative;
    min-width: 0;
  }

  .accent-amber { --accent: 221, 169, 70; }
  .accent-purple { --accent: 163, 92, 255; }
  .accent-yellow { --accent: 235, 190, 67; }
  .accent-blue { --accent: 57, 151, 232; }
  .accent-red { --accent: 218, 65, 81; }
  .accent-orange { --accent: 237, 134, 47; }
  .accent-green { --accent: 60, 190, 105; }

  .is-open {
    grid-column: 1 / -1;
  }

  .universe-visual {
    position: relative;
    height: clamp(19rem, 35vw, 31rem);
    overflow: hidden;
    border: 1px solid rgba(var(--accent), .34);
    background:
      radial-gradient(circle at 50% 105%, rgba(var(--accent), .22), transparent 48%),
      linear-gradient(145deg, rgba(var(--accent), .08), #05070e 68%);
    box-shadow: 0 30px 75px rgba(0, 0, 0, .34), 0 0 45px rgba(var(--accent), .07);
    isolation: isolate;
    transition: border-color .35s ease, box-shadow .35s ease, transform .35s ease;
  }

  .is-open .universe-visual {
    height: auto;
    min-height: 58rem;
    border-color: rgba(var(--accent), .55);
  }

  .universe-card:hover .universe-visual {
    transform: translateY(-4px);
    border-color: rgba(var(--accent), .62);
    box-shadow: 0 38px 90px rgba(0, 0, 0, .42), 0 0 60px rgba(var(--accent), .13);
  }

  .open-world-gallery {
    position: relative;
    z-index: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding: 4.5rem 1rem 1rem;
  }

  .open-world-panel {
    position: relative;
    display: block;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(var(--accent), .34);
    background: #070810;
    box-shadow: 0 18px 46px rgba(0, 0, 0, .36), inset 0 0 30px rgba(var(--accent), .035);
    color: inherit;
    text-decoration: none;
    transition: border-color .35s ease, transform .45s cubic-bezier(.2,.65,.2,1), box-shadow .35s ease;
  }

  .open-world-panel figure { margin: 0; }

  .open-world-panel:focus-visible {
    outline: 2px solid #f3d17e;
    outline-offset: 4px;
  }

  .open-world-panel:hover {
    z-index: 2;
    transform: translateY(-5px);
    border-color: rgba(var(--accent), .72);
    box-shadow: 0 25px 58px rgba(0, 0, 0, .48), 0 0 32px rgba(var(--accent), .13);
  }

  .crimson-panel {
    grid-column: 1 / -1;
  }

  .open-world-image {
    position: relative;
    width: 100%;
    background-color: #070810;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    filter: saturate(.88) contrast(1.04);
    transition: filter .6s ease;
  }

  .crimson-image {
    aspect-ratio: 16 / 9;
    background-image: url('/images/artists/level_12_fold_15_open_group_01.png');
    background-position: center;
  }

  .maya-image,
  .that-guy-image {
    aspect-ratio: 4 / 5;
    background-position: center;
  }

  .maya-image {
    background-image: url('/images/artists/level_12_fold_15_maya_01.png');
  }

  .that-guy-image {
    background-image: url('/images/artists/level_12_fold_15_that_guy_01.png');
  }

  .open-world-panel figcaption {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 1rem 1.15rem;
    border-top: 1px solid rgba(var(--accent), .27);
    background: linear-gradient(90deg, rgba(10, 11, 18, .98), rgba(18, 15, 11, .96));
  }

  .open-world-panel figcaption span {
    color: rgba(var(--accent), .72);
    font: 700 .54rem/1.3 'JetBrains Mono', monospace;
    letter-spacing: .13em;
    text-transform: uppercase;
  }

  .open-world-panel figcaption strong {
    color: #f3e6c8;
    font: italic 500 clamp(1.15rem, 1.7vw, 1.55rem)/1 Georgia, serif;
  }

  .is-open .universe-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(4, 6, 12, .48), transparent 30%, transparent 78%, rgba(4, 6, 12, .18)),
      linear-gradient(0deg, rgba(4, 6, 12, .35), transparent 32%);
    pointer-events: none;
  }

  .open-world-panel:hover .open-world-image {
    filter: saturate(1) contrast(1.04);
  }

  .sealed-echo {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
  }

  .echo-image,
  .echo-shadow {
    position: absolute;
    inset: -3%;
  }

  .echo-image {
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    filter: brightness(.62) saturate(.76) contrast(1.16) blur(.2px);
    mix-blend-mode: screen;
    opacity: 0;
    transform: scale(1.055);
    will-change: opacity, clip-path, transform;
  }

  .echo-a {
    animation: sealedEchoA 13.6s ease-in-out infinite;
    animation-delay: var(--echo-delay-a, 0s);
  }

  .echo-b {
    animation: sealedEchoB 15.8s ease-in-out infinite;
    animation-delay: var(--echo-delay-b, -5s);
  }

  .echo-shadow {
    z-index: 2;
    background:
      radial-gradient(ellipse at 50% 47%, transparent 0 14%, rgba(2, 3, 9, .26) 46%, rgba(2, 3, 9, .78) 88%),
      repeating-linear-gradient(180deg, rgba(255,255,255,.018) 0 1px, transparent 1px 5px),
      linear-gradient(180deg, rgba(2, 3, 9, .18), rgba(2, 3, 9, .44));
  }

  .effect-twins {
    --echo-delay-a: -1.7s;
    --echo-delay-b: -8.4s;
  }

  .effect-twins .echo-a,
  .effect-twins .echo-b { background-image: url('/images/artists/level_1_fold_1_twins_saga_manifestation_01.jpg'); }
  .effect-twins .echo-a { background-position: 23% center; }
  .effect-twins .echo-b { background-position: 79% center; transform: scale(1.09); }

  .effect-next {
    --echo-delay-a: -7.1s;
    --echo-delay-b: -13.2s;
  }

  .effect-next .echo-a,
  .effect-next .echo-b { background-image: url('/images/artists/level_1_fold_1_solara_manifestation_01.png'); }
  .effect-next .echo-a { background-position: 48% 38%; }
  .effect-next .echo-b { background-position: 56% 52%; transform: scale(1.12); }

  .effect-phantom {
    --echo-delay-a: -4.4s;
    --echo-delay-b: -11.6s;
  }

  .effect-phantom .echo-a,
  .effect-phantom .echo-b { background-image: url('/images/mary/the_phantom_patrol_group_photo_01.png'); }
  .effect-phantom .echo-a { background-position: 24% center; }
  .effect-phantom .echo-b { background-position: 76% center; transform: scale(1.1); }

  .effect-plane {
    --echo-delay-a: -10.3s;
    --echo-delay-b: -2.8s;
  }

  .effect-plane .echo-a,
  .effect-plane .echo-b { background-image: url('/images/count-wrongula/count_wrongula_group_photo_01.png'); }
  .effect-plane .echo-a { background-position: 27% center; }
  .effect-plane .echo-b { background-position: 74% center; transform: scale(1.08); }

  .effect-detective {
    --echo-delay-a: -6.2s;
    --echo-delay-b: -14.5s;
  }

  .effect-detective .echo-a,
  .effect-detective .echo-b { background-image: url('/images/defective-detective/the_defective_detective_hero.png'); }
  .effect-detective .echo-a { background-position: 28% center; }
  .effect-detective .echo-b { background-position: 74% 42%; }

  .effect-prima-timo {
    --echo-delay-a: -12.7s;
    --echo-delay-b: -5.3s;
  }

  .effect-prima-timo .echo-a,
  .effect-prima-timo .echo-b { background-image: url('/images/artists/prime-and-timo.jpg'); }
  .effect-prima-timo .echo-a { background-position: 30% center; }
  .effect-prima-timo .echo-b { background-position: 72% center; }

  .universe-card:not(.is-open):hover .echo-image {
    filter: brightness(.75) saturate(.9) contrast(1.18) blur(0);
  }

  .universe-card:not(.is-open) .universe-visual::before,
  .universe-card:not(.is-open) .universe-visual::after {
    content: '';
    position: absolute;
    inset: 0;
