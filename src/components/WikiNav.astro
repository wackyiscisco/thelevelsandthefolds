---
interface Props {
  parentHref?: string;
  parentLabel?: string;
  branchHref?: string;
  branchLabel?: string;
  backFallback?: string;
}

const {
  parentHref,
  parentLabel,
  branchHref,
  branchLabel,
  backFallback = '/wiki',
} = Astro.props;

const showBranch = Boolean(branchHref && branchLabel && branchHref !== parentHref);
---

<nav class="wiki-nav sticky top-20 z-30 mb-6 rounded-2xl border border-slate-700/70 bg-slate-950/90 p-2.5 shadow-xl shadow-black/30 backdrop-blur" aria-label="Wiki quick navigation">
  <div class="flex flex-wrap items-center gap-2">
    <button
      type="button"
      data-wiki-back
      data-fallback={backFallback}
      class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-900/80 px-3.5 py-2 text-sm font-semibold text-slate-200 transition hover:border-slate-500 hover:bg-slate-800"
    >
      <span aria-hidden="true">←</span>
      <span>Back</span>
    </button>

    <a href="/wiki" class="inline-flex items-center gap-2 rounded-xl border border-purple-700/70 bg-purple-950/40 px-3.5 py-2 text-sm font-semibold text-purple-100 transition hover:border-purple-400 hover:bg-purple-900/40">
      <span aria-hidden="true">⌂</span>
      <span>Wiki Home</span>
    </a>

    <a href="/" class="inline-flex items-center gap-2 rounded-xl border border-cyan-800/70 bg-cyan-950/30 px-3.5 py-2 text-sm font-semibold text-cyan-100 transition hover:border-cyan-500 hover:bg-cyan-900/30">
      <span aria-hidden="true">◆</span>
      <span>Cosmos Home</span>
    </a>

    {parentHref && parentLabel && (
      <a href={parentHref} class="inline-flex items-center gap-2 rounded-xl border border-amber-800/70 bg-amber-950/25 px-3.5 py-2 text-sm font-semibold text-amber-100 transition hover:border-amber-500 hover:bg-amber-900/25">
        <span aria-hidden="true">↑</span>
        <span>Back to {parentLabel}</span>
      </a>
    )}

    {showBranch && (
      <a href={branchHref} class="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-950/70 px-3.5 py-2 text-sm font-semibold text-slate-300 transition hover:border-purple-600 hover:text-purple-200">
        <span aria-hidden="true">↶</span>
        <span>Back to {branchLabel}</span>
      </a>
    )}
  </div>
</nav>

<script>
  document.querySelectorAll('[data-wiki-back]').forEach((node) => {
    if (!(node instanceof HTMLButtonElement) || node.dataset.bound === 'true') return;
    node.dataset.bound = 'true';
    node.addEventListener('click', () => {
      const fallback = node.dataset.fallback || '/wiki';
      if (window.history.length > 1) window.history.back();
      else window.location.href = fallback;
    });
  });
</script>
